<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="AGENTS.md" />
    <File Path="CONTRIBUTING.md" />
    <File Path="Directory.Build.props" />
    <File Path="global.json" />
    <File Path="LICENSE" />
    <File Path="nuget.config" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/Solution Items/.github/" />
  <Folder Name="/Solution Items/.github/actions/" />
  <Folder Name="/Solution Items/.github/actions/setup-dotnet-environment/">
    <File Path=".github/actions/setup-dotnet-environment/action.yml" />
  </Folder>
  <Folder Name="/Solution Items/.github/workflows/">
    <File Path=".github/workflows/deploy.yml" />
    <File Path=".github/workflows/main.yml" />
    <File Path=".github/workflows/pr.yml" />
    <File Path=".github/workflows/test.yml" />
  </Folder>
  <Folder Name="/Solution Items/packaging/" />
  <Folder Name="/Solution Items/packaging/linux/">
    <File Path="packaging/linux/AppRun" />
    <File Path="packaging/linux/blaze-harness.desktop" />
  </Folder>
  <Folder Name="/Solution Items/packaging/macos/">
    <File Path="packaging/macos/Info.plist" />
    <File Path="packaging/macos/launch" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/BlazeHarness.Core/BlazeHarness.Core.csproj" />
    <Project Path="src/BlazeHarness.Web/BlazeHarness.Web.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <File Path="tests\.editorconfig" />
    <File Path="tests\TestProject.props" />
    <Project Path="tests/BlazeHarness.Core.Tests.Integration/BlazeHarness.Core.Tests.Integration.csproj" />
    <Project Path="tests/BlazeHarness.Core.Tests.Unit/BlazeHarness.Core.Tests.Unit.csproj" />
    <Project Path="tests/BlazeHarness.Tests.Shared/BlazeHarness.Tests.Shared.csproj" />
    <Project Path="tests/BlazeHarness.Web.Tests.E2E/BlazeHarness.Web.Tests.E2E.csproj" />
    <Project Path="tests/BlazeHarness.Web.Tests.Integration/BlazeHarness.Web.Tests.Integration.csproj" />
    <Project Path="tests/BlazeHarness.Web.Tests.Unit/BlazeHarness.Web.Tests.Unit.csproj" />
  </Folder>
</Solution>
