    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1"/>
        <PackageReference Include="HtmlAgilityPack" Version="1.13.1"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Resilience" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Mxc.Sdk" Version="1.0.1"/>
        <PackageReference Include="PuppeteerSharp" Version="25.15.0"/>
        <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0"/>
        <PackageReference Include="PdfPig" Version="0.1.16"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0"/>
