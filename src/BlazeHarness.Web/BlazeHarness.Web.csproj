<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AssemblyTitle>Blaze Harness</AssemblyTitle>
        <Product>Blaze Harness</Product>
        <Copyright>Austin S.</Copyright>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <NeutralLanguage>en-US</NeutralLanguage>
        <!-- A release publish (`dotnet publish -r <rid>`) is one self-contained executable; trimming and AOT don't support Blazor Server. -->
        <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
        <!-- Ship only what the app uses: Kestrel serves it (no IIS module or web.config), and it runs on the local machine, where precompressed copies of the static files save nothing. -->
        <PublishIISAssets>false</PublishIISAssets>
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ColorCode.Core" Version="2.0.15" />
        <PackageReference Include="Markdig" Version="1.6.0" />
        <PackageReference Include="MessageFormat" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlazeHarness.Core\BlazeHarness.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests.Integration" />
        <InternalsVisibleTo Include="$(AssemblyName).Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <!-- The files sit in Resources/Strings, but the resource base name stays that of the WebStrings type. -->
        <EmbeddedResource Update="Resources\Strings\*.resx">
            <LogicalName>$(RootNamespace).Resources.%(Filename).resources</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\Strings\WebStrings.resx">
            <StronglyTypedClassName>WebStrings</StronglyTypedClassName>
            <StronglyTypedLanguage>C#</StronglyTypedLanguage>
            <StronglyTypedNamespace>BlazeHarness.Web.Resources</StronglyTypedNamespace>
            <StronglyTypedFileName>$(IntermediateOutputPath)WebStrings.Designer.cs</StronglyTypedFileName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Single-file publish bundles the satellite assemblies, so UiLanguages reads the translated cultures from these attributes. -->
    <Target Name="AddUiCultureMetadata" DependsOnTargets="SplitResourcesByCulture" BeforeTargets="GetAssemblyAttributes">
        <ItemGroup>
            <AssemblyMetadata Include="UiCulture" Value="%(EmbeddedResource.Culture)" Condition="'%(EmbeddedResource.WithCulture)' == 'true'"/>
        </ItemGroup>
    </Target>

    <!-- The app loads blazor.web.js; the framework also adds the older blazor.server.js. -->
    <Target Name="RemoveBlazorServerScript" AfterTargets="_AddBlazorFrameworkStaticWebAssets">
        <ItemGroup>
            <StaticWebAsset Remove="@(StaticWebAsset)" Condition="'%(Filename)%(Extension)' == 'blazor.server.js'"/>
            <StaticWebAssetEndpoint Remove="@(StaticWebAssetEndpoint)" Condition="$([System.IO.Path]::GetFileName('%(AssetFile)')) == 'blazor.server.js'"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never"/>
    </ItemGroup>
</Project>
