@using BlazeHarness.Web.Hosting

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name"
      data-lightbox-label="@WebStrings.UiLightboxLabel"
      data-close-label="@WebStrings.UiClose"
      data-copy-label="@WebStrings.UiCopy"
      data-copied-label="@WebStrings.UiCopied"
      data-copy-failed-label="@WebStrings.UiCopyFailed">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["ui.js"]"></script>
    <script src="@Assets["chat.js"]"></script>
    <script src="@Assets["browser.js"]"></script>
    <script src="@Assets["layout.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazeHarness.Web.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" LocalClient="@IsLocalClient" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsLocalClient => HttpContext is { } context
        && ClientMachine.IsLocalConnection(context.Connection.RemoteIpAddress, context.Connection.LocalIpAddress);
}
