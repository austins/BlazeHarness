      data-copy-label="@WebStrings.UiCopy"
      data-copied-label="@WebStrings.UiCopied"
      data-copy-failed-label="@WebStrings.UiCopyFailed">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["ui.js"]"></script>
    <script src="@Assets["chat.js"]"></script>
    <script src="@Assets["browser.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazeHarness.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
