@using BlazeHarness.Core.Chats
@inject FolderRegistry Folders
@inject ChatService ChatService
@inject ToastService Toasts

<Dialog Title="@WebStrings.MoveChatDialogTitle" Open="Chat is not null" OnClose="CloseAsync">
    <ChildContent>
        <p class="hint">@WebStrings.MoveChatDialogHint</p>
        <ul class="folder-entries" aria-label="@WebStrings.MoveChatDialogDestinationsLabel">
            <li>
                <button type="button" class="folder-entry" disabled="@(Chat?.FolderPath is null)" @onclick="() => MoveAsync(null)">
                    <Icon Name="chat" /> <span>@WebStrings.MoveChatDialogNoFolder</span>
                </button>
            </li>
            @foreach (var folder in Folders.List().Where(FolderRegistry.IsAvailable))
            {
                <li @key="folder.Path">
                    <button type="button" class="folder-entry" title="@folder.Path"
                            disabled="@IsCurrent(folder)" @onclick="() => MoveAsync(folder.Path)">
                        <Icon Name="folder" /> <span>@folder.Name</span>
                    </button>
                </li>
            }
        </ul>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="CloseAsync">@WebStrings.MoveChatDialogCancel</button>
    </Footer>
</Dialog>

@code {
    /// <summary>
    /// Gets or sets the chat to move, or null while the dialog is closed.
    /// </summary>
    [Parameter]
    public ChatInfo? Chat { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the dialog is dismissed or the chat was moved.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsCurrent(FolderInfo folder)
    {
        return Chat?.FolderPath is { } path && FolderPaths.Comparer.Equals(path, folder.Path);
    }

    private async Task MoveAsync(string? folderPath)
    {
        var chat = Chat;
        if (chat is null)
        {
            return;
        }

        try
        {
            await ChatService.Store.UpdateAsync(chat.Id, s => s with { FolderPath = folderPath });
            if (folderPath is not null)
            {
                await Folders.TouchAsync(folderPath);
            }

            await ChatService.RefreshProjectsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show(WebStrings.MoveChatErrorWriteFailed, ToastKind.Error);
        }

        await CloseAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
