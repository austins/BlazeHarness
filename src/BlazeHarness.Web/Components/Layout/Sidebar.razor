@implements IDisposable
@inject IJSRuntime JS
@inject SessionService Sessions
@inject NavigationManager Navigation
@inject ToastService Toasts

<nav class="sidebar" data-collapsed="@Collapsed.ToString().ToLowerInvariant()" aria-label="Main">
    <div class="sidebar-brand"><span class="logo" aria-hidden="true">🔥</span> BlazeHarness</div>

    <NavLink class="btn btn-primary" href="" Match="NavLinkMatch.All"><Icon Name="plus" /> New chat</NavLink>

    <section class="sidebar-section" aria-labelledby="chats-heading">
        <div class="sidebar-heading"><Icon Name="chat" /><span id="chats-heading">Chats</span></div>
        @if (Sessions.Store.List().Count > 0)
        {
            <input type="search" class="input input-sm sidebar-search" placeholder="Search chats"
                   aria-label="Search chat titles" @bind="Filter" @bind:event="oninput" />
        }

        @{
            var chats = Sessions.Store.List(Filter);
        }
        @if (chats.Count == 0)
        {
            <p class="sidebar-empty">@(string.IsNullOrWhiteSpace(Filter) ? "No chats yet." : "No chats match.")</p>
        }
        else
        {
            <ul class="chat-list">
                @foreach (var chat in chats)
                {
                    <li @key="chat.Id" class="chat-item">
                        @if (_renaming == chat.Id)
                        {
                            <input class="input input-sm" @ref="_renameInput" aria-label="Chat name" maxlength="200"
                                   @bind="_renameText" @bind:event="oninput"
                                   @onkeydown="OnRenameKey" @onblur="CommitRenameAsync" />
                        }
                        else
                        {
                            <NavLink class="chat-link" href="@("chat/" + chat.Id)">
                                <span class="chat-title">@(string.IsNullOrWhiteSpace(chat.Title) ? "Untitled chat" : chat.Title)</span>
                                @if (Sessions.IsRunning(chat.Id))
                                {
                                    <span class="chat-busy" role="status" title="Replying" aria-label="Replying"><Icon Name="spinner" Spin="true" /></span>
                                }
                            </NavLink>
                            <div class="chat-actions">
                                <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="@("Rename " + DisplayTitle(chat))"
                                        title="Rename" @onclick="() => StartRename(chat)"><Icon Name="pencil" /></button>
                                <button type="button" class="btn btn-ghost btn-sm btn-icon btn-danger" aria-label="@("Delete " + DisplayTitle(chat))"
                                        title="Delete" @onclick="() => _deleting = chat"><Icon Name="trash" /></button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="sidebar-section" aria-labelledby="folders-heading">
        <div class="sidebar-heading"><Icon Name="folder" /><span id="folders-heading">Folders</span></div>
        <p class="sidebar-empty">Opened folders and their sessions will appear here.</p>
    </section>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer">
        <NavLink class="nav-link" href="settings/providers"><Icon Name="settings" /> Providers</NavLink>
        <button type="button" class="btn btn-ghost btn-icon" @onclick="ToggleThemeAsync"
                title="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")">
            <Icon Name="@(_dark ? "moon" : "sun")" />
        </button>
    </div>
</nav>

<Dialog Title="Delete this chat?" Open="_deleting is not null" OnClose="() => _deleting = null">
    <ChildContent>
        <p>This can't be undone. <strong>@(_deleting is null ? string.Empty : DisplayTitle(_deleting))</strong> and everything stored for it is removed. Files in your project folder are not touched.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _deleting = null">Keep</button>
        <button type="button" class="btn btn-primary" @onclick="DeleteAsync">Delete</button>
    </Footer>
</Dialog>

@code {
    private bool _dark;
    private string? _renaming;
    private string _renameText = string.Empty;
    private bool _focusRename;
    private SessionInfo? _deleting;
    private ElementReference _renameInput;

    private string Filter { get; set; } = string.Empty;

    [Parameter]
    public bool Collapsed { get; set; }

    protected override void OnInitialized()
    {
        Sessions.Store.Changed += OnSessionsChanged;
        Sessions.ActivityChanged += OnSessionsChanged;
    }

    public void Dispose()
    {
        Sessions.Store.Changed -= OnSessionsChanged;
        Sessions.ActivityChanged -= OnSessionsChanged;
    }

    private void OnSessionsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await JS.InvokeVoidAsync("bhUi.focusSelect", _renameInput);
        }

        if (firstRender)
        {
            _dark = await JS.InvokeAsync<bool>("bhTheme.isDark");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("bhTheme.set", _dark ? "dark" : "light");
    }

    private static string DisplayTitle(SessionInfo chat)
    {
        return string.IsNullOrWhiteSpace(chat.Title) ? "Untitled chat" : chat.Title;
    }

    private void StartRename(SessionInfo chat)
    {
        _renaming = chat.Id;
        _renameText = chat.Title;
        _focusRename = true;
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitRenameAsync();
        }
        else if (e.Key == "Escape")
        {
            _renaming = null;
        }
    }

    private async Task CommitRenameAsync()
    {
        var id = _renaming;
        if (id is null)
        {
            return;
        }

        _renaming = null;
        var title = _renameText.Trim();
        if (title.Length == 0 || title == Sessions.Store.Find(id)?.Title)
        {
            return;
        }

        try
        {
            await Sessions.Store.RenameAsync(id, title);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The chat could not be renamed because its file could not be written.", ToastKind.Error);
        }
    }

    private async Task DeleteAsync()
    {
        var chat = _deleting;
        _deleting = null;
        if (chat is null)
        {
            return;
        }

        try
        {
            if (!await Sessions.DeleteAsync(chat.Id))
            {
                Toasts.Show("This chat is still replying. Stop it first, then delete it.", ToastKind.Error);
                return;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The chat could not be deleted because its files could not be removed.", ToastKind.Error);
            return;
        }

        if (Navigation.ToBaseRelativePath(Navigation.Uri).Equals("chat/" + chat.Id, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(string.Empty);
        }
    }
}
