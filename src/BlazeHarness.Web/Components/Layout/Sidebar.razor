@inject IJSRuntime JS

<nav class="sidebar" data-collapsed="@Collapsed.ToString().ToLowerInvariant()" aria-label="Main">
    <div class="sidebar-brand"><span class="logo" aria-hidden="true">🔥</span> BlazeHarness</div>

    <NavLink class="btn btn-primary" href="" Match="NavLinkMatch.All">New chat</NavLink>

    <section class="sidebar-section" aria-labelledby="folders-heading">
        <div class="sidebar-heading"><span id="folders-heading">Folders</span></div>
        <p class="sidebar-empty">Opened folders and their sessions will appear here.</p>
    </section>

    <section class="sidebar-section" aria-labelledby="chats-heading">
        <div class="sidebar-heading"><span id="chats-heading">Chats</span></div>
        <p class="sidebar-empty">No chats yet.</p>
    </section>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer">
        <NavLink class="nav-link" href="settings/providers">⚙ Providers</NavLink>
        <button type="button" class="btn btn-ghost btn-icon" @onclick="ToggleThemeAsync"
                title="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")">
            @if (_dark)
            {
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            }
            else
            {
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
            }
        </button>
    </div>
</nav>

@code {
    private bool _dark;

    [Parameter]
    public bool Collapsed { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await JS.InvokeAsync<bool>("bhTheme.isDark");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("bhTheme.set", _dark ? "dark" : "light");
    }
}
