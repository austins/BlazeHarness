@implements IDisposable
@inject IJSRuntime JS
@inject SessionService Sessions
@inject NavigationManager Navigation
@inject FolderRegistry Folders
@inject ToastService Toasts

<nav class="sidebar" data-collapsed="@Collapsed.ToString().ToLowerInvariant()" aria-label="Main">
    <div class="sidebar-brand"><span class="logo" aria-hidden="true">🔥</span> BlazeHarness</div>

    <NavLink class="btn btn-primary" href="" Match="NavLinkMatch.All" data-shortcut="new-chat" title="New chat (Ctrl+Shift+O)"><Icon Name="plus" /> New chat</NavLink>

    @{
        var all = Sessions.Store.List(Filter);
        var folders = Folders.List();
        var chats = all.Where(s => !folders.Any(f => IsIn(s, f))).ToList();
        var filtering = !string.IsNullOrWhiteSpace(Filter);
    }

    @if (Sessions.Store.List().Count > 0)
    {
        <input type="search" class="input input-sm sidebar-search" placeholder="Search chats"
               aria-label="Search chat titles" title="Search chats (Ctrl+K)" data-shortcut="search" @bind="Filter" @bind:event="oninput" />
    }

    <section class="sidebar-section" aria-labelledby="chats-heading">
        <div class="sidebar-heading">
            <Icon Name="chat" /><span id="chats-heading">Chats</span>
            <label class="btn btn-ghost btn-sm btn-icon sidebar-heading-action import-chat" title="Import a chat from a JSON file">
                <InputFile OnChange="ImportAsync" accept=".json,application/json" class="visually-hidden" aria-label="Import a chat from a JSON file" />
                <Icon Name="arrow-down" />
            </label>
        </div>
        @if (chats.Count == 0)
        {
            <p class="sidebar-empty">@(filtering ? "No chats match." : "No chats yet.")</p>
        }
        else
        {
            <ChatList Chats="chats" />
        }
    </section>

    <section class="sidebar-section" aria-labelledby="folders-heading">
        <div class="sidebar-heading">
            <Icon Name="folder" /><span id="folders-heading">Folders</span>
            <button type="button" class="btn btn-ghost btn-sm btn-icon sidebar-heading-action" title="Open folder"
                    aria-label="Open folder" @onclick="() => _picking = true"><Icon Name="plus" /></button>
        </div>
        @if (folders.Count == 0)
        {
            <p class="sidebar-empty">Open a project folder to start chats in it.</p>
        }
        else
        {
            <ul class="folder-list">
                @foreach (var folder in folders)
                {
                    var folderChats = all.Where(s => IsIn(s, folder)).ToList();
                    if (filtering && folderChats.Count == 0)
                    {
                        continue;
                    }

                    var available = FolderRegistry.IsAvailable(folder);
                    var expanded = filtering || !_collapsed.Contains(folder.Path);
                    <li @key="folder.Path" class="folder-item">
                        <div class="folder-head">
                            <button type="button" class="folder-toggle" aria-expanded="@expanded.ToString().ToLowerInvariant()"
                                    title="@folder.Path" @onclick="() => ToggleFolder(folder)">
                                <Icon Name="@(expanded ? "chevron-down" : "chevron-right")" />
                                <span class="folder-name">@folder.Name</span>
                                @if (!available)
                                {
                                    <span class="folder-warning" title="Folder not found" role="img" aria-label="Folder not found"><Icon Name="alert" /></span>
                                }
                            </button>
                            <div class="folder-actions">
                                @if (available)
                                {
                                    <a class="btn btn-ghost btn-sm btn-icon" href="@NewChatHref(folder)" title="New chat in this folder"
                                       aria-label="@("New chat in " + folder.Name)"><Icon Name="plus" /></a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-ghost btn-sm btn-icon" title="Find this folder"
                                            aria-label="@("Find " + folder.Name)" @onclick="() => _locating = folder"><Icon Name="folder" /></button>
                                }
                                <button type="button" class="btn btn-ghost btn-sm btn-icon" title="Remove from list"
                                        aria-label="@("Remove " + folder.Name + " from the list")" @onclick="() => _removing = folder"><Icon Name="close" /></button>
                            </div>
                        </div>
                        @if (!available)
                        {
                            <p class="sidebar-empty">This folder can't be found. It may have been moved or deleted.</p>
                        }

                        @if (expanded)
                        {
                            if (folderChats.Count > 0)
                            {
                                <div class="folder-chats"><ChatList Chats="folderChats" /></div>
                            }
                            else if (available)
                            {
                                <p class="sidebar-empty folder-chats">No chats yet.</p>
                            }
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer">
        <div class="sidebar-links">
            <NavLink class="nav-link" href="settings/providers" data-shortcut="settings" title="Settings (Ctrl+,)"><Icon Name="settings" /> Providers</NavLink>
            <NavLink class="nav-link" href="settings/permissions"><Icon Name="shield" /> Permissions</NavLink>
            <NavLink class="nav-link" href="settings/mcp"><Icon Name="plug" /> MCP servers</NavLink>
            <NavLink class="nav-link" href="settings/skills"><Icon Name="book" /> Skills</NavLink>
            <NavLink class="nav-link" href="settings/appearance"><Icon Name="text-size" /> Appearance</NavLink>
            <NavLink class="nav-link" href="settings/diagnostics"><Icon Name="wrench" /> Diagnostics</NavLink>
        </div>
        <button type="button" class="btn btn-ghost btn-icon" @onclick="ToggleThemeAsync"
                title="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")">
            <Icon Name="@(_dark ? "moon" : "sun")" />
        </button>
    </div>
</nav>

<OpenFolderDialog Open="_picking" OnClose="() => _picking = false" OnPicked="OnFolderPickedAsync" />

<OpenFolderDialog Open="_locating is not null" OnClose="() => _locating = null" OnPicked="RelocateAsync"
                  Title="Find folder" Hint="Choose where this folder is now. Its chats move with it." ConfirmText="Use this folder" />

<Dialog Title="Remove this folder?" Open="_removing is not null" OnClose="() => _removing = null">
    <ChildContent>
        <p><strong>@_removing?.Name</strong> is removed from this list. The folder on your computer is not touched, and its chats stay, moved to Chats.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _removing = null">Keep</button>
        <button type="button" class="btn btn-primary" @onclick="RemoveAsync">Remove</button>
    </Footer>
</Dialog>

@code {
    private readonly HashSet<string> _collapsed = new(FolderPaths.Comparer);
    private bool _dark;
    private bool _picking;
    private FolderInfo? _locating;
    private FolderInfo? _removing;

    private const long MaxImportBytes = 8 * 1024 * 1024;

    private string Filter { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets a value indicating whether the sidebar is hidden.
    /// </summary>
    [Parameter]
    public bool Collapsed { get; set; }

    protected override void OnInitialized()
    {
        Sessions.Store.Changed += OnSessionsChanged;
        Sessions.ActivityChanged += OnSessionsChanged;
        Folders.Changed += OnSessionsChanged;
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxImportBytes)
        {
            Toasts.Show("That file is too large to be a chat export.", ToastKind.Error);
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(MaxImportBytes));
            var info = await Sessions.ImportAsync(await reader.ReadToEndAsync());
            Navigation.NavigateTo(Routes.Chat(info.Id));
        }
        catch (FormatException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Error);
        }
        catch (IOException)
        {
            Toasts.Show("The file could not be read.", ToastKind.Error);
        }
    }

    public void Dispose()
    {
        Sessions.Store.Changed -= OnSessionsChanged;
        Sessions.ActivityChanged -= OnSessionsChanged;
        Folders.Changed -= OnSessionsChanged;
    }

    private void OnSessionsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await JS.InvokeAsync<bool>("bhTheme.isDark");
            StateHasChanged();
        }
    }

    private static bool IsIn(SessionInfo session, FolderInfo folder)
    {
        return session.FolderPath is { } path && FolderPaths.Comparer.Equals(path, folder.Path);
    }

    private static string NewChatHref(FolderInfo folder)
    {
        return "?folder=" + Uri.EscapeDataString(folder.Path);
    }

    private void ToggleFolder(FolderInfo folder)
    {
        if (!_collapsed.Remove(folder.Path))
        {
            _collapsed.Add(folder.Path);
        }
    }

    private async Task OnFolderPickedAsync(string path)
    {
        var result = await Folders.OpenAsync(path);
        if (result.Folder is null)
        {
            Toasts.Show("That folder could not be opened.", ToastKind.Error);
            return;
        }

        _picking = false;
        _collapsed.Remove(result.Folder.Path);
        Navigation.NavigateTo(NewChatHref(result.Folder));
    }

    private async Task RelocateAsync(string path)
    {
        var old = _locating;
        _locating = null;
        if (old is null)
        {
            return;
        }

        try
        {
            var result = await Folders.RelocateAsync(old.Path, path);
            if (result.Folder is null)
            {
                Toasts.Show("That folder could not be used.", ToastKind.Error);
                return;
            }

            await Sessions.Store.RepointFolderAsync(old.Path, result.Folder.Path);
            await Sessions.RefreshProjectsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The folder could not be updated because a file could not be written.", ToastKind.Error);
        }
    }

    private async Task RemoveAsync()
    {
        var folder = _removing;
        _removing = null;
        if (folder is null)
        {
            return;
        }

        try
        {
            await Folders.RemoveAsync(folder.Path);
            await Sessions.Store.RepointFolderAsync(folder.Path, null);
            await Sessions.RefreshProjectsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The folder could not be removed because a file could not be written.", ToastKind.Error);
        }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("bhTheme.set", _dark ? "dark" : "light");
    }
}
