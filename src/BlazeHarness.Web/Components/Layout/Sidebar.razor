@using BlazeHarness.Core.Chats
@using BlazeHarness.Web.Services
@implements IDisposable
@inject IJSRuntime JS
@inject ChatService ChatService
@inject NavigationManager Navigation
@inject FolderRegistry Folders
@inject ToastService Toasts
@inject SettingsDialogState SettingsState
@inject ILogger<Sidebar> Logger
@inject TimeProvider Time

<nav class="sidebar" data-collapsed="@Collapsed.ToString().ToLowerInvariant()" aria-label="@WebStrings.SidebarNavigationLabel">
    <div class="sidebar-brand"><span class="logo" aria-hidden="true">🔥</span> @WebStrings.SidebarBrand</div>

    <NavLink class="btn btn-primary" href="" Match="NavLinkMatch.All" data-shortcut="new-chat" title="@WebStrings.SidebarNewChatTooltip"><Icon Name="plus" /> @WebStrings.SidebarNewChat</NavLink>

    @{
        IReadOnlyList<ChatInfo> all = ChatService.Store.List(Filter);
        if (_sort == ChatSortOrder.Name)
        {
            all = [.. all.OrderBy(ChatList.DisplayTitle, StringComparer.CurrentCultureIgnoreCase).ThenByDescending(c => c.UpdatedAt)];
        }
        var folders = Folders.List();
        var inFolder = folders.ToDictionary(f => f.Path, _ => new List<ChatInfo>(), FolderPaths.Comparer);
        var chats = new List<ChatInfo>();
        foreach (var chat in all)
        {
            if (chat.FolderPath is { } path && inFolder.TryGetValue(path, out var group))
            {
                group.Add(chat);
            }
            else
            {
                chats.Add(chat);
            }
        }

        var filtering = !string.IsNullOrWhiteSpace(Filter);
    }

    <section class="sidebar-section" aria-labelledby="chats-heading">
        <div class="sidebar-heading">
            <Icon Name="chat" /><span id="chats-heading">@WebStrings.SidebarChatsHeading</span>
            <div class="sidebar-heading-actions">
                <label class="btn btn-ghost btn-sm btn-icon import-chat" title="@WebStrings.SidebarImportChatTooltip">
                    <InputFile @ref="_importInput" OnChange="ImportAsync" accept=".json,application/json" class="visually-hidden" aria-label="@WebStrings.SidebarImportChatLabel" />
                    <Icon Name="import" />
                </label>
                @if (_searching || all.Count > 0)
                {
                    <Menu Label="@WebStrings.SidebarSortLabel" Title="@WebStrings.SidebarSortTooltip" IconOnly="true">
                        <Trigger><Icon Name="sort" /></Trigger>
                        <ChildContent>
                            <MenuItem Label="@WebStrings.SidebarSortUpdated" Checked="_sort == ChatSortOrder.Updated" OnSelect="() => SetSortAsync(ChatSortOrder.Updated)" />
                            <MenuItem Label="@WebStrings.SidebarSortName" Checked="_sort == ChatSortOrder.Name" OnSelect="() => SetSortAsync(ChatSortOrder.Name)" />
                        </ChildContent>
                    </Menu>
                    <button type="button" class="btn btn-ghost btn-sm btn-icon sidebar-search-toggle" aria-expanded="@(_searching ? "true" : "false")"
                            aria-controls="sidebar-search" title="@WebStrings.SidebarSearchChatsTooltip" aria-label="@WebStrings.SidebarSearchChatsLabel"
                            data-shortcut="search" @onclick="ToggleSearch"><Icon Name="search" /></button>
                }
                <a class="btn btn-ghost btn-sm btn-icon" href="" title="@WebStrings.SidebarNewGeneralChatTooltip" aria-label="@WebStrings.SidebarNewGeneralChatLabel"><Icon Name="plus" /></a>
            </div>
        </div>
        @if (_searching)
        {
            <input type="search" id="sidebar-search" class="input input-sm sidebar-search" placeholder="@WebStrings.SidebarSearchChatsPlaceholder"
                   aria-label="@WebStrings.SidebarSearchChatsLabel" data-shortcut="search-input" @ref="_searchInput"
                   @bind="Filter" @bind:event="oninput" @onkeydown="OnSearchKey" />
        }
        @if (chats.Count == 0)
        {
            <p class="sidebar-empty">@(filtering ? WebStrings.SidebarNoChatsMatch : WebStrings.SidebarNoChatsYet)</p>
        }
        else
        {
            <ChatList Chats="chats" />
        }
    </section>

    <section class="sidebar-section" aria-labelledby="folders-heading">
        <div class="sidebar-heading">
            <Icon Name="folder" /><span id="folders-heading">@WebStrings.SidebarFoldersHeading</span>
            <button type="button" class="btn btn-ghost btn-sm btn-icon sidebar-heading-action" title="@WebStrings.SidebarOpenFolderTooltip"
                    aria-label="@WebStrings.SidebarOpenFolderLabel" @onclick="() => _picking = true"><Icon Name="folder-plus" /></button>
        </div>
        @if (folders.Count == 0)
        {
            <p class="sidebar-empty">@WebStrings.SidebarNoFoldersHint</p>
        }
        else
        {
            <ul class="folder-list">
                @foreach (var folder in folders)
                {
                    var folderChats = inFolder[folder.Path];
                    if (filtering && folderChats.Count == 0)
                    {
                        continue;
                    }

                    var available = FolderRegistry.IsAvailable(folder);
                    var expanded = filtering || !_collapsed.Contains(folder.Path);
                    <li @key="folder.Path" class="folder-item">
                        <div class="folder-head" @oncontextmenu="e => OpenMenu(folder, e)" @oncontextmenu:preventDefault>
                            <button type="button" class="folder-toggle" aria-expanded="@expanded.ToString().ToLowerInvariant()"
                                    title="@folder.Path" @onclick="() => ToggleFolder(folder)">
                                <Icon Name="@(expanded ? "chevron-down" : "chevron-right")" />
                                <span class="folder-name">@folder.Name</span>
                                @if (!available)
                                {
                                    <span class="folder-warning" title="@WebStrings.SidebarFolderNotFoundTooltip" role="img" aria-label="@WebStrings.SidebarFolderNotFoundLabel"><Icon Name="alert" /></span>
                                }
                            </button>
                            <div class="folder-actions">
                                @if (available)
                                {
                                    <a class="btn btn-ghost btn-sm btn-icon" href="@NewChatHref(folder)" title="@WebStrings.SidebarNewChatInFolderTooltip"
                                       aria-label="@FolderActionLabel(nameof(WebStrings.SidebarNewChatInFolder), folder.Name)"><Icon Name="plus" /></a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-ghost btn-sm btn-icon" title="@WebStrings.SidebarFindFolderTooltip"
                                            aria-label="@FolderActionLabel(nameof(WebStrings.SidebarFindFolder), folder.Name)" @onclick="() => _locating = folder"><Icon Name="folder" /></button>
                                }
                            </div>
                        </div>
                        @if (!available)
                        {
                            <p class="sidebar-empty">@WebStrings.SidebarFolderMissing</p>
                        }

                        @if (expanded)
                        {
                            if (folderChats.Count > 0)
                            {
                                <div class="folder-chats"><ChatList Chats="folderChats" /></div>
                            }
                            else if (available)
                            {
                                <p class="sidebar-empty folder-chats">@WebStrings.SidebarNoChatsInFolder</p>
                            }
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer">
        <div class="sidebar-links">
            <button type="button" class="nav-link" data-shortcut="settings" title="@WebStrings.SidebarSettingsTooltip" @onclick="() => SettingsState.Open()"><Icon Name="settings" /> @WebStrings.SidebarSettings</button>
        </div>
        <button type="button" class="nav-link nav-link-icon" @onclick="ToggleThemeAsync"
                title="@ThemeToggleLabel"
                aria-label="@ThemeToggleLabel">
            <Icon Name="@(_dark ? "moon" : "sun")" />
        </button>
    </div>
</nav>

<OpenFolderDialog Open="_picking" OnClose="() => _picking = false" OnPicked="OnFolderPickedAsync" />

<div @ref="_menu" id="@_menuId" class="menu context-menu" popover="auto" role="menu" aria-label="@(_menuFolder?.Name ?? WebStrings.SidebarFolderActions)" data-bh-menu>
    @if (_menuFolder is { } target)
    {
        @if (FolderRegistry.IsAvailable(target))
        {
            <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                    @onclick="() => Navigation.NavigateTo(NewChatHref(target))"><Icon Name="plus" />@WebStrings.SidebarNewChatMenuItem</button>
        }
        else
        {
            <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                    @onclick="() => _locating = target"><Icon Name="folder" />@WebStrings.SidebarFindFolderMenuItem</button>
        }

        <div class="menu-sep" role="separator"></div>
        <button type="button" class="menu-item menu-item-danger" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => _removing = target"><Icon Name="close" />@WebStrings.SidebarRemoveFolderMenuItem</button>
    }
</div>

<OpenFolderDialog Open="_locating is not null" OnClose="() => _locating = null" OnPicked="RelocateAsync"
                  Title="@WebStrings.SidebarRelocateTitle" Hint="@WebStrings.SidebarRelocateHint" ConfirmText="@WebStrings.SidebarRelocateConfirm" />

<ConfirmDialog Title="@WebStrings.SidebarRemoveFolderTitle" Open="_removing is not null" ConfirmText="@WebStrings.SidebarRemoveConfirm" OnConfirm="RemoveAsync" OnCancel="() => _removing = null">
    <p>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.SidebarRemoveFolderWarning), new Dictionary<string, object?> { ["name"] = _removing?.Name })</p>
</ConfirmDialog>

@code {
    private readonly HashSet<string> _collapsed = new(FolderPaths.Comparer);
    private RenderThrottle _throttle = null!;
    private bool _dark;
    private bool _picking;
    private FolderInfo? _locating;
    private FolderInfo? _removing;
    private FolderInfo? _menuFolder;
    private ElementReference _menu;
    private readonly string _menuId = $"folder-menu-{Guid.NewGuid():N}";
    private (double X, double Y)? _showMenuAt;
    private InputFile? _importInput;
    private ElementReference _searchInput;
    private bool _searching;
    private bool _focusSearch;
    private ChatSortOrder _sort;

    private const long MaxImportBytes = 8 * 1024 * 1024;

    private string Filter { get; set; } = string.Empty;

    private string ThemeToggleLabel => _dark ? WebStrings.SidebarSwitchToLightTheme : WebStrings.SidebarSwitchToDarkTheme;

    private static string FolderActionLabel(string pattern, string folder) =>
        ResourceMessageFormatter.Web.Format(pattern, new Dictionary<string, object?> { ["folder"] = folder });

    /// <summary>
    /// Gets or sets a value indicating whether the sidebar is hidden.
    /// </summary>
    [Parameter]
    public bool Collapsed { get; set; }

    protected override void OnInitialized()
    {
        _throttle = new RenderThrottle(() => InvokeAsync(StateHasChanged), TimeSpan.FromMilliseconds(100), Logger, Time);
        ChatService.Store.Changed += OnChatsChanged;
        ChatService.ActivityChanged += OnChatsChanged;
        Folders.Changed += OnChatsChanged;
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxImportBytes)
        {
            Toasts.Show(WebStrings.SidebarImportFileTooLarge, ToastKind.Error);
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(MaxImportBytes));
            var info = await ChatService.ImportAsync(await reader.ReadToEndAsync());
            Navigation.NavigateTo(Routes.Chat(info.Id));
        }
        catch (FormatException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Error);
        }
        catch (IOException)
        {
            Toasts.Show(WebStrings.SidebarImportReadFailed, ToastKind.Error);
        }
        finally
        {
            // Lets the same file be chosen again after a failed import.
            if (_importInput?.Element is { } input)
            {
                await JS.InvokeVoidAsync("bhChat.clearPicker", input);
            }
        }
    }

    public void Dispose()
    {
        ChatService.Store.Changed -= OnChatsChanged;
        ChatService.ActivityChanged -= OnChatsChanged;
        Folders.Changed -= OnChatsChanged;
        _throttle.Dispose();
    }

    private void OnChatsChanged(object? sender, EventArgs e)
    {
        _throttle.Request();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await JS.InvokeAsync<bool>("bhTheme.isDark");
            _sort = Enum.TryParse<ChatSortOrder>(await JS.InvokeAsync<string?>("bhChatSort.get"), out var saved) ? saved : ChatSortOrder.Updated;
            StateHasChanged();
        }

        if (_showMenuAt is var (x, y))
        {
            _showMenuAt = null;
            await JS.InvokeVoidAsync("bhUi.showContextMenu", _menu, x, y);
        }

        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchInput.FocusAsync();
        }
    }

    private async Task SetSortAsync(ChatSortOrder order)
    {
        _sort = order;
        await JS.InvokeVoidAsync("bhChatSort.set", order.ToString());
    }

    private void ToggleSearch()
    {
        _searching = !_searching;
        _focusSearch = _searching;
        if (!_searching)
        {
            Filter = string.Empty;
        }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ToggleSearch();
        }
    }

    private void OpenMenu(FolderInfo folder, MouseEventArgs e)
    {
        _menuFolder = folder;
        _showMenuAt = (e.ClientX, e.ClientY);
    }

    private static string NewChatHref(FolderInfo folder)
    {
        return "?folder=" + Uri.EscapeDataString(folder.Path);
    }

    private void ToggleFolder(FolderInfo folder)
    {
        if (!_collapsed.Remove(folder.Path))
        {
            _collapsed.Add(folder.Path);
        }
    }

    private async Task OnFolderPickedAsync(string path)
    {
        var result = await Folders.OpenAsync(path);
        if (result.Folder is null)
        {
            Toasts.Show(WebStrings.SidebarOpenFolderFailed, ToastKind.Error);
            return;
        }

        _picking = false;
        _collapsed.Remove(result.Folder.Path);
        Navigation.NavigateTo(NewChatHref(result.Folder));
    }

    private async Task RelocateAsync(string path)
    {
        var old = _locating;
        _locating = null;
        if (old is null)
        {
            return;
        }

        try
        {
            var result = await Folders.RelocateAsync(old.Path, path);
            if (result.Folder is null)
            {
                Toasts.Show(WebStrings.SidebarRelocateFolderFailed, ToastKind.Error);
                return;
            }

            await ChatService.Store.RepointFolderAsync(old.Path, result.Folder.Path);
            await ChatService.RefreshProjectsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show(WebStrings.SidebarRelocateWriteFailed, ToastKind.Error);
        }
    }

    private async Task RemoveAsync()
    {
        var folder = _removing;
        _removing = null;
        if (folder is null)
        {
            return;
        }

        try
        {
            await Folders.RemoveAsync(folder.Path);
            await ChatService.Store.RepointFolderAsync(folder.Path, null);
            await ChatService.RefreshProjectsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show(WebStrings.SidebarRemoveWriteFailed, ToastKind.Error);
        }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("bhTheme.set", _dark ? "dark" : "light");
    }
}
