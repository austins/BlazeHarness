@using BlazeHarness.Core
@inherits LayoutComponentBase
@implements IDisposable
@inject UiScripts UiScripts
@inject NavigationManager Navigation
@inject SettingsDialogState SettingsState

<button type="button" class="skip-link" data-bh-action="skipToChat">@WebStrings.MainLayoutSkipToChat</button>

<div class="app" data-circuit="@(_connected ? "ready" : "pending")">
    <Sidebar Collapsed="_collapsed" />
    <div class="resizer resizer-sidebar" data-resizer="sidebar" role="separator" aria-orientation="vertical" tabindex="0" aria-label="@WebStrings.MainLayoutResizeSidebar"></div>
    @if (!_collapsed)
    {
        <button type="button" class="sidebar-backdrop" aria-label="@WebStrings.MainLayoutCloseSidebar" tabindex="-1" @onclick="() => _collapsed = true"></button>
    }

    <div class="app-shell">
        <header class="topbar">
            <button type="button" class="btn btn-ghost btn-icon" aria-label="@(_collapsed ? WebStrings.MainLayoutShowSidebar : WebStrings.MainLayoutHideSidebar)" aria-expanded="@(_collapsed ? "false" : "true")" @onclick="() => _collapsed = !_collapsed"><Icon Name="menu" /></button>
            <span class="title">@AppConstants.AppName</span>
            <SidePanelToggle />
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

<ToastHost />
<SettingsDialog />

<div id="blazor-error-ui" data-nosnippet>
    @WebStrings.MainLayoutUnhandledError
    <a href="." class="reload">@WebStrings.MainLayoutReload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _collapsed;

    /// <summary>
    /// Whether the interactive circuit is connected.
    /// </summary>
    /// <remarks>End-to-end tests wait for this state because prerendered buttons do nothing yet.</remarks>
    private bool _connected;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SettingsState.Changed -= OnSettingsChangedAsync;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        SettingsState.Changed += OnSettingsChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _connected = true;
            _collapsed = await UiScripts.IsNarrowAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Collapse the drawer after navigation on a narrow screen.
    /// </summary>
    /// <remarks>An async void handler has nowhere to send an exception, so a closed browser must not escape it.</remarks>
    /// <param name="sender">The navigation event sender.</param>
    /// <param name="e">The new location.</param>
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await CollapseIfNarrowAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or InvalidOperationException or ObjectDisposedException)
        {
            // An async void handler has nowhere to send a circuit teardown error.
        }
    }

    /// <summary>
    /// Close the drawer before showing settings on a narrow screen.
    /// </summary>
    /// <remarks>The settings dialog opens over the drawer.</remarks>
    /// <returns>A task that completes when the drawer is settled.</returns>
    private Task OnSettingsChangedAsync()
    {
        return SettingsState.Section is null ? Task.CompletedTask : InvokeAsync(CollapseIfNarrowAsync);
    }

    private async Task CollapseIfNarrowAsync()
    {
        if (!_collapsed && await UiScripts.IsNarrowAsync())
        {
            _collapsed = true;
            StateHasChanged();
        }
    }
}
