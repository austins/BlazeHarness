@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<button type="button" class="skip-link" data-bh-action="skipToChat">Skip to chat</button>

<div class="app" data-circuit="@(_connected ? "ready" : "pending")">
    <Sidebar Collapsed="_collapsed" />
    @if (!_collapsed)
    {
        <button type="button" class="sidebar-backdrop" aria-label="Close sidebar" tabindex="-1" @onclick="() => _collapsed = true"></button>
    }

    <div class="workspace">
        <header class="topbar">
            <button type="button" class="btn btn-ghost btn-icon" aria-label="@(_collapsed ? "Show sidebar" : "Hide sidebar")" aria-expanded="@(_collapsed ? "false" : "true")" @onclick="() => _collapsed = !_collapsed"><Icon Name="menu" /></button>
            <span class="title">BlazeHarness</span>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

<ToastHost />
<SettingsDialog />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _collapsed;
    // Lets end-to-end tests wait until the circuit is live, since prerendered buttons do nothing yet.
    private bool _connected;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _connected = true;
            _collapsed = await IsNarrowAsync();
            StateHasChanged();
        }
    }

    // An async void handler has nowhere to send an exception, so a closed browser must not escape it.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_collapsed && await IsNarrowAsync())
        {
            _collapsed = true;
            StateHasChanged();
        }
    }

    private async Task<bool> IsNarrowAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("bhUi.isNarrow");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            return false;
        }
    }
}
