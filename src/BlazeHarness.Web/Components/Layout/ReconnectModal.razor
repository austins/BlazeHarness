<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            @WebStrings.ReconnectModalRejoining
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ReconnectModalRepeatedAttempt))
        </p>
        <p class="components-reconnect-failed-visible">
            @WebStrings.ReconnectModalFailed<br />@WebStrings.ReconnectModalRetryOrReload
        </p>
        <button type="button" id="components-reconnect-button" class="btn btn-primary components-reconnect-failed-visible">
            @WebStrings.ReconnectModalRetry
        </button>
        <p class="components-pause-visible">
            @WebStrings.ReconnectModalPaused
        </p>
        <p class="components-resume-failed-visible">
            @WebStrings.ReconnectModalResumeFailed<br />@WebStrings.ReconnectModalRetryOrReload
        </p>
        <button type="button" id="components-resume-button" class="btn btn-primary components-pause-visible components-resume-failed-visible">
            @WebStrings.ReconnectModalResume
        </button>
    </div>
</dialog>
