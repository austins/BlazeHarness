@implements IDisposable
@inject SettingsDialogState State

<Dialog Title="@WebStrings.SettingsDialogTitle" Open="State.Section is not null" Class="dialog-settings" OnClose="State.Close">
    <div class="settings">
        <nav class="settings-nav" aria-label="@WebStrings.SettingsDialogSectionsLabel">
            @foreach (var (section, icon) in Sections)
            {
                <button type="button" class="nav-link@(State.Section == section ? " active" : "")"
                        aria-current="@(State.Section == section ? "page" : null)" @onclick="() => State.Open(section)">
                    <Icon Name="@icon" /> @SectionLabel(section)
                </button>
            }
        </nav>
        <div class="settings-content">
            @switch (State.Section)
            {
                case SettingsSection.Providers:
                    <ProvidersSettings />
                    break;
                case SettingsSection.Permissions:
                    <PermissionsSettings />
                    break;
                case SettingsSection.Mcp:
                    <McpSettings />
                    break;
                case SettingsSection.Skills:
                    <SkillsSettings />
                    break;
                case SettingsSection.Web:
                    <WebToolsSettings />
                    break;
                case SettingsSection.General:
                    <GeneralSettings />
                    break;
                case SettingsSection.Diagnostics:
                    <DiagnosticsSettings />
                    break;
                default:
                    break;
            }
        </div>
    </div>
</Dialog>

@code {
    private static readonly (SettingsSection Section, string Icon)[] Sections =
    [
        (SettingsSection.General, "settings"),
        (SettingsSection.Providers, "server"),
        (SettingsSection.Permissions, "shield"),
        (SettingsSection.Mcp, "plug"),
        (SettingsSection.Skills, "book"),
        (SettingsSection.Web, "search"),
        (SettingsSection.Diagnostics, "wrench"),
    ];

    private static string SectionLabel(SettingsSection section) => section switch
    {
        SettingsSection.General => WebStrings.SettingsDialogGeneral,
        SettingsSection.Providers => WebStrings.SettingsDialogProviders,
        SettingsSection.Permissions => WebStrings.SettingsDialogPermissions,
        SettingsSection.Mcp => WebStrings.SettingsDialogMcpServers,
        SettingsSection.Skills => WebStrings.SettingsDialogSkills,
        SettingsSection.Web => WebStrings.SettingsDialogWeb,
        _ => WebStrings.SettingsDialogDiagnostics,
    };

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
