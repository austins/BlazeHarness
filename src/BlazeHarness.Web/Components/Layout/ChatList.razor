@using BlazeHarness.Core
@inject IJSRuntime JS
@inject SessionService Sessions
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject AppPaths Paths
@using System.Diagnostics

<ul class="chat-list">
    @foreach (var chat in Chats)
    {
        <li @key="chat.Id" class="chat-item" @oncontextmenu="e => OpenMenu(chat, e)" @oncontextmenu:preventDefault="_renaming != chat.Id">
            @if (_renaming == chat.Id)
            {
                <input class="input input-sm" @ref="_renameInput" aria-label="Chat name" maxlength="@MaxTitleLength"
                       @bind="_renameText" @bind:event="oninput"
                       @onkeydown="OnRenameKey" @onblur="CommitRenameAsync" />
            }
            else
            {
                <NavLink class="chat-link" href="@Routes.Chat(chat.Id)">
                    <span class="chat-title">@DisplayTitle(chat)</span>
                    @if (Sessions.IsRunning(chat.Id))
                    {
                        <span class="chat-busy" role="status" title="Replying" aria-label="Replying"><Icon Name="spinner" Spin="true" /></span>
                    }
                </NavLink>
            }
        </li>
    }
</ul>

<div @ref="_menu" id="@_menuId" class="menu context-menu" popover="auto" role="menu" aria-label="@(_menuChat is null ? "Chat actions" : DisplayTitle(_menuChat))" data-bh-menu>
    @if (_menuChat is { } target)
    {
        <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => StartRename(target)"><Icon Name="pencil" />Rename</button>
        <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => _moving = target"><Icon Name="arrow-right" />Move to folder</button>
        <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => OpenSessionFolder(target)"><Icon Name="folder" />Open session folder</button>
        <div class="menu-sep" role="separator"></div>
        <button type="button" class="menu-item menu-item-danger" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => _deleting = target"><Icon Name="trash" />Delete</button>
    }
</div>

<MoveChatDialog Chat="_moving" OnClose="() => _moving = null" />

<ConfirmDialog Title="Delete this chat?" Open="_deleting is not null" ConfirmText="Delete" OnConfirm="DeleteAsync" OnCancel="() => _deleting = null">
    <p>This can't be undone. <strong>@(_deleting is null ? string.Empty : DisplayTitle(_deleting))</strong> and everything stored for it is removed. Files in your project folder are not touched.</p>
</ConfirmDialog>

@code {
    private const int MaxTitleLength = 200;

    private string? _renaming;
    private string _renameText = string.Empty;
    private bool _focusRename;
    private SessionInfo? _deleting;
    private SessionInfo? _moving;
    private ElementReference _renameInput;
    private ElementReference _menu;
    private readonly string _menuId = $"chat-menu-{Guid.NewGuid():N}";
    private SessionInfo? _menuChat;
    private (double X, double Y)? _showMenuAt;

    /// <summary>
    /// Gets or sets the chats to list, in display order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SessionInfo> Chats { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await JS.InvokeVoidAsync("bhUi.focusSelect", _renameInput);
        }

        if (_showMenuAt is var (x, y))
        {
            _showMenuAt = null;
            await JS.InvokeVoidAsync("bhUi.showContextMenu", _menu, x, y);
        }
    }

    private void OpenMenu(SessionInfo chat, MouseEventArgs e)
    {
        if (_renaming == chat.Id)
        {
            return;
        }

        _menuChat = chat;
        _showMenuAt = (e.ClientX, e.ClientY);
    }

    private void OpenSessionFolder(SessionInfo chat)
    {
        var path = Paths.SessionDirectory(chat.Id);
        try
        {
            if (!Directory.Exists(path))
            {
                Toasts.Show("This chat has no folder on disk yet.", ToastKind.Error);
                return;
            }

            using var process = Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            Toasts.Show("The session folder could not be opened.", ToastKind.Error);
        }
    }

    private static string DisplayTitle(SessionInfo chat)
    {
        return string.IsNullOrWhiteSpace(chat.Title) ? "Untitled chat" : chat.Title;
    }

    private void StartRename(SessionInfo chat)
    {
        _renaming = chat.Id;
        _renameText = chat.Title;
        _focusRename = true;
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitRenameAsync();
        }
        else if (e.Key == "Escape")
        {
            _renaming = null;
        }
    }

    private async Task CommitRenameAsync()
    {
        var id = _renaming;
        if (id is null)
        {
            return;
        }

        _renaming = null;
        var title = _renameText.Trim();
        if (title.Length == 0 || title == Sessions.Store.Find(id)?.Title)
        {
            return;
        }

        try
        {
            await Sessions.Store.RenameAsync(id, title);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The chat could not be renamed because its file could not be written.", ToastKind.Error);
        }
    }

    private async Task DeleteAsync()
    {
        var chat = _deleting;
        _deleting = null;
        if (chat is null)
        {
            return;
        }

        try
        {
            if (!await Sessions.DeleteAsync(chat.Id))
            {
                Toasts.Show("This chat is still replying. Stop it first, then delete it.", ToastKind.Error);
                return;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show("The chat could not be deleted because its files could not be removed.", ToastKind.Error);
            return;
        }

        if (Navigation.ToBaseRelativePath(Navigation.Uri).Equals(Routes.Chat(chat.Id), StringComparison.Ordinal))
        {
            Navigation.NavigateTo(string.Empty);
        }
    }
}
