@using BlazeHarness.Core
@using BlazeHarness.Web.Hosting
@inject IJSRuntime JS
@inject ChatService ChatService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject AppPaths Paths
@using System.Diagnostics
@using BlazeHarness.Core.Chats

<ul class="chat-list">
    @foreach (var chat in Chats)
    {
        <li @key="chat.Id" class="chat-item" @oncontextmenu="e => OpenMenu(chat, e)" @oncontextmenu:preventDefault="_renaming != chat.Id">
            @if (_renaming == chat.Id)
            {
                <input class="input input-sm" @ref="_renameInput" aria-label="@WebStrings.ChatListRenameLabel" maxlength="@MaxTitleLength"
                       @bind="_renameText" @bind:event="oninput"
                       @onkeydown="OnRenameKey" @onblur="CommitRenameAsync" />
            }
            else
            {
                <NavLink class="chat-link" href="@Routes.Chat(chat.Id)">
                    <span class="chat-title">@DisplayTitle(chat)</span>
                    @if (ChatService.NeedsUser(chat.Id))
                    {
                        <span class="badge badge-accent chat-needs" role="status" title="@WebStrings.ChatListNeedsYouTooltip">@WebStrings.ChatListNeedsYouBadge</span>
                    }
                    else if (ChatService.IsRunning(chat.Id))
                    {
                        <span class="chat-busy" role="status" title="@WebStrings.ChatListReplyingTooltip" aria-label="@WebStrings.ChatListReplyingLabel"><Icon Name="spinner" Spin="true" /></span>
                    }
                </NavLink>
                <div class="chat-actions">
                    <Menu Label="@ActionLabel(chat)" Title="@WebStrings.ChatListActions" IconOnly="true">
                        <Trigger><Icon Name="more" /></Trigger>
                        <ChildContent>
                            <MenuItem IsAction="true" Label="@WebStrings.ChatListRenameMenuItem" OnSelect="() => StartRename(chat)" />
                            @if (chat.Worktree is null)
                            {
                                <MenuItem IsAction="true" Label="@WebStrings.ChatListMoveMenuItem" OnSelect="() => _moving = chat" />
                            }
                            @if (Client?.IsLocal == true)
                            {
                                <MenuItem IsAction="true" Label="@WebStrings.ChatListOpenDataMenuItem" OnSelect="() => OpenChatData(chat)" />
                            }
                            <MenuItem IsAction="true" Label="@WebStrings.ChatListCopyReferenceMenuItem" OnSelect="() => CopyReferenceAsync(chat)" />
                            <div class="menu-sep" role="separator"></div>
                            <MenuItem IsAction="true" Danger="true" Label="@WebStrings.ChatListDeleteMenuItem" OnSelect="() => _deleting = chat" />
                        </ChildContent>
                    </Menu>
                </div>
            }
        </li>
    }
</ul>

<div @ref="_menu" id="@_menuId" class="menu context-menu" popover="auto" role="menu" aria-label="@(_menuChat is null ? WebStrings.ChatListActions : DisplayTitle(_menuChat))" data-bh-menu>
    @if (_menuChat is { } target)
    {
        <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => StartRename(target)"><Icon Name="pencil" />@WebStrings.ChatListRenameMenuItem</button>
        @if (target.Worktree is null)
        {
            <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                    @onclick="() => _moving = target"><Icon Name="arrow-right" />@WebStrings.ChatListMoveMenuItem</button>
        }
        @if (Client?.IsLocal == true)
        {
            <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                    @onclick="() => OpenChatData(target)"><Icon Name="folder" />@WebStrings.ChatListOpenDataMenuItem</button>
        }
        <button type="button" class="menu-item" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => CopyReferenceAsync(target)"><Icon Name="copy" />@WebStrings.ChatListCopyReferenceMenuItem</button>
        <div class="menu-sep" role="separator"></div>
        <button type="button" class="menu-item menu-item-danger" role="menuitem" popovertarget="@_menuId" popovertargetaction="hide"
                @onclick="() => _deleting = target"><Icon Name="trash" />@WebStrings.ChatListDeleteMenuItem</button>
    }
</div>

<MoveChatDialog Chat="_moving" OnClose="() => _moving = null" />

<RemoveWorktreeDialog Chat="_deleting?.Worktree is null ? null : _deleting" Deleting="true" OnClose="() => _deleting = null" OnConfirm="DeleteAsync" />

<ConfirmDialog Title="@WebStrings.ChatListDeleteTitle" Open="_deleting is { Worktree: null }" ConfirmText="@WebStrings.ChatListDeleteConfirm" OnConfirm="() => DeleteAsync(false)" OnCancel="() => _deleting = null">
    <p>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ChatListDeleteWarning), new Dictionary<string, object?> { ["title"] = _deleting is null ? string.Empty : DisplayTitle(_deleting) })</p>
</ConfirmDialog>

@code {
    private const int MaxTitleLength = 200;

    private string? _renaming;
    private string _renameText = string.Empty;
    private bool _focusRename;
    private ChatInfo? _deleting;
    private ChatInfo? _moving;
    private ElementReference _renameInput;
    private ElementReference _menu;
    private readonly string _menuId = $"chat-menu-{Guid.NewGuid():N}";
    private ChatInfo? _menuChat;
    private (double X, double Y)? _showMenuAt;

    /// <summary>
    /// Gets or sets the chats to list, in display order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ChatInfo> Chats { get; set; } = [];

    [CascadingParameter]
    private ClientMachine? Client { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            try
            {
                await JS.InvokeVoidAsync("bhUi.focusSelect", _renameInput);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }

        if (_showMenuAt is var (x, y))
        {
            _showMenuAt = null;
            try
            {
                await JS.InvokeVoidAsync("bhUi.showContextMenu", _menu, x, y);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }
    }

    private void OpenMenu(ChatInfo chat, MouseEventArgs e)
    {
        if (_renaming == chat.Id)
        {
            return;
        }

        _menuChat = chat;
        _showMenuAt = (e.ClientX, e.ClientY);
    }

    private void OpenChatData(ChatInfo chat)
    {
        if (Client?.IsLocal != true)
        {
            return;
        }

        var path = Paths.ChatDirectory(chat.Id);
        try
        {
            if (!Directory.Exists(path))
            {
                Toasts.Show(WebStrings.ChatListNoFolderOnDisk, ToastKind.Error);
                return;
            }

            using var process = Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            Toasts.Show(WebStrings.ChatListOpenDataFailed, ToastKind.Error);
        }
    }

    private async Task CopyReferenceAsync(ChatInfo chat)
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("bhChat.copyText", ChatReference.Format(chat.Id));
            Toasts.Show(copied ? WebStrings.ChatListReferenceCopied : WebStrings.ChatListCopyReferenceFailed, copied ? ToastKind.Success : ToastKind.Error);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
    }

    internal static string DisplayTitle(ChatInfo chat)
    {
        return string.IsNullOrWhiteSpace(chat.Title) ? WebStrings.ChatListUntitledChat : chat.Title;
    }

    private static string ActionLabel(ChatInfo chat) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.ChatListActionsFor), new Dictionary<string, object?> { ["title"] = DisplayTitle(chat) });

    private void StartRename(ChatInfo chat)
    {
        _renaming = chat.Id;
        _renameText = chat.Title;
        _focusRename = true;
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitRenameAsync();
        }
        else if (e.Key == "Escape")
        {
            _renaming = null;
        }
    }

    private async Task CommitRenameAsync()
    {
        var id = _renaming;
        if (id is null)
        {
            return;
        }

        _renaming = null;
        var title = _renameText.Trim();
        if (title.Length == 0 || title == ChatService.Store.Find(id)?.Title)
        {
            return;
        }

        try
        {
            await ChatService.Store.RenameAsync(id, title);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show(WebStrings.ChatListRenameFailed, ToastKind.Error);
        }
    }

    private async Task DeleteAsync(bool deleteBranch)
    {
        var chat = _deleting;
        _deleting = null;
        if (chat is null)
        {
            return;
        }

        try
        {
            if (!await ChatService.DeleteAsync(chat.Id, deleteBranch))
            {
                Toasts.Show(WebStrings.ChatListStillReplying, ToastKind.Error);
                return;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Toasts.Show(WebStrings.ChatListDeleteFailed, ToastKind.Error);
            return;
        }

        if (Navigation.ToBaseRelativePath(Navigation.Uri).Equals(Routes.Chat(chat.Id), StringComparison.Ordinal))
        {
            Navigation.NavigateTo(string.Empty);
        }
    }
}
