@using BlazeHarness.Core.Agent

<ol class="todo-list" aria-label="@WebStrings.TodoChecklistLabel">
    @foreach (var item in Items)
    {
        var status = Idle && item.Status == TodoStatus.InProgress ? TodoStatus.Pending : item.Status;
        <li class="todo-item" data-status="@StatusKey(status)">
            <span class="todo-mark" aria-hidden="true">@if (status == TodoStatus.Completed) { <Icon Name="check" /> }</span>
            <span class="visually-hidden">@StatusText(status): </span>
            <span class="todo-text">@item.Text</span>
        </li>
    }
</ol>

@code {
    /// <summary>
    /// Gets or sets the items to show, in order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TodoItem> Items { get; set; } = [];

    /// <summary>
    /// Gets or sets a value indicating whether no run is going, so an item left in progress is shown as not started.
    /// </summary>
    [Parameter]
    public bool Idle { get; set; }

    private static string StatusKey(TodoStatus status) => status switch
    {
        TodoStatus.Completed => "completed",
        TodoStatus.InProgress => "in-progress",
        _ => "pending",
    };

    private static string StatusText(TodoStatus status) => status switch
    {
        TodoStatus.Completed => WebStrings.TodoChecklistDone,
        TodoStatus.InProgress => WebStrings.TodoChecklistInProgress,
        _ => WebStrings.TodoChecklistNotStarted,
    };
}
