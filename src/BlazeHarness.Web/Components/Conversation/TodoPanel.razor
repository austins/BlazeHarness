@using BlazeHarness.Core.Agent

@if (Todos is { Items.Count: > 0 })
{
    <section class="todo-panel" aria-label="@WebStrings.TodoPanelLabel">
        <button type="button" class="todo-head" aria-expanded="@(_open ? "true" : "false")" aria-controls="@_bodyId" @onclick="Toggle">
            <Icon Name="@(_open ? "chevron-down" : "chevron-right")" />
            <span class="todo-count">@Count</span>
            @if (Running && Todos.Current is { } current)
            {
                <span class="todo-current">@current.Text</span>
            }
        </button>
        @if (_open)
        {
            <div class="todo-body" id="@_bodyId">
                <TodoChecklist Items="Todos.Items" Idle="!Running" />
            </div>
        }
    </section>
}

@code {
    private readonly string _bodyId = "todo-" + Guid.NewGuid().ToString("N");
    private bool _open;

    /// <summary>
    /// Gets or sets the chat's to-do list, or null while no chat is open.
    /// </summary>
    [Parameter]
    public TodoList? Todos { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a run is going, so a step can be shown as being worked on.
    /// </summary>
    [Parameter]
    public bool Running { get; set; }

    private string Count =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.TodoPanelProgress),
            new Dictionary<string, object?> { ["completed"] = Todos!.CompletedCount, ["total"] = Todos.Items.Count })
        + (Running && Todos.Current is not null ? ":" : string.Empty);

    private void Toggle() => _open = !_open;
}
