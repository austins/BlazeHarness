@using BlazeHarness.Core.Skills
@implements IDisposable
@inject SkillCatalog Catalog
@inject SettingsDialogState SettingsState
@inject SessionService Sessions

@if (_available.Skills.Count > 0)
{
    <Popover Label="Skills" Title="Skills this chat can load">
        <Trigger><Icon Name="book" /> Skills <span class="badge">@_available.Skills.Count(IsOn) / @_available.Skills.Count</span></Trigger>
        <ChildContent>
            <ul class="panel-list">
                @foreach (var skill in _available.Skills)
                {
                    <li>
                        <label class="panel-check" title="@skill.Description">
                            <input type="checkbox" checked="@IsOn(skill)" @onchange="e => SetAsync(skill.Name, (bool)e.Value!)" />
                            <span class="panel-check-name">@skill.Name</span>
                        </label>
                    </li>
                }
            </ul>
            <p class="panel-note">
                <Icon Name="info" /> <span>Applies to this chat only, from the next reply</span>
                <button type="button" class="link-button" @onclick="() => SettingsState.Open(SettingsSection.Skills)">Manage</button>
            </p>
        </ChildContent>
    </Popover>
}

@code {
    private SkillResolution _available = SkillResolution.Of();

    /// <summary>
    /// Gets or sets the id of the chat whose skills are shown.
    /// </summary>
    [Parameter, EditorRequired]
    public string SessionId { get; set; } = string.Empty;

    public void Dispose()
    {
        Catalog.Changed -= OnCatalogChanged;
    }

    protected override void OnInitialized()
    {
        Catalog.Changed += OnCatalogChanged;
    }

    protected override void OnParametersSet()
    {
        _available = Sessions.AvailableSkills(SessionId);
    }

    private bool IsOn(SkillInfo skill) => Sessions.IsSkillEnabled(SessionId, skill.Name);

    private async Task SetAsync(string name, bool enabled)
    {
        await Sessions.SetSkillAsync(SessionId, name, enabled);
    }

    private void OnCatalogChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _available = Sessions.AvailableSkills(SessionId);
            StateHasChanged();
        });
    }
}
