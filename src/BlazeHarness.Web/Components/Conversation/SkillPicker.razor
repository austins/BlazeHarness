@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Skills
@implements IDisposable
@inject SkillCatalog Catalog
@inject SettingsDialogState SettingsState
@inject ChatService ChatService

@if (_available.Skills.Count > 0)
{
    <Popover Label="Skills" Title="Skills this chat can load">
        <Trigger><Icon Name="book" /> Skills <span class="badge">@_available.Skills.Count(IsOn) / @_available.Skills.Count</span></Trigger>
        <ChildContent>
            <ul class="panel-list">
                @foreach (var skill in _available.Skills)
                {
                    <li>
                        <label class="panel-check" title="@skill.Description">
                            <input type="checkbox" checked="@IsOn(skill)" @onchange="e => SetAsync(skill.Name, (bool)e.Value!)" />
                            <span class="panel-check-name">@skill.Name</span>
                        </label>
                    </li>
                }
            </ul>
            <p class="panel-note">
                <Icon Name="info" /> <span>Applies to this chat only, from the next reply. Changing it resets the model's prompt cache, so that reply may be slower.</span>
                <button type="button" class="link-button" @onclick="() => SettingsState.Open(SettingsSection.Skills)">Manage</button>
            </p>
        </ChildContent>
    </Popover>
}

@code {
    private SkillResolution _available = SkillResolution.Of();

    /// <summary>
    /// Gets or sets the chat id, or null before the first message.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets the folder whose skills are shown before the chat is created.
    /// </summary>
    [Parameter]
    public string? FolderPath { get; set; }

    /// <summary>
    /// Gets or sets the skill choices before the chat is created.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, bool>? Choices { get; set; }

    /// <summary>
    /// Gets or sets the callback for choosing a skill before the chat is created.
    /// </summary>
    [Parameter]
    public EventCallback<(string Name, bool Enabled)> OnChoose { get; set; }

    public void Dispose()
    {
        Catalog.Changed -= OnCatalogChanged;
    }

    protected override void OnInitialized()
    {
        Catalog.Changed += OnCatalogChanged;
    }

    protected override void OnParametersSet()
    {
        _available = AvailableSkills();
    }

    private SkillResolution AvailableSkills() => ChatId is { } id ? ChatService.AvailableSkills(id) : Catalog.Resolve(FolderPath);

    private bool IsOn(SkillInfo skill) => ChatId is { } id
        ? ChatService.IsSkillEnabled(id, skill.Name)
        : SkillCatalog.IsEnabled(skill.Name, Catalog.IsDisabledGlobally(skill.Name), Choices);

    private async Task SetAsync(string name, bool enabled)
    {
        if (ChatId is { } id)
        {
            await ChatService.SetSkillAsync(id, name, enabled);
        }
        else
        {
            await OnChoose.InvokeAsync((name, enabled));
        }
    }

    private void OnCatalogChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _available = AvailableSkills();
            StateHasChanged();
        });
    }
}
