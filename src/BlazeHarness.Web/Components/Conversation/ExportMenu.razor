@using BlazeHarness.Core.Chats.Export
@using BlazeHarness.Core.Chats
@using BlazeHarness.Web.Hosting

<Popover Label="@WebStrings.ExportMenuLabel" Title="@WebStrings.ExportMenuTooltip">
    <Trigger><Icon Name="arrow-up" /> @WebStrings.ExportMenuButton</Trigger>
    <ChildContent>
        <div class="panel-head"><span>@WebStrings.ExportMenuHeading</span></div>
        <ul class="panel-list">
            <li>
                <a class="panel-option" href="@ExportEndpoints.AddressOf(ChatId, ExportFormat.Markdown)" download>
                    <Icon Name="file" />
                    <span class="panel-option-text"><span class="panel-option-name">Markdown</span><span class="panel-option-hint">@WebStrings.ExportMenuMarkdownHint</span></span>
                </a>
            </li>
            <li>
                <a class="panel-option" href="@ExportEndpoints.AddressOf(ChatId, ExportFormat.Json)" download>
                    <Icon Name="file" />
                    <span class="panel-option-text"><span class="panel-option-name">JSON</span><span class="panel-option-hint">@WebStrings.ExportMenuJsonHint</span></span>
                </a>
            </li>
        </ul>
        <p class="panel-foot panel-foot-warning"><Icon Name="alert" /> <span>@WebStrings.ExportMenuSecretsWarning</span></p>
    </ChildContent>
</Popover>

@code {
    /// <summary>
    /// Gets or sets the id of the chat to export.
    /// </summary>
    [Parameter, EditorRequired]
    public string ChatId { get; set; } = string.Empty;
}
