@using BlazeHarness.Core.Permissions
@using BlazeHarness.Core.Sandbox
@inject IShellSandbox Sandbox
@inject PermissionDefaults Defaults

<Menu Label="@WebStrings.PermissionPickerLabel" Title="@TriggerTitle" Tone="@Tone">
    <Trigger><Icon Name="@(Settings.IsRisky || !Sandboxed ? "alert" : "shield")" /> <span class="menu-trigger-text">@AccessName(Settings.Access, brief: true) · @ApprovalsName(Settings.Approvals)</span></Trigger>
    <ChildContent>
        <div class="menu-heading">@WebStrings.PermissionPickerAccessHeading</div>
        <MenuItem Label="@AccessName(AccessLevel.ReadOnly)" Description="@WebStrings.PermissionPickerReadOnlyDescription" Checked="Settings.Access == AccessLevel.ReadOnly" OnSelect="() => Choose(Settings with { Access = AccessLevel.ReadOnly })" />
        <MenuItem Label="@AccessName(AccessLevel.WriteInFolder)" Description="@(HasFolder ? WebStrings.PermissionPickerFolderDescription : WebStrings.PermissionPickerChatFolderDescription)" Checked="Settings.Access == AccessLevel.WriteInFolder" OnSelect="() => Choose(Settings with { Access = AccessLevel.WriteInFolder })" />
        @if (Defaults.AllowBypass || Settings.Access == AccessLevel.Unrestricted)
        {
            <MenuItem Label="@AccessName(AccessLevel.Unrestricted)" Description="@WebStrings.PermissionPickerUnrestrictedDescription" Checked="Settings.Access == AccessLevel.Unrestricted" OnSelect="() => Choose(Settings with { Access = AccessLevel.Unrestricted })" />
        }
        <div class="menu-sep" role="separator"></div>
        <div class="menu-heading">@WebStrings.PermissionPickerApprovalsHeading</div>
        <MenuItem Label="@ApprovalsName(ApprovalMode.AskFirst)" Description="@WebStrings.PermissionPickerAskFirstDescription" Checked="Settings.Approvals == ApprovalMode.AskFirst" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.AskFirst })" />
        <MenuItem Label="@ApprovalsName(ApprovalMode.AutoApprove)" Description="@WebStrings.PermissionPickerAskForExceptionsDescription" Checked="Settings.Approvals == ApprovalMode.AutoApprove" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.AutoApprove })" />
        @if (Defaults.AllowBypass || Settings.Approvals == ApprovalMode.NeverAsk)
        {
            <MenuItem Label="@ApprovalsName(ApprovalMode.NeverAsk)" Description="@WebStrings.PermissionPickerNeverAskDescription" Checked="Settings.Approvals == ApprovalMode.NeverAsk" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.NeverAsk })" />
        }
        <div class="menu-sep" role="separator"></div>
        <p class="menu-note" data-tone="@Tone" title="@Sandbox.Status.Detail">
            @if (Settings.Access == AccessLevel.Unrestricted)
            {
                <Icon Name="alert" /> <span>@WebStrings.PermissionPickerUnrestrictedNote</span>
            }
            else if (Sandbox.Status.IsAvailable)
            {
                <Icon Name="shield" /> <span>@WebStrings.PermissionPickerSandboxedNote</span>
            }
            else
            {
                <Icon Name="alert" /> <span>@WebStrings.PermissionPickerNoSandboxNote</span>
            }
        </p>
    </ChildContent>
</Menu>
<Dialog Title="@WebStrings.PermissionPickerConfirmTitle" Open="_pending is not null" OnClose="Cancel">
    <ChildContent>
        @if (TurnsOnAccess(_pending))
        {
            <p>@WebStrings.PermissionPickerUnrestrictedWarning</p>
        }

        @if (TurnsOnApprovals(_pending))
        {
            <p>@WebStrings.PermissionPickerNeverAskWarning</p>
        }

        <p class="hint">@WebStrings.PermissionPickerConfirmHint</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="Cancel">@WebStrings.PermissionPickerCancelButton</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmAsync">@WebStrings.PermissionPickerConfirmButton</button>
    </Footer>
</Dialog>

@code {
    private PermissionSettings? _pending;

    /// <summary>
    /// Gets or sets the settings to show.
    /// </summary>
    [Parameter]
    public PermissionSettings Settings { get; set; } = PermissionSettings.Default;

    /// <summary>
    /// Gets or sets a value indicating whether the chat works in a folder the user opened, and not only in its own chat files.
    /// </summary>
    [Parameter]
    public bool HasFolder { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback for the user choosing settings, after confirming any that switch off a safeguard.
    /// </summary>
    [Parameter]
    public EventCallback<PermissionSettings> OnChange { get; set; }

    private bool Sandboxed => Settings.Access != AccessLevel.Unrestricted && Sandbox.Status.IsAvailable;

    private string Tone => (Settings.IsRisky, Sandboxed) switch
    {
        (true, _) => "danger",
        (false, true) => "success",
        _ => "warning",
    };

    private string TriggerTitle => (Settings.IsRisky, Sandboxed) switch
    {
        (true, _) => WebStrings.PermissionPickerRiskyTitle,
        (false, true) => WebStrings.PermissionPickerSandboxedTitle,
        _ => WebStrings.PermissionPickerNoSandboxTitle,
    };

    private string AccessName(AccessLevel access, bool brief = false) => access switch
    {
        AccessLevel.ReadOnly => WebStrings.PermissionPickerReadOnly,
        AccessLevel.WriteInFolder when HasFolder => brief ? WebStrings.PermissionPickerFolder : WebStrings.PermissionPickerWriteInFolder,
        AccessLevel.WriteInFolder => brief ? WebStrings.PermissionPickerChatFolder : WebStrings.PermissionPickerWriteInChatFolder,
        _ => WebStrings.PermissionPickerUnrestricted,
    };

    private static string ApprovalsName(ApprovalMode approvals) => approvals switch
    {
        ApprovalMode.AskFirst => WebStrings.PermissionPickerAskFirst,
        ApprovalMode.AutoApprove => WebStrings.PermissionPickerAskForExceptions,
        _ => WebStrings.PermissionPickerNeverAsk,
    };

    private static bool IsRiskyLevel(AccessLevel level) => level == AccessLevel.Unrestricted;

    private bool TurnsOnAccess(PermissionSettings? chosen) => chosen is { } c && IsRiskyLevel(c.Access) && !IsRiskyLevel(Settings.Access);

    private bool TurnsOnApprovals(PermissionSettings? chosen) => chosen is { Approvals: ApprovalMode.NeverAsk } && Settings.Approvals != ApprovalMode.NeverAsk;

    private async Task Choose(PermissionSettings chosen)
    {
        if (chosen == Settings)
        {
            return;
        }

        if (TurnsOnAccess(chosen) || TurnsOnApprovals(chosen))
        {
            _pending = chosen;
            return;
        }

        await OnChange.InvokeAsync(chosen);
    }

    private void Cancel()
    {
        _pending = null;
    }

    private async Task ConfirmAsync()
    {
        var chosen = _pending;
        _pending = null;
        if (chosen is { } settings)
        {
            await OnChange.InvokeAsync(settings);
        }
    }
}
