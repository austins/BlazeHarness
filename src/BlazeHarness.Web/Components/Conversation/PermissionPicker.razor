@using BlazeHarness.Core.Permissions
@using BlazeHarness.Core.Sandbox
@inject IShellSandbox Sandbox
@inject PermissionDefaults Defaults

@* Changing the key makes Blazor build new selects, which shows the saved values again after a choice was cancelled. *@
<select class="select" @key="@("access" + _version)" aria-label="Access level" title="What the model's tools may touch" value="@Settings.Access" @onchange="OnAccessChanged">
    <option value="@AccessLevel.ReadOnly">Read only</option>
    <option value="@AccessLevel.WriteInFolder">@(HasFolder ? "Write in folder" : "Write in session files")</option>
    @if (Defaults.AllowBypass || Settings.Access == AccessLevel.Unrestricted)
    {
        <option value="@AccessLevel.Unrestricted">Unrestricted</option>
    }
</select>
<select class="select" @key="@("approvals" + _version)" aria-label="Approvals" title="When you are asked before a tool runs" value="@Settings.Approvals" @onchange="OnApprovalsChanged">
    <option value="@ApprovalMode.AskFirst">Ask first</option>
    <option value="@ApprovalMode.AutoApprove">Auto-approve</option>
    @if (Defaults.AllowBypass || Settings.Approvals == ApprovalMode.NeverAsk)
    {
        <option value="@ApprovalMode.NeverAsk">Never ask</option>
    }
</select>
@if (Settings.Access != AccessLevel.Unrestricted)
{
    @if (Sandbox.Status.IsAvailable)
    {
        <span class="badge badge-success" role="status" title="@Sandbox.Status.Detail"><Icon Name="shield" /> Sandboxed</span>
    }
    else
    {
        <span class="badge badge-warning" role="status" title="@Sandbox.Status.Detail"><Icon Name="alert" /> No sandbox, commands blocked</span>
    }
}

@if (Settings.IsRisky)
{
    <span class="badge badge-warning" role="status" title="Some safeguards are off for this chat"><Icon Name="alert" /> @(Settings.Access == AccessLevel.Unrestricted ? "Unrestricted" : "Never asks")</span>
}

<Dialog Title="Turn off a safeguard?" Open="_pending is not null" OnClose="Cancel">
    <ChildContent>
        @if (TurnsOnAccess(_pending))
        {
            <p>Unrestricted: tools and commands can read and change anything your user account can, with no sandbox.</p>
        }

        @if (TurnsOnApprovals(_pending))
        {
            <p>Never ask: tool calls run without asking you first. Text the model reads from files or web pages could trick it into running harmful commands.</p>
        }

        <p class="hint">This only applies to this chat. Protected folders such as your SSH keys stay blocked.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="Cancel">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmAsync">Turn on</button>
    </Footer>
</Dialog>

@code {
    private PermissionSettings? _pending;
    private int _version;

    /// <summary>
    /// Gets or sets the settings to show.
    /// </summary>
    [Parameter]
    public PermissionSettings Settings { get; set; } = PermissionSettings.Default;

    /// <summary>
    /// Gets or sets a value indicating whether the chat works in a folder the user opened, and not only in its own session files.
    /// </summary>
    [Parameter]
    public bool HasFolder { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback for the user choosing settings, after confirming any that switch off a safeguard.
    /// </summary>
    [Parameter]
    public EventCallback<PermissionSettings> OnChange { get; set; }

    private static bool IsRiskyLevel(AccessLevel level) => level == AccessLevel.Unrestricted;

    private bool TurnsOnAccess(PermissionSettings? chosen) => chosen is { } c && IsRiskyLevel(c.Access) && !IsRiskyLevel(Settings.Access);

    private bool TurnsOnApprovals(PermissionSettings? chosen) => chosen is { Approvals: ApprovalMode.NeverAsk } && Settings.Approvals != ApprovalMode.NeverAsk;

    private Task OnAccessChanged(ChangeEventArgs e)
    {
        return Enum.TryParse<AccessLevel>(e.Value as string, out var access) && Enum.IsDefined(access)
            ? Choose(Settings with { Access = access })
            : Task.CompletedTask;
    }

    private Task OnApprovalsChanged(ChangeEventArgs e)
    {
        return Enum.TryParse<ApprovalMode>(e.Value as string, out var approvals) && Enum.IsDefined(approvals)
            ? Choose(Settings with { Approvals = approvals })
            : Task.CompletedTask;
    }

    private async Task Choose(PermissionSettings chosen)
    {
        if (TurnsOnAccess(chosen) || TurnsOnApprovals(chosen))
        {
            _pending = chosen;
            return;
        }

        await OnChange.InvokeAsync(chosen);
    }

    private void Cancel()
    {
        _pending = null;
        _version++;
    }

    private async Task ConfirmAsync()
    {
        var chosen = _pending;
        _pending = null;
        if (chosen is { } settings)
        {
            await OnChange.InvokeAsync(settings);
        }
    }
}
