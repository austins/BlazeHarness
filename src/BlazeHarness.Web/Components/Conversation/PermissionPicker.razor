@using BlazeHarness.Core.Permissions
@using BlazeHarness.Core.Sandbox
@inject IShellSandbox Sandbox
@inject PermissionDefaults Defaults

<Menu Label="Permissions" Title="@TriggerTitle" Tone="@Tone">
    <Trigger><Icon Name="@(Settings.IsRisky || !Sandboxed ? "alert" : "shield")" /> <span class="menu-trigger-text">@AccessName(Settings.Access, brief: true) · @ApprovalsName(Settings.Approvals)</span></Trigger>
    <ChildContent>
        <div class="menu-heading">Access</div>
        <MenuItem Label="@AccessName(AccessLevel.ReadOnly)" Description="Read files; change nothing, run no commands" Checked="Settings.Access == AccessLevel.ReadOnly" OnSelect="() => Choose(Settings with { Access = AccessLevel.ReadOnly })" />
        <MenuItem Label="@AccessName(AccessLevel.WriteInFolder)" Description="@(HasFolder ? "Read and change files in this folder" : "Read and change this chat's own files")" Checked="Settings.Access == AccessLevel.WriteInFolder" OnSelect="() => Choose(Settings with { Access = AccessLevel.WriteInFolder })" />
        @if (Defaults.AllowBypass || Settings.Access == AccessLevel.Unrestricted)
        {
            <MenuItem Label="@AccessName(AccessLevel.Unrestricted)" Description="Anything your account can touch, no sandbox" Checked="Settings.Access == AccessLevel.Unrestricted" OnSelect="() => Choose(Settings with { Access = AccessLevel.Unrestricted })" />
        }
        <div class="menu-sep" role="separator"></div>
        <div class="menu-heading">Approvals</div>
        <MenuItem Label="@ApprovalsName(ApprovalMode.AskFirst)" Description="Ask before risky actions and anything outside the folder" Checked="Settings.Approvals == ApprovalMode.AskFirst" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.AskFirst })" />
        <MenuItem Label="@ApprovalsName(ApprovalMode.AutoApprove)" Description="Ask only for what the access level would block" Checked="Settings.Approvals == ApprovalMode.AutoApprove" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.AutoApprove })" />
        @if (Defaults.AllowBypass || Settings.Approvals == ApprovalMode.NeverAsk)
        {
            <MenuItem Label="@ApprovalsName(ApprovalMode.NeverAsk)" Description="Run everything allowed; refuse the rest" Checked="Settings.Approvals == ApprovalMode.NeverAsk" OnSelect="() => Choose(Settings with { Approvals = ApprovalMode.NeverAsk })" />
        }
        <div class="menu-sep" role="separator"></div>
        <p class="menu-note" data-tone="@Tone" title="@Sandbox.Status.Detail">
            @if (Settings.Access == AccessLevel.Unrestricted)
            {
                <Icon Name="alert" /> <span>Commands run without a sandbox</span>
            }
            else if (Sandbox.Status.IsAvailable)
            {
                <Icon Name="shield" /> <span>Commands run in a sandbox</span>
            }
            else
            {
                <Icon Name="alert" /> <span>No sandbox, so commands are blocked</span>
            }
        </p>
    </ChildContent>
</Menu>
<Dialog Title="Turn off a safeguard?" Open="_pending is not null" OnClose="Cancel">
    <ChildContent>
        @if (TurnsOnAccess(_pending))
        {
            <p>Unrestricted: tools and commands can read and change anything your user account can, with no sandbox.</p>
        }

        @if (TurnsOnApprovals(_pending))
        {
            <p>Never ask: tool calls run without asking you first. Text the model reads from files or web pages could trick it into running harmful commands.</p>
        }

        <p class="hint">This only applies to this chat. Protected folders such as your SSH keys stay blocked.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="Cancel">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmAsync">Turn on</button>
    </Footer>
</Dialog>

@code {
    private PermissionSettings? _pending;

    /// <summary>
    /// Gets or sets the settings to show.
    /// </summary>
    [Parameter]
    public PermissionSettings Settings { get; set; } = PermissionSettings.Default;

    /// <summary>
    /// Gets or sets a value indicating whether the chat works in a folder the user opened, and not only in its own session files.
    /// </summary>
    [Parameter]
    public bool HasFolder { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback for the user choosing settings, after confirming any that switch off a safeguard.
    /// </summary>
    [Parameter]
    public EventCallback<PermissionSettings> OnChange { get; set; }

    private bool Sandboxed => Settings.Access != AccessLevel.Unrestricted && Sandbox.Status.IsAvailable;

    private string Tone => (Settings.IsRisky, Sandboxed) switch
    {
        (true, _) => "danger",
        (false, true) => "success",
        _ => "warning",
    };

    private string TriggerTitle => (Settings.IsRisky, Sandboxed) switch
    {
        (true, _) => "Some safeguards are off for this chat",
        (false, true) => "What tools may touch, and when you are asked. Commands run in a sandbox.",
        _ => "What tools may touch, and when you are asked. There is no sandbox, so commands are blocked.",
    };

    private string AccessName(AccessLevel access, bool brief = false) => access switch
    {
        AccessLevel.ReadOnly => "Read only",
        AccessLevel.WriteInFolder when HasFolder => brief ? "Folder" : "Write in folder",
        AccessLevel.WriteInFolder => brief ? "Session files" : "Write in session files",
        _ => "Unrestricted",
    };

    private static string ApprovalsName(ApprovalMode approvals) => approvals switch
    {
        ApprovalMode.AskFirst => "Ask first",
        ApprovalMode.AutoApprove => "Auto-approve",
        _ => "Never ask",
    };

    private static bool IsRiskyLevel(AccessLevel level) => level == AccessLevel.Unrestricted;

    private bool TurnsOnAccess(PermissionSettings? chosen) => chosen is { } c && IsRiskyLevel(c.Access) && !IsRiskyLevel(Settings.Access);

    private bool TurnsOnApprovals(PermissionSettings? chosen) => chosen is { Approvals: ApprovalMode.NeverAsk } && Settings.Approvals != ApprovalMode.NeverAsk;

    private async Task Choose(PermissionSettings chosen)
    {
        if (chosen == Settings)
        {
            return;
        }

        if (TurnsOnAccess(chosen) || TurnsOnApprovals(chosen))
        {
            _pending = chosen;
            return;
        }

        await OnChange.InvokeAsync(chosen);
    }

    private void Cancel()
    {
        _pending = null;
    }

    private async Task ConfirmAsync()
    {
        var chosen = _pending;
        _pending = null;
        if (chosen is { } settings)
        {
            await OnChange.InvokeAsync(settings);
        }
    }
}
