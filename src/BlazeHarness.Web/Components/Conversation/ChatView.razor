@using BlazeHarness.Core.Agent.Questions
@using BlazeHarness.Core.Compaction
@using BlazeHarness.Core.Config
@using BlazeHarness.Core.Permissions
@implements IDisposable
@inject PermissionDefaults PermissionDefaults
@inject JsonFileStore<AppConfig> Config
@inject ChatService ChatService
@inject FolderRegistry Folders
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ILogger<ChatView> Logger
@using BlazeHarness.Core.Attachments
@using BlazeHarness.Core.Chats

@if (_missing)
{
    <section class="chat">
        <div class="chat-scroll">
            <div class="chat-thread">
                <Alert Kind="AlertKind.Warning">
                    <span>This chat no longer exists.</span>
                    <a href="">Start a new chat</a>
                </Alert>
            </div>
        </div>
    </section>
}
else
{
    <section class="chat" data-pinned="true" data-empty="@(!_loading && _entries.Count == 0 ? "true" : null)" @ref="_root" aria-label="Conversation">
        <div class="chat-context">
            @if (ContextPath is { } folderPath)
            {
                <span class="chat-context-where" title="@folderPath">
                    <Icon Name="folder" />
                    <span class="chat-context-name">@(Folders.Find(folderPath)?.Name ?? FolderPaths.DisplayName(folderPath))</span>
                    <span class="chat-context-path mono"><bdi>@folderPath</bdi></span>
                </span>
                @if (Project is { Files.Count: > 0 } project)
                {
                    <Popover Label="Project instructions" Title="Project instructions the model was given">
                        <Trigger><Icon Name="file" /> AGENTS.md <span class="badge">@project.Files.Count</span></Trigger>
                        <ChildContent>
                            <div class="panel-head"><span>Project instructions</span></div>
                            <ul class="panel-list">
                                @foreach (var file in project.Files)
                                {
                                    <li class="panel-option">
                                        <Icon Name="file" />
                                        <span class="panel-option-text">
                                            <span class="panel-option-name mono">@file.Path</span>
                                            @if (file.Truncated)
                                            {
                                                <span class="panel-option-hint panel-option-error">@(file.Content.Length == 0 ? "Too large, not included" : "Too large, cut off")</span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        </ChildContent>
                    </Popover>
                }
            }
            else
            {
                <span class="chat-context-where" title="Files this chat creates are kept with the chat">
                    <Icon Name="file" />
                    <span class="chat-context-name">Chat files</span>
                </span>
            }

            @if (_openId is { } mcpId)
            {
                <McpPicker ChatId="@mcpId" />
                <SkillPicker ChatId="@mcpId" />
                <ExportMenu ChatId="@mcpId" />
            }
            @if (_info is not null)
            {
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _moving = _info"><Icon Name="arrow-right" /> Move</button>
            }
            @if (_entries.Count > 0)
            {
                <button type="button" class="btn btn-ghost btn-sm" data-shortcut="find" title="Find in this chat (Ctrl+F)" @onclick="OpenFind"><Icon Name="search" /> Find</button>
            }
            @if (ContextPath is { } missingCheck && !Directory.Exists(missingCheck))
            {
                <span class="chat-context-warning" role="status"><Icon Name="alert" /> Folder not found</span>
            }
        </div>

        @if (_finding)
        {
            <FindBar @ref="_findBar" Entries="_entries" OnShow="ShowMatchAsync" OnClose="CloseFindAsync" />
        }

        <div class="sr-only" role="status" aria-live="polite">@_announcement</div>

        <div class="chat-scroll" @ref="_scroll" tabindex="-1">
            <div class="chat-thread" role="log" aria-live="off">
                @if (_entries.Count == 0)
                {
                    <div class="chat-empty">
                        <h1>What can I help with?</h1>
                        <p class="muted">Pick a model below and send a message. Press Enter to send and Shift+Enter for a new line.</p>
                    </div>
                }

                @if (_windowStart > 0)
                {
                    <button type="button" class="btn btn-sm chat-earlier" data-earlier="@_windowStart" @onclick="ShowEarlier">Show earlier messages (@_windowStart)</button>
                }

                @{
                    string? previousLabel = _windowStart > 0 ? _entries[_windowStart - 1].Label : null;
                }
                @foreach (var entry in _entries.Skip(_windowStart))
                {
                    if (entry.Compaction is { } compaction)
                    {
                        <CompactionMarker @key="entry.Id" Info="compaction" />
                        continue;
                    }

                    var showLabel = entry.Role == ChatRole.Assistant && entry.Label != previousLabel;
                    if (entry.Role == ChatRole.Assistant)
                    {
                        previousLabel = entry.Label;
                    }

                    <MessageView @key="entry.Id" Entry="entry" ChatId="@_openId" ShowLabel="showLabel" CanEdit="!(_chat?.IsRunning ?? true)" Editing="_editing?.Id == entry.Id" OnEdit="StartEdit" OnDecide="Decide" OnAnswer="Answer" />
                }
            </div>
        </div>

        <button type="button" class="btn btn-sm chat-jump" data-bh-action="toBottom">Jump to latest</button>

        @if (!_loading)
        {
            <TodoPanel @key="_openId" Todos="_chat?.Todos" />
            <Composer @ref="_composer" ChatId="@ChatId" Entries="_entries" FolderPath="@ContextPath" Remembered="_info" Running="_chat?.IsRunning ?? false" CanQueue="_chat?.IsReplying ?? false" Asked="_chat?.IsWaitingForUser ?? false" Queued="_chat?.Queued ?? []" OnQueue="Queue" CanRetry="_chat?.CanRetry ?? false" CanCompact="_chat?.CanCompact ?? false" ContextOf="_chat is null ? null : _chat.GetContextStatus" Editing="_editing" OnCancelEdit="CancelEdit" OnSend="SendAsync" OnRetry="RetryAsync" OnCompact="CompactAsync" OnStop="Stop">
                <PermissionPicker Settings="CurrentPermissions" HasFolder="ContextPath is not null" OnChange="ChangePermissionsAsync" />
            </Composer>
        }

        <MoveChatDialog Chat="_moving" OnClose="() => _moving = null" />
    </section>
}

@code {
    private const int InitialWindow = 60;
    private const int EarlierBatch = 40;

    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(50);

    private RenderThrottle _throttle = null!;
    private IReadOnlyList<ChatEntry> _entries = [];
    private Chat? _chat;
    private Composer? _composer;
    private ChatInfo? _info;
    private string? _openId;
    private bool _missing;
    private bool _loading;
    private bool _watching;
    private bool _disposed;
    private int _openVersion;
    private bool _wasRunning;
    private int _windowStart;
    private bool _finding;
    private bool _focusFind;
    private FindBar? _findBar;
    private (Guid EntryId, string Query)? _highlight;
    private string _announcement = string.Empty;
    private ElementReference _root;
    private ElementReference _scroll;

    /// <summary>
    /// Gets or sets the id of the chat to show, or null for a new chat that is created on the first message.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets the path of an opened folder for a new chat to work in; an open chat uses its own saved folder.
    /// </summary>
    [Parameter]
    public string? FolderPath { get; set; }

    private ChatInfo? _moving;
    private ChatEntry? _editing;
    private ProjectContext? _newProject;
    private string? _newProjectFolder;

    private PermissionSettings? _newPermissions;

    private PermissionSettings CurrentPermissions => _openId is null
        ? _newPermissions ?? PermissionDefaults.For(ContextPath is not null)
        : _chat?.Permissions.Settings ?? _info?.Permissions ?? PermissionSettings.Default;

    private ProjectContext? Project => _openId is null ? _newProject : _chat?.Project;

    private string? ContextPath => _openId is null ? Folders.Find(FolderPath)?.Path : _info?.FolderPath;

    protected override void OnInitialized()
    {
        _throttle = new RenderThrottle(() => InvokeAsync(Refresh), RenderInterval, Logger, Time);
        ChatService.Store.Changed += OnStoreChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ChatId is null)
        {
            var folder = Folders.Find(FolderPath)?.Path;
            if (folder != _newProjectFolder)
            {
                _newProjectFolder = folder;
                _newProject = await ChatService.LoadProjectAsync(folder);
            }
        }

        var requested = ChatId;
        if (requested == _openId)
        {
            return;
        }

        // Blazor can start another parameter update while OpenAsync is awaited, so a stale one must not attach.
        var version = ++_openVersion;
        Detach();
        _editing = null;
        _wasRunning = false;
        _announcement = string.Empty;
        _openId = requested;
        _missing = false;
        _info = null;
        _entries = [];
        _windowStart = 0;
        if (requested is null)
        {
            return;
        }

        _loading = true;
        Chat? chat;
        try
        {
            chat = await ChatService.OpenAsync(requested);
        }
        finally
        {
            if (version == _openVersion)
            {
                _loading = false;
            }
        }

        if (_disposed || version != _openVersion)
        {
            return;
        }

        if (chat is null)
        {
            _missing = true;
            _watching = false;
            return;
        }

        Attach(chat);
        _windowStart = Math.Max(0, _entries.Count - InitialWindow);
        _info = ChatService.Store.Find(requested);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A chat opened after its reply stopped has no Refresh coming, so the composer takes the queued text back here.
        ReturnQueued();
        if (_focusFind && _findBar is not null)
        {
            _focusFind = false;
            await _findBar.FocusAsync();
        }

        if (_highlight is { } shown)
        {
            _highlight = null;
            await JS.InvokeVoidAsync("bhChat.highlight", _scroll, shown.Query, shown.EntryId.ToString());
        }

        if (!_missing && !_watching)
        {
            _watching = true;
            await JS.InvokeVoidAsync("bhChat.watch", _root, _scroll);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ChatService.Store.Changed -= OnStoreChanged;
        Detach();
        _throttle.Dispose();
    }

    private void OnStoreChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_openId is not null && !_loading)
            {
                _info = ChatService.Store.Find(_openId);
                StateHasChanged();
            }
        });
    }

    private void Attach(Chat chat)
    {
        Detach();
        _chat = chat;
        _entries = chat.Entries;
        chat.Changed += OnChanged;
    }

    private void Detach()
    {
        if (_chat is not null)
        {
            _chat.Changed -= OnChanged;
            _chat = null;
        }
    }

    private void OpenFind()
    {
        _finding = true;
        _focusFind = true;
    }

    private async Task CloseFindAsync()
    {
        _finding = false;
        _highlight = null;
        await JS.InvokeVoidAsync("bhChat.clearHighlight");
        await JS.InvokeVoidAsync("bhUi.skipToChat");
    }

    private async Task ShowMatchAsync((Guid EntryId, string Query) match)
    {
        if (match.EntryId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("bhChat.clearHighlight");
            return;
        }

        var index = -1;
        for (var i = 0; i < _entries.Count && index < 0; i++)
        {
            if (_entries[i].Id == match.EntryId)
            {
                index = i;
            }
        }

        if (index >= 0)
        {
            _windowStart = Math.Min(_windowStart, index);
            _highlight = match;
        }
    }

    private void ShowEarlier()
    {
        _windowStart = Math.Max(0, _windowStart - EarlierBatch);
    }

    private void Refresh()
    {
        _entries = _chat?.Entries ?? [];
        _windowStart = Math.Min(_windowStart, Math.Max(0, _entries.Count - 1));
        Announce();
        if (_editing is not null && !_entries.Any(e => e.Id == _editing.Id))
        {
            _editing = null;
        }

        if (_openId is not null)
        {
            _info = ChatService.Store.Find(_openId);
        }

        ReturnQueued();
        StateHasChanged();
    }

    // Messages still queued once the reply has stopped or failed were never added, so they go back in the message box.
    private void ReturnQueued()
    {
        if (_composer is not null && _chat is { IsRunning: false, Queued.Count: > 0 } chat && chat.TakeQueued() is { Count: > 0 } returned)
        {
            _composer.Restore(string.Join("\n\n", returned));
        }
    }

    private bool Queue(string text) => _chat?.Queue(text) ?? false;

    private void Announce()
    {
        var running = _chat?.IsRunning ?? false;
        if (running == _wasRunning)
        {
            return;
        }

        _wasRunning = running;
        if (running)
        {
            _announcement = "Reply started";
        }
        else
        {
            _announcement = _entries.Count > 0 && _entries[^1].Status == EntryStatus.Failed ? "Reply failed" : "Reply finished";
        }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _throttle.Request();
    }

    private async Task<string?> SendAsync(ComposerMessage message)
    {
        if (message.Files.Sum(file => (long)file.Content.Length) > ChatAttachments.MaxMessageBytes)
        {
            return $"The files of a message can add up to at most {FileSize.Format(ChatAttachments.MaxMessageBytes)}.";
        }

        await FollowAsync();
        var id = _openId;
        ChatInfo? created = null;
        if (id is null)
        {
            var folder = Folders.Find(FolderPath)?.Path;
            created = await ChatService.CreateAsync(folder);
            if (folder is not null)
            {
                await Folders.TouchAsync(folder);
            }

            id = created.Id;
            if (_newPermissions is { } chosen)
            {
                await ChatService.SetPermissionsAsync(id, chosen);
            }
        }

        List<AttachmentInfo> files = [];
        string? failure = null;
        try
        {
            foreach (var file in message.Files)
            {
                await using var content = file.OpenRead();
                if (await ChatService.SaveAttachmentAsync(id, file.Name, content) is not { } saved)
                {
                    failure = "This chat no longer exists.";
                    break;
                }

                files.Add(saved);
            }
        }
        catch (AttachmentException ex)
        {
            failure = ex.Message;
        }

        if (failure is not null)
        {
            if (created is not null)
            {
                await ChatService.DeleteAsync(id);
            }

            return failure;
        }

        if (created is not null)
        {
            _newPermissions = null;
            var chat = await ChatService.OpenAsync(id);
            Attach(chat!);
            _openId = id;
            _info = created;
            Navigation.NavigateTo(Routes.Chat(id));
        }

        if (_editing is { } editing)
        {
            _editing = null;
            await ChatService.EditAsync(id, editing.Id, message.Text, message.Target);
        }
        else
        {
            await ChatService.SendAsync(id, message.Text, files, message.Target);
        }

        return null;
    }

    private void StartEdit(ChatEntry entry)
    {
        _editing = entry;
    }

    private void CancelEdit()
    {
        _editing = null;
    }

    private async Task RetryAsync(ChatTarget target)
    {
        if (_openId is { } id)
        {
            await FollowAsync();
            await ChatService.RetryAsync(id, target);
        }
    }

    private async Task CompactAsync(ChatTarget target)
    {
        if (_openId is not { } id)
        {
            return;
        }

        try
        {
            if (!await ChatService.CompactAsync(id, target))
            {
                Toasts.Show("There is not enough earlier conversation to summarize.", ToastKind.Info);
            }
        }
        catch (InvalidOperationException ex)
        {
            var hint = Config.Current.Compaction == CompactionMode.Model ? " You can turn on \"Compact without asking the model\" under Settings > Context." : string.Empty;
            Toasts.Show($"The conversation could not be summarized: {ex.Message}{hint}", ToastKind.Error);
        }
    }

    private async Task FollowAsync()
    {
        await JS.InvokeVoidAsync("bhChat.follow", _root);
    }

    private async Task ChangePermissionsAsync(PermissionSettings settings)
    {
        if (_openId is { } id)
        {
            await Toasts.TrySaveAsync(() => ChatService.SetPermissionsAsync(id, settings), "The permissions could not be saved because the chat's file could not be written.");
        }
        else
        {
            _newPermissions = settings;
        }
    }

    private void Decide((string CallId, ApprovalChoice Choice) answer)
    {
        _chat?.Approve(answer.CallId, answer.Choice);
    }

    private bool Answer((string CallId, UserAnswer Answer) reply)
    {
        return _chat?.Answer(reply.CallId, reply.Answer) ?? false;
    }

    private void Stop()
    {
        if (_openId is { } id)
        {
            ChatService.Stop(id);
        }
    }
}
