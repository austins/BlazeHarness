@implements IDisposable
@inject ProviderService Providers
@inject SessionService Sessions
@inject FolderRegistry Folders
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS

@if (_missing)
{
    <section class="chat">
        <div class="chat-scroll">
            <div class="chat-thread">
                <div class="alert alert-warning" role="alert">
                    <span>This chat no longer exists.</span>
                    <a href="">Start a new chat</a>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="chat" data-pinned="true" @ref="_root" aria-label="Conversation">
        @if (ContextPath is { } folderPath)
        {
            <div class="chat-context" title="@folderPath">
                <Icon Name="folder" />
                <span class="chat-context-name">@(Folders.Find(folderPath)?.Name ?? FolderPaths.DisplayName(folderPath))</span>
                <span class="chat-context-path mono">@folderPath</span>
                @if (_info is not null)
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _moving = _info"><Icon Name="arrow-right" /> Move</button>
                }

                @if (!Directory.Exists(folderPath))
                {
                    <span class="chat-context-warning" role="status"><Icon Name="alert" /> Folder not found</span>
                }
            </div>
        }

        <div class="chat-scroll" @ref="_scroll" tabindex="-1">
            <div class="chat-thread" role="log" aria-live="off">
                @if (_entries.Count == 0)
                {
                    <div class="chat-empty">
                        <h1>What can I help with?</h1>
                        <p class="muted">Pick a model below and send a message. Press Enter to send and Shift+Enter for a new line.</p>
                    </div>
                }

                @{
                    string? previousLabel = null;
                }
                @foreach (var entry in _entries)
                {
                    var showLabel = entry.Role == ChatRole.Assistant && entry.Label != previousLabel;
                    if (entry.Role == ChatRole.Assistant)
                    {
                        previousLabel = entry.Label;
                    }

                    <MessageView @key="entry.Id" Entry="entry" ShowLabel="showLabel" />
                }
            </div>
        </div>

        <button type="button" class="btn btn-sm chat-jump" onclick="bhChat.toBottom(this)">Jump to latest</button>

        @if (!_loading)
        {
            <Composer SessionId="@SessionId" Remembered="_info" Running="_session?.IsRunning ?? false" CanRetry="_session?.CanRetry ?? false" OnSend="SendAsync" OnRetry="RetryAsync" OnStop="Stop" />
        }

        <MoveChatDialog Chat="_moving" OnClose="() => _moving = null" />
    </section>
}

@code {
    private RenderThrottle _throttle = null!;
    private IReadOnlyList<ChatEntry> _entries = [];
    private ChatSession? _session;
    private SessionInfo? _info;
    private string? _openId;
    private bool _missing;
    private bool _loading;
    private bool _watching;
    private ElementReference _root;
    private ElementReference _scroll;

    /// <summary>
    /// Gets or sets the id of the chat to show, or null for a new chat that is created on the first message.
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    /// <summary>
    /// Gets or sets the path of an opened folder for a new chat to work in; an open chat uses its own saved folder.
    /// </summary>
    [Parameter]
    public string? FolderPath { get; set; }

    private SessionInfo? _moving;

    private string? ContextPath => _openId is null ? Folders.Find(FolderPath)?.Path : _info?.FolderPath;

    protected override void OnInitialized()
    {
        _throttle = new RenderThrottle(() => InvokeAsync(Refresh), TimeSpan.FromMilliseconds(50), Time);
        Sessions.Store.Changed += OnStoreChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId == _openId)
        {
            return;
        }

        Detach();
        _openId = SessionId;
        _missing = false;
        _info = null;
        _entries = [];
        if (SessionId is null)
        {
            return;
        }

        _loading = true;
        ChatSession? session;
        try
        {
            session = await Sessions.OpenAsync(SessionId);
        }
        finally
        {
            _loading = false;
        }

        if (session is null)
        {
            _missing = true;
            _watching = false;
            return;
        }

        Attach(session);
        _info = Sessions.Store.Find(SessionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_missing && !_watching)
        {
            _watching = true;
            await JS.InvokeVoidAsync("bhChat.watch", _root, _scroll);
        }
    }

    public void Dispose()
    {
        Sessions.Store.Changed -= OnStoreChanged;
        Detach();
        _throttle.Dispose();
    }

    private void OnStoreChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_openId is not null && !_loading)
            {
                _info = Sessions.Store.Find(_openId);
                StateHasChanged();
            }
        });
    }

    private void Attach(ChatSession session)
    {
        _session = session;
        _entries = session.Entries;
        session.Changed += OnChanged;
    }

    private void Detach()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
            _session = null;
        }
    }

    private void Refresh()
    {
        _entries = _session?.Entries ?? [];
        if (_openId is not null)
        {
            _info = Sessions.Store.Find(_openId);
        }

        StateHasChanged();
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _throttle.Request();
    }

    private async Task SendAsync((string Text, ChatTarget Target) message)
    {
        await FollowAsync();
        var id = _openId;
        if (id is null)
        {
            var folder = Folders.Find(FolderPath)?.Path;
            var created = await Sessions.CreateAsync(folder);
            if (folder is not null)
            {
                await Folders.TouchAsync(folder);
            }

            id = created.Id;
            var session = await Sessions.OpenAsync(id);
            Detach();
            Attach(session!);
            _openId = id;
            _info = created;
            Navigation.NavigateTo("chat/" + id);
        }

        await Sessions.SendAsync(id, message.Text, message.Target);
    }

    private async Task RetryAsync(ChatTarget target)
    {
        if (_openId is { } id)
        {
            await FollowAsync();
            await Sessions.RetryAsync(id, target);
        }
    }

    private async Task FollowAsync()
    {
        await JS.InvokeVoidAsync("bhChat.follow", _root);
    }

    private void Stop()
    {
        if (_openId is { } id)
        {
            Sessions.Stop(id);
        }
    }
}
