@using BlazeHarness.Core.Compaction
@using BlazeHarness.Core.Mcp
@using BlazeHarness.Core.Sessions
@implements IDisposable
@inject McpManager Manager
@inject SettingsDialogState SettingsState
@inject SessionService Sessions

@if (_servers.Count > 0)
{
    <details class="chat-context-files mcp-picker">
        <summary title="MCP servers whose tools this chat can use"><Icon Name="plug" /> MCP <span class="badge">@_servers.Count(IsOn) / @_servers.Count</span></summary>
        <ul>
            @foreach (var status in _servers)
            {
                var server = status.Config;
                <li>
                    <label class="check">
                        <input type="checkbox" checked="@IsOn(status)" @onchange="e => SetAsync(server.Name, (bool)e.Value!)" />
                        <span>@server.Name</span>
                    </label>
                    @if (status.State is McpServerState.Failed)
                    {
                        <span class="hint" title="@status.Error">Failed to connect</span>
                    }
                    else if (status.State is McpServerState.Connected)
                    {
                        <span class="hint">@(status.Tools.Count == 1 ? "1 tool" : $"{status.Tools.Count} tools"), about @TokenEstimate.OfCharacters(status.PromptCharacters) tokens</span>
                    }
                </li>
            }
        </ul>
        <p class="hint">A change applies from the next reply. It also changes the tool list, so the model reads the whole prompt again. <button type="button" class="link-button" @onclick="() => SettingsState.Open(SettingsSection.Mcp)">Manage servers</button></p>
    </details>
}

@code {
    private IReadOnlyList<McpServerStatus> _servers = [];

    /// <summary>
    /// Gets or sets the id of the chat whose servers are shown.
    /// </summary>
    [Parameter, EditorRequired]
    public string SessionId { get; set; } = string.Empty;

    public void Dispose()
    {
        Manager.Changed -= OnManagerChanged;
    }

    protected override void OnInitialized()
    {
        Manager.Changed += OnManagerChanged;
    }

    protected override void OnParametersSet()
    {
        _servers = Manager.Statuses();
    }

    private bool IsOn(McpServerStatus status) => Sessions.IsMcpServerEnabled(SessionId, status.Config);

    private async Task SetAsync(string name, bool enabled)
    {
        await Sessions.SetMcpServerAsync(SessionId, name, enabled);
    }

    private void OnManagerChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _servers = Manager.Statuses();
            StateHasChanged();
        });
    }
}
