@using BlazeHarness.Core.Mcp
@implements IDisposable
@inject McpManager Manager
@inject SettingsDialogState SettingsState
@inject SessionService Sessions

@if (_servers.Count > 0)
{
    <Popover Label="MCP servers" Title="MCP servers whose tools this chat can use">
        <Trigger><Icon Name="plug" /> MCP <span class="badge">@_servers.Count(IsOn) / @_servers.Count</span></Trigger>
        <ChildContent>
            <ul class="panel-list">
                @foreach (var status in _servers)
                {
                    var server = status.Config;
                    <li>
                        <label class="panel-check">
                            <input type="checkbox" checked="@IsOn(status)" @onchange="e => SetAsync(server.Name, (bool)e.Value!)" />
                            <span class="panel-check-name">@server.Name</span>
                            @if (status.State is McpServerState.Failed)
                            {
                                <span class="panel-check-error" title="@status.Error">Failed</span>
                            }
                        </label>
                    </li>
                }
            </ul>
            <p class="panel-note">
                <Icon Name="info" /> <span>Applies to this chat only, from the next reply</span>
                <button type="button" class="link-button" @onclick="() => SettingsState.Open(SettingsSection.Mcp)">Manage</button>
            </p>
        </ChildContent>
    </Popover>
}

@code {
    private IReadOnlyList<McpServerStatus> _servers = [];

    /// <summary>
    /// Gets or sets the id of the chat whose servers are shown.
    /// </summary>
    [Parameter, EditorRequired]
    public string SessionId { get; set; } = string.Empty;

    public void Dispose()
    {
        Manager.Changed -= OnManagerChanged;
    }

    protected override void OnInitialized()
    {
        Manager.Changed += OnManagerChanged;
    }

    protected override void OnParametersSet()
    {
        _servers = Manager.Statuses();
    }

    private bool IsOn(McpServerStatus status) => Sessions.IsMcpServerEnabled(SessionId, status.Config);

    private async Task SetAsync(string name, bool enabled)
    {
        await Sessions.SetMcpServerAsync(SessionId, name, enabled);
    }

    private void OnManagerChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _servers = Manager.Statuses();
            StateHasChanged();
        });
    }
}
