@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Mcp
@implements IDisposable
@inject McpManager Manager
@inject SettingsDialogState SettingsState
@inject ChatService ChatService

@if (_servers.Count > 0)
{
    <Popover Label="@WebStrings.McpPickerLabel" Title="@WebStrings.McpPickerTitle">
        <Trigger><Icon Name="plug" /> MCP <span class="badge">@_servers.Count(IsOn) / @_servers.Count</span></Trigger>
        <ChildContent>
            <ul class="panel-list">
                @foreach (var status in _servers)
                {
                    var server = status.Config;
                    <li>
                        <label class="panel-check">
                            <input type="checkbox" checked="@IsOn(status)" @onchange="e => SetAsync(server.Name, (bool)e.Value!)" />
                            <span class="panel-check-name">@server.Name</span>
                            @if (status.State is McpServerState.Failed)
                            {
                                <span class="panel-check-error" title="@status.Error">@WebStrings.McpPickerFailed</span>
                            }
                        </label>
                    </li>
                }
            </ul>
            <p class="panel-note">
                <Icon Name="info" /> <span>@WebStrings.McpPickerScopeNote</span>
                <button type="button" class="link-button" @onclick="() => SettingsState.Open(SettingsSection.Mcp)">@WebStrings.McpPickerManage</button>
            </p>
        </ChildContent>
    </Popover>
}

@code {
    private IReadOnlyList<McpServerStatus> _servers = [];

    /// <summary>
    /// Gets or sets the chat id, or null before the first message.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets the server choices before the chat is created.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, bool>? Choices { get; set; }

    /// <summary>
    /// Gets or sets the callback for choosing a server before the chat is created.
    /// </summary>
    [Parameter]
    public EventCallback<(string Name, bool Enabled)> OnChoose { get; set; }

    public void Dispose()
    {
        Manager.Changed -= OnManagerChanged;
    }

    protected override void OnInitialized()
    {
        Manager.Changed += OnManagerChanged;
    }

    protected override void OnParametersSet()
    {
        _servers = Manager.Statuses();
    }

    private bool IsOn(McpServerStatus status) => ChatId is { } id
        ? ChatService.IsMcpServerEnabled(id, status.Config)
        : McpManager.IsEnabled(status.Config, Choices);

    private async Task SetAsync(string name, bool enabled)
    {
        if (ChatId is { } id)
        {
            await ChatService.SetMcpServerAsync(id, name, enabled);
        }
        else
        {
            await OnChoose.InvokeAsync((name, enabled));
        }
    }

    private void OnManagerChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _servers = Manager.Statuses();
            StateHasChanged();
        });
    }
}
