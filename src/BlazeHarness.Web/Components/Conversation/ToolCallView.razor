@using System.Globalization
@using System.Text.Json
@using BlazeHarness.Core.Agent
@using BlazeHarness.Core.Agent.Questions
@using BlazeHarness.Core.Diff
@using BlazeHarness.Core.Mcp
@using BlazeHarness.Core.Mcp.Tools
@using BlazeHarness.Core.Permissions
@using BlazeHarness.Core.Tools
@using BlazeHarness.Core.Tools.Files
@using BlazeHarness.Core.Tools.Web
@using BlazeHarness.Web.Hosting

@if (Call.Question is not null)
{
    <QuestionCard Call="Call" OnAnswer="OnAnswer" />
    return;
}

<div class="tool" data-status="@StatusKey" role="group" aria-label="@Label">
    <button type="button" class="tool-head" aria-expanded="@(Open ? "true" : "false")" aria-controls="@_bodyId" @onclick="Toggle">
        <Icon Name="@(Open ? "chevron-down" : "chevron-right")" />
        <Icon Name="wrench" />
        @if (McpToolNames.TrySplit(Call.Name, out var server, out var remote))
        {
            <span class="tool-name mono">@remote</span>
            <span class="badge" title="@McpBadgeTitle(server)">@server</span>
        }
        else
        {
            <span class="tool-name mono">@Call.Name</span>
        }
        @if (Call.Summary.Length > 0)
        {
            <span class="tool-summary mono">@Call.Summary</span>
        }

        <span class="tool-status">
            @switch (Call.Status)
            {
                case ToolCallStatus.Succeeded:
                    <Icon Name="check" />
                    break;
                case ToolCallStatus.Failed:
                    <Icon Name="alert" />
                    break;
                case ToolCallStatus.Denied:
                case ToolCallStatus.Cancelled:
                    <Icon Name="ban" />
                    break;
                case ToolCallStatus.Running:
                    <Icon Name="spinner" Spin="true" />
                    break;
                default:
                    break;
            }

            @StatusText
        </span>
    </button>

    @if (Call.Status == ToolCallStatus.AwaitingApproval)
    {
        <div class="tool-approval" role="alert">
            <span>@(Call.ApprovalReason.Length > 0 ? Call.ApprovalReason : WebStrings.ToolCallAllowPrompt)</span>
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => OnDecide.InvokeAsync((Call.CallId, ApprovalChoice.AllowOnce))"><Icon Name="check" /> @WebStrings.ToolCallViewAllowOnce</button>
            @if (Call.CanRemember)
            {
                <button type="button" class="btn btn-sm" @onclick="() => OnDecide.InvokeAsync((Call.CallId, ApprovalChoice.AllowForChat))"><Icon Name="check" /> @WebStrings.ToolCallViewAllowForChat</button>
            }

            <button type="button" class="btn btn-sm" @onclick="() => OnDecide.InvokeAsync((Call.CallId, ApprovalChoice.Deny))"><Icon Name="ban" /> @WebStrings.ToolCallViewDeny</button>
        </div>
    }

    @foreach (var pending in Call.PendingHosts)
    {
        <div class="tool-approval" role="alert">
            <span>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ToolCallHostPrompt), new Dictionary<string, object?> { ["host"] = pending.Host })</span>
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => OnDecideHost.InvokeAsync(new HostAnswer(Call.CallId, pending.Host, ApprovalChoice.AllowOnce))"><Icon Name="check" /> @WebStrings.ToolCallViewAllowOnce</button>
            @if (pending.CanRemember)
            {
                <button type="button" class="btn btn-sm" @onclick="() => OnDecideHost.InvokeAsync(new HostAnswer(Call.CallId, pending.Host, ApprovalChoice.AllowForChat))"><Icon Name="check" /> @WebStrings.ToolCallViewAllowForChat</button>
                <button type="button" class="btn btn-sm" @onclick="() => OnDecideHost.InvokeAsync(new HostAnswer(Call.CallId, pending.Host, ApprovalChoice.AllowOnce, Always: true))"><Icon Name="check" /> @WebStrings.ToolCallViewAlwaysAllowHost</button>
            }

            <button type="button" class="btn btn-sm" @onclick="() => OnDecideHost.InvokeAsync(new HostAnswer(Call.CallId, pending.Host, ApprovalChoice.Deny))"><Icon Name="ban" /> @WebStrings.ToolCallViewDeny</button>
        </div>
    }

    @if (_imageAddress is { } address)
    {
        <a class="tool-image" href="@address" target="_blank" rel="noopener"><img class="msg-image" src="@address" alt="@Call.Summary" loading="lazy" /></a>
    }

    @if (Open)
    {
        <div class="tool-body" id="@_bodyId">
            @{
                ShowDetails();
            }

            @if (_diff is not null)
            {
                <DiffView Lines="_diff" />
            }

            @if (_todos is not null)
            {
                <TodoChecklist Items="_todos.Items" />
            }

            @foreach (var (name, value) in _arguments)
            {
                <div class="tool-arg">
                    <span class="tool-arg-name">@name</span>
                    <pre class="tool-pre">@value</pre>
                </div>
            }

            @if (Call.Output.Length > 0 && !(_todos is not null && Call.Status == ToolCallStatus.Succeeded))
            {
                <div class="tool-arg">
                    <span class="tool-arg-name">@WebStrings.ToolCallViewOutputLabel</span>
                    <pre class="tool-pre">@(_showAll ? Call.Output : TextShortener.Shorten(Call.Output, OutputPreviewLength))</pre>
                    @if (!_showAll && Call.Output.Length > OutputPreviewLength)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _showAll = true">@ShowAllLabel</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private const int OutputPreviewLength = 4000;
    private const int ArgumentPreviewLength = 2000;

    private readonly string _bodyId = "tool-" + Guid.NewGuid().ToString("N");
    private bool _expanded;
    private bool _showAll;
    private ToolCallEntry? _parsedFor;
    private (string? ChatId, ToolCallStatus Status)? _imageFor;
    private string? _imageAddress;
    private bool _detailsReady;
    private IReadOnlyList<DiffLine>? _diff;
    private TodoList? _todos;
    private List<(string Name, string Value)> _arguments = [];

    private string ShowAllLabel =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ToolCallShowAllCharacters),
            new Dictionary<string, object?>
            {
                ["count"] = Call.Output.Length,
                ["formattedCount"] = Call.Output.Length.ToString("N0", CultureInfo.CurrentCulture),
            });

    /// <summary>
    /// Gets or sets the call to show.
    /// </summary>
    [Parameter, EditorRequired]
    public ToolCallEntry Call { get; set; } = default!;

    /// <summary>
    /// Gets or sets the id of the chat the call belongs to, which images the call shows are served from.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user answering the approval prompt, with the call id and whether it may run.
    /// </summary>
    [Parameter]
    public EventCallback<(string CallId, ApprovalChoice Choice)> OnDecide { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user answering the question about a host a running command wants to connect to.
    /// </summary>
    [Parameter]
    public EventCallback<HostAnswer> OnDecideHost { get; set; }

    /// <summary>
    /// Gets or sets the function for the user answering an <c>ask_user</c> question, with the call id and the answer, which returns whether the answer was taken.
    /// </summary>
    [Parameter]
    public Func<(string CallId, UserAnswer Answer), bool>? OnAnswer { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Call, _parsedFor))
        {
            _parsedFor = Call;
            _detailsReady = false;
            _imageFor = null;
        }

        if (_imageFor != (ChatId, Call.Status))
        {
            _imageFor = (ChatId, Call.Status);
            _imageAddress = FindImageAddress();
        }
    }

    private string? FindImageAddress()
    {
        if (ChatId is null || Call.Status != ToolCallStatus.Succeeded)
        {
            return null;
        }

        var pathArgument = Call.Name switch
        {
            ShowImageTool.ToolName => ShowImageTool.PathArgument,
            BrowserScreenshotTool.ToolName => BrowserScreenshotTool.PathArgument,
            _ => null,
        };
        if (pathArgument is null)
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(Call.ArgumentsJson);
            return document.RootElement.TryGetProperty(pathArgument, out var path) && path.ValueKind == JsonValueKind.String
                ? AttachmentEndpoints.FileAddressOf(ChatId, path.GetString()!)
                : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private bool Open => _expanded || Call.Status == ToolCallStatus.AwaitingApproval;

    private string StatusKey => Call.Status.ToString().ToLowerInvariant();

    private string StatusText => Call.Status switch
    {
        ToolCallStatus.Pending => WebStrings.ToolCallQueued,
        ToolCallStatus.AwaitingApproval => WebStrings.ToolCallNeedsApproval,
        ToolCallStatus.Running => WebStrings.ToolCallRunning,
        ToolCallStatus.Succeeded => WebStrings.ToolCallDone,
        ToolCallStatus.Failed => WebStrings.ToolCallFailed,
        ToolCallStatus.Denied => WebStrings.ToolCallDenied,
        ToolCallStatus.Cancelled => WebStrings.ToolCallStopped,
        ToolCallStatus.Interrupted => WebStrings.ToolCallInterrupted,
        _ => string.Empty,
    };

    private string Label => $"{Call.Name}: {StatusText}";

    private static string McpBadgeTitle(string server) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ToolCallMcpBadgeTitle),
            new Dictionary<string, object?> { ["server"] = server });

    private void Toggle()
    {
        _expanded = !Open;
    }

    // The arguments of a call never change, so they are parsed once, and only when the call is opened.
    private void ShowDetails()
    {
        if (_detailsReady)
        {
            return;
        }

        _detailsReady = true;
        _diff = Call.Name == EditFileTool.ToolName ? EditDiff() : null;
        _todos = Call.Name == TodoList.ToolName ? TodoList.TryParse(Call.ArgumentsJson) : null;
        _arguments = _todos is null ? Arguments(_diff is not null) : [];
    }

    private IReadOnlyList<DiffLine>? EditDiff()
    {
        try
        {
            using var document = JsonDocument.Parse(Call.ArgumentsJson);
            var root = document.RootElement;
            return root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty(EditFileTool.OldStringArgument, out var oldText) && oldText.ValueKind == JsonValueKind.String
                && root.TryGetProperty(EditFileTool.NewStringArgument, out var newText) && newText.ValueKind == JsonValueKind.String
                    ? LineDiff.Compare(oldText.GetString()!, newText.GetString()!)
                    : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private List<(string Name, string Value)> Arguments(bool hideEditText)
    {
        var list = new List<(string, string)>();
        try
        {
            using var document = JsonDocument.Parse(Call.ArgumentsJson);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return list;
            }

            foreach (var property in document.RootElement.EnumerateObject())
            {
                if (hideEditText && property.Name is EditFileTool.OldStringArgument or EditFileTool.NewStringArgument)
                {
                    continue;
                }

                var value = property.Value.ValueKind == JsonValueKind.String ? property.Value.GetString() ?? string.Empty : property.Value.GetRawText();
                list.Add((property.Name, TextShortener.Shorten(value, ArgumentPreviewLength)));
            }
        }
        catch (JsonException)
        {
            list.Add(("arguments", TextShortener.Shorten(Call.ArgumentsJson, ArgumentPreviewLength)));
        }

        return list;
    }
}
