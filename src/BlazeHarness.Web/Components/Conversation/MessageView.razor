@using BlazeHarness.Core.Chats.Events
@using System.Globalization
@using BlazeHarness.Core.Agent.Events
@using BlazeHarness.Core.Agent.Questions
@using BlazeHarness.Core.Attachments
@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Permissions
@using BlazeHarness.Web.Hosting
@inject MarkdownRenderer Markdown
@inject IJSRuntime JS
@inject ToastService Toasts

<article class="msg" data-entry="@Entry.Id" data-role="@(Entry.Role == ChatRole.User ? "user" : "assistant")" data-status="@Entry.Status.ToString().ToLowerInvariant()" data-editing="@(Editing ? "true" : null)">
    <div class="msg-content">
        @if (ShowLabel && !string.IsNullOrEmpty(Entry.Label))
        {
            <div class="msg-label">@Entry.Label</div>
        }

        @if (Entry.Origin == UserMessageOrigin.Steer)
        {
            <div class="msg-label">@WebStrings.MessageViewQueuedLabel</div>
        }

        @if (Entry.Origin == UserMessageOrigin.FromChat && Entry.Source is { } source)
        {
            <div class="msg-label">@ResourceMessageFormatter.Web.Format(nameof(WebStrings.MessageViewFromChatLabel), new Dictionary<string, object?> { ["title"] = source.Title })</div>
        }

        @if (Entry.Reasoning.Length > 0)
        {
            <details class="msg-thinking" open="@(Entry.Status == EntryStatus.Streaming && Entry.Text.Length == 0)">
                <summary>@WebStrings.MessageViewThinkingSummary</summary>
                <div class="msg-body">@Entry.Reasoning</div>
            </details>
        }

        @if (Entry.Attachments.Count > 0)
        {
            <div class="msg-files">
                @foreach (var file in Entry.Attachments.Select(a => a.File))
                {
                    var address = AttachmentEndpoints.AddressOf(ChatId ?? string.Empty, file.Id);
                    @if (file.IsImage)
                    {
                        <a href="@address" target="_blank" rel="noopener"><img class="msg-image" src="@address" alt="@file.Name" loading="lazy" /></a>
                    }
                    else
                    {
                        <a class="chip" href="@address" target="_blank" rel="noopener" title="@file.Name"><Icon Name="file" /><span class="chip-name">@file.Name</span><span class="chip-size">@FileSize.Format(file.Size)</span></a>
                    }
                }
            </div>
        }

        @if (Entry.Text.Length > 0)
        {
            @if (Entry.Role == ChatRole.Assistant)
            {
                <div class="msg-body md">@((MarkupString)_settledHtml)@((MarkupString)_tailHtml)</div>
            }
            else
            {
                <div class="msg-body">@Entry.Text</div>
            }
        }
        else if (Entry.Status == EntryStatus.Streaming && Entry.Reasoning.Length == 0)
        {
            <div class="msg-wait" role="status">@WebStrings.MessageViewWaiting</div>
        }
        else if (Entry.Role == ChatRole.Assistant && Entry is { Status: EntryStatus.Done, ToolCalls.Count: 0, Error: null })
        {
            <div class="hint">@WebStrings.MessageViewEmptyReplyHint</div>
        }

        @foreach (var call in Entry.ToolCalls)
        {
            <ToolCallView @key="call.CallId" Call="call" ChatId="@ChatId" OnDecide="OnDecide" OnDecideHost="OnDecideHost" OnAnswer="OnAnswer" />
        }

        @if (Entry.Status == EntryStatus.Cancelled)
        {
            <div class="hint">@WebStrings.MessageViewStoppedHint</div>
        }

        @if (Entry.Status == EntryStatus.Interrupted)
        {
            <div class="hint">@WebStrings.MessageViewInterruptedHint</div>
        }

        @if (Entry.Warnings.HasFlag(ReplyWarnings.ResponseTruncated))
        {
            <Alert Kind="AlertKind.Warning">@WebStrings.MessageViewTruncatedWarning</Alert>
        }

        @if (Entry.Warnings.HasFlag(ReplyWarnings.ContextTooLarge))
        {
            <Alert Kind="AlertKind.Warning">@WebStrings.MessageViewContextTooLargeWarning</Alert>
        }
        else if (Entry.Warnings.HasFlag(ReplyWarnings.CompactionFailed))
        {
            <Alert Kind="AlertKind.Warning">@WebStrings.MessageViewCompactionFailedWarning</Alert>
        }

        @if (Entry.Error is not null)
        {
            <Alert>@Entry.Error</Alert>
        }
    </div>

    <footer class="msg-meta">
        <time class="msg-time" datetime="@Entry.At.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)"></time>
        @if (Entry.Usage is { } usage)
        {
            <Popover Label="@WebStrings.MessageViewUsageLabel" Title="@UsageDetails(usage)" ShowChevron="false">
                <Trigger>
                    <span class="sr-only">@WebStrings.MessageViewUsageLabel </span>
                    @if (usage.DecodeTokensPerSecond is { } rate)
                    {
                        <span class="mono">@TokenFormat.Rate(rate)</span>
                    }
                    else
                    {
                        <Icon Name="gauge" />
                    }
                </Trigger>
                <ChildContent>
                    <div class="panel-head">@WebStrings.MessageViewUsageLabel</div>
                    <div class="msg-usage-details">@UsageDetails(usage)</div>
                </ChildContent>
            </Popover>
        }

        @if (Entry.Text.Length > 0 && Entry.Status != EntryStatus.Streaming)
        {
            <button type="button" class="btn btn-ghost btn-sm btn-icon msg-action" aria-label="@WebStrings.MessageViewCopyLabel" title="@WebStrings.MessageViewCopyTooltip" @onclick="CopyAsync"><Icon Name="copy" /></button>
        }

        @if (CanEdit && Entry.Role == ChatRole.User)
        {
            <button type="button" class="btn btn-ghost btn-sm btn-icon msg-action" aria-label="@WebStrings.MessageViewEditLabel" title="@WebStrings.MessageViewEditTooltip" @onclick="() => OnEdit.InvokeAsync(Entry)"><Icon Name="pencil" /></button>
        }
    </footer>
</article>

@code {
    private static string UsageDetails(UsageReported usage)
    {
        var lines = new List<string>
        {
            ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.MessageViewUsagePrompt),
                new Dictionary<string, object?>
                {
                    ["promptCount"] = usage.PromptTokens,
                    ["prompt"] = usage.PromptTokens.ToString("N0", CultureInfo.CurrentCulture),
                    ["cachedCount"] = usage.CachedTokens,
                    ["cached"] = usage.CachedTokens.ToString("N0", CultureInfo.CurrentCulture),
                }),
            ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.MessageViewUsageOutput),
                new Dictionary<string, object?>
                {
                    ["count"] = usage.CompletionTokens,
                    ["output"] = usage.CompletionTokens.ToString("N0", CultureInfo.CurrentCulture),
                }),
        };
        if (usage.ReasoningTokens > 0)
        {
            lines.Add(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.MessageViewUsageReasoning),
                new Dictionary<string, object?>
                {
                    ["count"] = usage.ReasoningTokens,
                    ["reasoning"] = usage.ReasoningTokens.ToString("N0", CultureInfo.CurrentCulture),
                }));
        }

        if (usage.TimeToFirstToken is { } wait)
        {
            lines.Add(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.MessageViewUsageFirstOutput),
                new Dictionary<string, object?> { ["duration"] = TokenFormat.Duration(wait) }));
            if (usage.PrefillTokensPerSecond is { } prefill)
            {
                lines.Add(ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.MessageViewUsagePrefillRate),
                    new Dictionary<string, object?> { ["rate"] = TokenFormat.Rate(prefill) }));
            }
        }

        if (usage.GenerationTime is { } generation)
        {
            lines.Add(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.MessageViewUsageStreamed),
                new Dictionary<string, object?> { ["duration"] = TokenFormat.Duration(generation) }));
            if (usage.DecodeTokensPerSecond is { } decode)
            {
                lines.Add(ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.MessageViewUsageDecodeRate),
                    new Dictionary<string, object?> { ["rate"] = TokenFormat.Rate(decode) }));
            }
        }

        return string.Join('\n', lines);
    }

    /// <summary>
    /// Gets or sets the message to show.
    /// </summary>
    [Parameter, EditorRequired]
    public ChatEntry Entry { get; set; } = default!;

    /// <summary>
    /// Gets or sets the id of the chat the message belongs to, which its attached files are served from.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether to show which model wrote the message.
    /// </summary>
    [Parameter]
    public bool ShowLabel { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a user message offers editing, which is only while no reply is running.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether this message is the one being edited in the composer.
    /// </summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user choosing to edit this message.
    /// </summary>
    [Parameter]
    public EventCallback<ChatEntry> OnEdit { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user allowing or denying a tool call, with the call id and the answer.
    /// </summary>
    [Parameter]
    public EventCallback<(string CallId, ApprovalChoice Choice)> OnDecide { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user answering the question about a host a running command wants to connect to.
    /// </summary>
    [Parameter]
    public EventCallback<HostAnswer> OnDecideHost { get; set; }

    /// <summary>
    /// Gets or sets the function for the user answering a question the model asked, with the call id and the answer, which returns whether the answer was taken.
    /// </summary>
    [Parameter]
    public Func<(string CallId, UserAnswer Answer), bool>? OnAnswer { get; set; }

    private StreamingMarkdown? _streaming;
    private string? _htmlText;
    private bool _htmlStreaming;
    private string _settledHtml = string.Empty;
    private string _tailHtml = string.Empty;

    /// <inheritdoc />
    /// <remarks>Every token re-renders every message, so the HTML is only rebuilt when the text it came from is a new string.</remarks>
    protected override void OnParametersSet()
    {
        if (Entry.Role != ChatRole.Assistant)
        {
            return;
        }

        var text = Entry.Text;
        var streaming = Entry.Status == EntryStatus.Streaming;
        if (ReferenceEquals(text, _htmlText) && streaming == _htmlStreaming)
        {
            return;
        }

        _htmlText = text;
        _htmlStreaming = streaming;
        if (streaming)
        {
            _streaming ??= new StreamingMarkdown(Markdown, ChatId);
            _streaming.Render(text);
            _settledHtml = _streaming.Settled;
            _tailHtml = _streaming.Tail;
        }
        else
        {
            _settledHtml = Markdown.ToCachedHtml(text, ChatId);
            _tailHtml = string.Empty;
        }
    }

    private async Task CopyAsync()
    {
        var copied = await JS.InvokeAsync<bool>("bhChat.copyText", Entry.Text);
        Toasts.Show(copied ? WebStrings.MessageViewCopied : WebStrings.MessageViewCopyFailed, copied ? ToastKind.Success : ToastKind.Error);
    }
}
