@using System.Globalization
@using BlazeHarness.Core.Attachments
@using BlazeHarness.Web.Hosting
@inject MarkdownRenderer Markdown

<article class="msg" data-role="@(Entry.Role == ChatRole.User ? "user" : "assistant")" data-status="@Entry.Status.ToString().ToLowerInvariant()" data-editing="@(Editing ? "true" : null)">
    @if (ShowLabel && !string.IsNullOrEmpty(Entry.Label))
    {
        <div class="msg-label">@Entry.Label</div>
    }

    @if (Entry.Reasoning.Length > 0)
    {
        <details class="msg-thinking" open="@(Entry.Status == EntryStatus.Streaming && Entry.Text.Length == 0)">
            <summary>Thinking</summary>
            <div class="msg-body">@Entry.Reasoning</div>
        </details>
    }

    @if (Entry.Attachments.Count > 0)
    {
        <div class="msg-files">
            @foreach (var file in Entry.Attachments.Select(a => a.File))
            {
                var address = AttachmentEndpoints.AddressOf(SessionId ?? string.Empty, file.Id);
                @if (file.IsImage)
                {
                    <a href="@address" target="_blank" rel="noopener"><img class="msg-image" src="@address" alt="@file.Name" loading="lazy" /></a>
                }
                else
                {
                    <a class="chip" href="@address" target="_blank" rel="noopener" title="@file.Name"><Icon Name="file" /><span class="chip-name">@file.Name</span><span class="chip-size">@FileSize.Format(file.Size)</span></a>
                }
            }
        </div>
    }

    @if (Entry.Text.Length > 0)
    {
        @if (Entry.Role == ChatRole.Assistant)
        {
            <div class="msg-body md">@((MarkupString)AssistantHtml())</div>
        }
        else
        {
            <div class="msg-body">@Entry.Text</div>
        }
    }
    else if (Entry.Status == EntryStatus.Streaming && Entry.Reasoning.Length == 0)
    {
        <div class="msg-wait" role="status">Waiting for the model…</div>
    }

    @foreach (var call in Entry.ToolCalls)
    {
        <ToolCallView @key="call.CallId" Call="call" SessionId="@SessionId" OnDecide="OnDecide" />
    }

    @if (Entry.Status == EntryStatus.Cancelled)
    {
        <div class="hint">Stopped.</div>
    }

    @if (Entry.Status == EntryStatus.Interrupted)
    {
        <div class="hint">This reply was cut off when the app stopped. Retry to generate it again.</div>
    }

    @if (Entry.Error is not null)
    {
        <div class="alert alert-error" role="alert">@Entry.Error</div>
    }

    <footer class="msg-meta">
        @if (CanEdit && Entry.Role == ChatRole.User)
        {
            <button type="button" class="btn btn-ghost btn-sm btn-icon msg-edit" aria-label="Edit and resend this message" title="Edit and resend" @onclick="() => OnEdit.InvokeAsync(Entry)"><Icon Name="pencil" /></button>
        }

        <time class="msg-time" datetime="@Entry.At.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)"></time>
        @if (Entry.Usage is { } usage)
        {
            <span class="mono">@usage.PromptTokens in · @usage.CompletionTokens out</span>
        }
    </footer>
</article>

@code {
    /// <summary>
    /// Gets or sets the message to show.
    /// </summary>
    [Parameter, EditorRequired]
    public ChatEntry Entry { get; set; } = default!;

    /// <summary>
    /// Gets or sets the id of the chat the message belongs to, which its attached files are served from.
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether to show which model wrote the message.
    /// </summary>
    [Parameter]
    public bool ShowLabel { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a user message offers editing, which is only while no reply is running.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether this message is the one being edited in the composer.
    /// </summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user choosing to edit this message.
    /// </summary>
    [Parameter]
    public EventCallback<ChatEntry> OnEdit { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user allowing or denying a tool call, with the call id and the answer.
    /// </summary>
    [Parameter]
    public EventCallback<(string CallId, bool Allow)> OnDecide { get; set; }

    private StreamingMarkdown? _streaming;

    private string AssistantHtml()
    {
        if (Entry.Status != EntryStatus.Streaming)
        {
            return Markdown.ToCachedHtml(Entry.Text, SessionId);
        }

        _streaming ??= new StreamingMarkdown(Markdown, SessionId);
        return _streaming.Render(Entry.Text);
    }
}
