@using BlazeHarness.Core.Web
@using BlazeHarness.Core.Web.Browser
@implements IDisposable
@inject WebServices Web

@if (_src is not null && _frame is { } frame && frame.Url.AbsoluteUri != _dismissedUrl)
{
    <aside class="browser-panel" aria-label="@WebStrings.BrowserPanelLabel">
        <div class="browser-bar">
            <Icon Name="globe" />
            <span class="browser-url" title="@frame.Url">@frame.Url</span>
            <button type="button" class="btn btn-icon" aria-label="@WebStrings.BrowserPanelClose" title="@WebStrings.BrowserPanelClose" @onclick="Dismiss"><Icon Name="close" /></button>
        </div>
        <div class="browser-view">
            <img src="@_src" alt="@(frame.Title.Length > 0 ? frame.Title : WebStrings.BrowserPanelImageAlt)" />
        </div>
        @if (frame.Title.Length > 0)
        {
            <div class="browser-title">@frame.Title</div>
        }
    </aside>
}

@code {
    private BrowserFrame? _frame;
    private string? _src;
    private string? _shownChatId;
    private string? _dismissedUrl;

    /// <summary>
    /// Gets or sets the id of the open chat, or null while a new chat has none yet.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <inheritdoc />
    public void Dispose() => Web.BrowserFrameChanged -= OnFrameChanged;

    /// <inheritdoc />
    protected override void OnInitialized() => Web.BrowserFrameChanged += OnFrameChanged;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ChatId == _shownChatId)
        {
            return;
        }

        _shownChatId = ChatId;
        _dismissedUrl = null;
        Show(ChatId is null ? null : Web.LatestBrowserFrame(ChatId));
    }

    private void Show(BrowserFrame? frame)
    {
        _frame = frame;
        _src = frame is null ? null : "data:image/jpeg;base64," + Convert.ToBase64String(frame.Jpeg.Span);
    }

    private void Dismiss() => _dismissedUrl = _frame?.Url.AbsoluteUri;

    private void OnFrameChanged(object? sender, BrowserFrameChangedEventArgs e)
    {
        if (e.ChatId != _shownChatId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (e.ChatId != _shownChatId)
            {
                return;
            }

            // A closed page clears the choice; so does the agent moving to another address, which the user will want to see.
            if (e.Frame is null || e.Frame.Url.AbsoluteUri != _dismissedUrl)
            {
                _dismissedUrl = null;
                Show(e.Frame);
            }

            StateHasChanged();
        });
    }
}
