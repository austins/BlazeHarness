@using BlazeHarness.Core.Compaction

@if (Info.OutputTrimmed)
{
    <div class="compaction compaction-trim">@FormatMarker(nameof(WebStrings.CompactionMarkerTrimmed))</div>
}
else
{
    <details class="compaction">
        <summary>@FormatMarker(nameof(WebStrings.CompactionMarkerSummarized))</summary>
        <div class="compaction-body">@Info.Summary</div>
    </details>
}

@code {
    /// <summary>
    /// Gets or sets what the marker stands for: the summary that stands in for the messages above it, or a trim of their large tool output.
    /// </summary>
    [Parameter, EditorRequired]
    public CompactionInfo Info { get; set; } = null!;

    private string FormatMarker(string key) =>
        ResourceMessageFormatter.Web.Format(
            key,
            new Dictionary<string, object?>
            {
                ["before"] = TokenFormat.Of(Info.TokensBefore),
                ["after"] = TokenFormat.Of(Info.TokensAfter),
                ["count"] = Info.TokensAfter,
            });
}
