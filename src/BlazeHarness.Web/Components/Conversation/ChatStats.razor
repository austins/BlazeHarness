@using System.Globalization
@using BlazeHarness.Core.Agent.Events

@if (_totals is { Responses: > 0 } totals)
{
    <dl class="chat-stats" aria-label="@WebStrings.ChatStatsAriaLabel">
        <div title="@WebStrings.ChatStatsInTooltip">
            <dt><Icon Name="arrow-down" />@WebStrings.ChatStatsInLabel</dt>
            <dd>@TokenFormat.Of(totals.PromptTokens)</dd>
        </div>
        @if (totals.CacheHitRate is { } hit && totals.CachedTokens > 0)
        {
            <div title="@CachedPromptTokens(totals.CachedTokens)">
                <dt><Icon Name="database" />@WebStrings.ChatStatsCachedLabel</dt>
                <dd>@hit.ToString("P0", CultureInfo.CurrentCulture)</dd>
            </div>
        }

        <div title="@OutputTooltip(totals)">
            <dt><Icon Name="arrow-up" />@WebStrings.ChatStatsOutLabel</dt>
            <dd>@TokenFormat.Of(totals.CompletionTokens)</dd>
        </div>
        @if (totals.DecodeTokensPerSecond is { } decode)
        {
            <div title="@WebStrings.ChatStatsDecodeTooltip">
                <dt><Icon Name="gauge" />@WebStrings.ChatStatsDecodeLabel</dt>
                <dd>@TokenFormat.Rate(decode)</dd>
            </div>
        }

        @if (totals.PrefillTokensPerSecond is { } prefill)
        {
            <div title="@WebStrings.ChatStatsPrefillTooltip">
                <dt><Icon Name="bolt" />@WebStrings.ChatStatsPrefillLabel</dt>
                <dd>@TokenFormat.Rate(prefill)</dd>
            </div>
        }

        @if (totals.TimeToFirstToken is { } wait)
        {
            <div title="@WebStrings.ChatStatsFirstTokenTooltip">
                <dt><Icon Name="timer" />@WebStrings.ChatStatsFirstTokenLabel</dt>
                <dd>@TokenFormat.Duration(wait)</dd>
            </div>
        }

        @if (totals.GenerationTime > TimeSpan.Zero)
        {
            <div title="@WebStrings.ChatStatsStreamingTooltip">
                <dt><Icon Name="clock" />@WebStrings.ChatStatsStreamingLabel</dt>
                <dd>@TokenFormat.Duration(totals.GenerationTime)</dd>
            </div>
        }

        <div title="@WebStrings.ChatStatsResponsesTooltip">
            <dt><Icon Name="chat" />@WebStrings.ChatStatsResponsesLabel</dt>
            <dd>@totals.Responses</dd>
        </div>
    </dl>
}

@code {
    private UsageTotals? _totals;

    /// <summary>
    /// Gets or sets the entries of the chat.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ChatEntry> Entries { get; set; } = [];

    protected override void OnParametersSet()
    {
        _totals = UsageTotals.Of(Entries.Select(e => e.Usage).OfType<UsageReported>());
    }

    private static string CachedPromptTokens(long count) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ChatStatsCachedPromptTokens),
            new Dictionary<string, object?>
            {
                ["count"] = count,
                ["formattedCount"] = count.ToString("N0", CultureInfo.CurrentCulture),
            });

    private static string OutputTooltip(UsageTotals totals) => totals.ReasoningTokens > 0
        ? ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ChatStatsOutputWithReasoning),
            new Dictionary<string, object?>
            {
                ["count"] = totals.CompletionTokens,
                ["formattedCount"] = totals.CompletionTokens.ToString("N0", CultureInfo.CurrentCulture),
                ["reasoning"] = totals.ReasoningTokens,
                ["formattedReasoning"] = totals.ReasoningTokens.ToString("N0", CultureInfo.CurrentCulture),
            })
        : ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ChatStatsOutputTokens),
            new Dictionary<string, object?>
            {
                ["count"] = totals.CompletionTokens,
                ["formattedCount"] = totals.CompletionTokens.ToString("N0", CultureInfo.CurrentCulture),
            });
}
