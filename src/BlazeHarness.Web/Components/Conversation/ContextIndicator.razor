@using BlazeHarness.Core.Compaction

<button type="button" class="menu-trigger context-trigger" popovertarget="@_id" aria-haspopup="dialog" style="anchor-name: --@_id">
    <span class="context" data-level="@_level">
        @if (_share is { } share)
        {
            <svg class="context-ring" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <circle class="context-ring-track" cx="10" cy="10" r="@RingRadius" />
                <circle class="context-ring-fill" cx="10" cy="10" r="@RingRadius" stroke-dasharray="@Dash(share)" />
            </svg>
        }
        <span class="context-text">@_text</span><span class="sr-only"> @WebStrings.ContextIndicatorTokensUnit</span>
    </span>
</button>
<div id="@_id" class="menu context-panel" popover="auto" role="dialog" aria-label="@WebStrings.ContextIndicatorDialogLabel" style="position-anchor: --@_id">
    <div class="menu-heading">@WebStrings.ContextIndicatorHeading</div>
    @foreach (var line in _details)
    {
        <p class="context-detail">@line</p>
    }
    @if (Entries.Count > 0)
    {
        <div class="menu-sep"></div>
        <ChatStats Entries="Entries" />
    }
    @if (CanCompact)
    {
        <div class="menu-sep"></div>
        <button type="button" class="menu-item" popovertarget="@_id" popovertargetaction="hide" @onclick="OnCompact">
            <Icon Name="compress" />
            <span class="menu-item-text">
                <span class="menu-item-label">@WebStrings.ContextIndicatorCompactNow</span>
                <span class="menu-item-description">@WebStrings.ContextIndicatorCompactDescription</span>
            </span>
        </button>
    }
</div>

@code {
    private const double HighShare = 0.8;
    private const double RingRadius = 8;
    private static readonly double Circumference = 2 * Math.PI * RingRadius;

    private string _level = "ok";
    private string _text = string.Empty;
    private readonly string _id = $"context-{Guid.NewGuid():N}";
    private IReadOnlyList<string> _details = [];
    private double? _share;
    private ContextStatus? _shown;

    /// <summary>
    /// Gets or sets how full the context is.
    /// </summary>
    [Parameter, EditorRequired]
    public ContextStatus Status { get; set; } = null!;

    /// <summary>
    /// Gets or sets the entries of the chat, whose usage the panel totals.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ChatEntry> Entries { get; set; } = [];

    /// <summary>
    /// Gets or sets a value indicating whether the panel offers to compact the chat.
    /// </summary>
    [Parameter]
    public bool CanCompact { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user choosing to compact.
    /// </summary>
    [Parameter]
    public EventCallback OnCompact { get; set; }

    protected override void OnParametersSet()
    {
        if (Status == _shown)
        {
            return;
        }

        _shown = Status;
        _level = LevelOf(Status);
        _text = TextOf(Status);
        _details = DetailsOf(Status);
        _share = Status.Window > 0 ? Math.Clamp((double)Status.Tokens / Status.Window, 0, 1) : null;
    }

    private static string Dash(double share) => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{share * Circumference:0.##} {Circumference:0.##}");

    private static string LevelOf(ContextStatus status)
    {
        if (status.Limit <= 0)
        {
            return "ok";
        }

        if (status.Tokens >= status.Limit)
        {
            return "full";
        }

        return status.Tokens >= status.Limit * HighShare ? "high" : "ok";
    }

    private static string TextOf(ContextStatus status)
    {
        var tokens = (status.Approximate ? "~" : string.Empty) + TokenFormat.Of(status.Tokens);
        return status.Window > 0 ? $"{tokens} / {TokenFormat.Of(status.Window)}" : tokens;
    }

    private static List<string> DetailsOf(ContextStatus status)
    {
        var lines = new List<string>
        {
            status.Approximate ? WebStrings.ContextIndicatorEstimatedSize : WebStrings.ContextIndicatorServerCountedSize,
        };
        if (status.Limit > 0)
        {
            lines.Add(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.ContextIndicatorSummarizeAfter),
                new Dictionary<string, object?>
                {
                    ["count"] = status.Limit,
                    ["tokens"] = TokenFormat.Of(status.Limit),
                }));
        }

        if (status.CacheHitRate is { } rate)
        {
            lines.Add(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.ContextIndicatorCacheHits),
                new Dictionary<string, object?> { ["rate"] = rate.ToString("P0", System.Globalization.CultureInfo.CurrentCulture) }));
        }

        return lines;
    }
}
