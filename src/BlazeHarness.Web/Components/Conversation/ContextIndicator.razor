@using BlazeHarness.Core.Compaction

<span class="context" data-level="@Level" title="@Details" role="status">
    <span class="context-text">@Text</span>
</span>

@code {
    private string Level
    {
        get
        {
            if (Status.Limit <= 0)
            {
                return "ok";
            }

            if (Status.Tokens >= Status.Limit)
            {
                return "full";
            }

            return Status.Tokens >= Status.Limit * 0.8 ? "high" : "ok";
        }
    }

    private string Text
    {
        get
        {
            var tokens = (Status.Approximate ? "~" : string.Empty) + TokenFormat.Of(Status.Tokens);
            return Status.Window > 0 ? $"{tokens} of {TokenFormat.Of(Status.Window)} tokens" : $"{tokens} tokens";
        }
    }

    private string Details
    {
        get
        {
            var lines = new List<string>();
            lines.Add(Status.Approximate ? "The size of the next request, estimated" : "The size of the next request, as the server counted it");
            if (Status.Limit > 0)
            {
                lines.Add($"Older messages are summarized after {TokenFormat.Of(Status.Limit)} tokens");
            }

            if (Status.CacheHitRate is { } rate)
            {
                lines.Add($"Cache hits: {rate.ToString("P0", System.Globalization.CultureInfo.CurrentCulture)} of the last request");
            }

            return string.Join('\n', lines);
        }
    }

    /// <summary>
    /// Gets or sets how full the context is.
    /// </summary>
    [Parameter, EditorRequired]
    public ContextStatus Status { get; set; } = null!;
}
