@inject ProviderService Providers
@inject IJSRuntime JS

@if (_models.Count == 0)
{
    <div class="composer composer-empty">
        <p class="muted">Add a model to a provider to start chatting.</p>
        <a class="btn btn-primary btn-sm" href="settings/providers">Open providers</a>
    </div>
}
else
{
    <div class="composer">
    <form class="composer-form" @onsubmit="SubmitAsync" novalidate>
        <textarea class="input composer-input" rows="1" @ref="_input" @bind="_text" @bind:event="oninput"
                  placeholder="Message the model" aria-label="Message"></textarea>
        <div class="composer-bar">
            <select class="select" aria-label="Model" value="@_selected" @onchange="OnModelChanged">
                @foreach (var group in _models.GroupBy(m => m.Provider.Id))
                {
                    <optgroup label="@group.First().Provider.DisplayName">
                        @foreach (var item in group)
                        {
                            <option value="@item.Key">@item.Model.Name</option>
                        }
                    </optgroup>
                }
            </select>
            @if (_levels.Count > 0)
            {
                <select class="select" aria-label="Thinking" value="@_level" @onchange="OnLevelChanged">
                    <option value="">Thinking: default</option>
                    @foreach (var level in _levels)
                    {
                        <option value="@level">@level</option>
                    }
                </select>
            }
            <span class="composer-spacer"></span>
            @if (CanRetry)
            {
                <button type="button" class="btn" @onclick="RetryAsync">Retry</button>
            }
            @if (Running)
            {
                <button type="button" class="btn btn-danger" @onclick="OnStop">Stop</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary">Send</button>
            }
        </div>
        @if (_note is not null)
        {
            <div class="hint" role="status">@_note</div>
        }
        @if (_overrideError is not null)
        {
            <div class="alert alert-error" role="alert">@_overrideError</div>
        }
    </form>
    <details class="composer-advanced">
        <summary>
            Advanced
            @if (_override.Count > 0)
            {
                <span class="badge badge-accent">@_override.Count</span>
            }
        </summary>
        <div class="details-body stack">
            <p class="hint">These values apply to every message in this session until reset, and win over the model's and the thinking level's values. Custom fields are set on the model.</p>
            <div class="params">
                @foreach (var range in SamplingRange.All)
                {
                    var key = range.Key;
                    <ParamRow Range="range" Value="_override.Get(key)" ValueChanged="v => SetOverride(key, v)" Inherited="_inherited?.Get(key)" />
                }
            </div>
            <div>
                <button type="button" class="btn btn-sm" @onclick="ResetOverride" disabled="@(_override.Count == 0)">Reset all</button>
            </div>
        </div>
    </details>
    </div>
}

@code {
    private sealed record Choice(string Key, ProviderConfig Provider, ModelConfig Model);

    private List<Choice> _models = [];
    private List<ThinkingLevel> _levels = [];
    private ElementReference _input;
    private string _text = string.Empty;
    private string _selected = string.Empty;
    private string _level = string.Empty;
    private string? _note;
    private string? _overrideError;
    private SamplingEditModel _override = new();
    private SamplingEditModel? _inherited;
    private bool _resize;

    /// <summary>
    /// Gets or sets a value indicating whether a reply is being produced.
    /// </summary>
    [Parameter]
    public bool Running { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the last reply can be retried.
    /// </summary>
    [Parameter]
    public bool CanRetry { get; set; }

    /// <summary>
    /// Gets or sets the callback for a message to send with its chosen target.
    /// </summary>
    [Parameter]
    public EventCallback<(string Text, ChatTarget Target)> OnSend { get; set; }

    /// <summary>
    /// Gets or sets the callback to retry the last reply with the chosen target.
    /// </summary>
    [Parameter]
    public EventCallback<ChatTarget> OnRetry { get; set; }

    /// <summary>
    /// Gets or sets the callback to stop the running reply.
    /// </summary>
    [Parameter]
    public EventCallback OnStop { get; set; }

    protected override void OnInitialized()
    {
        LoadModels();
        var config = Providers.Config;
        var preferred = _models.Find(m => m.Provider.Id == config.DefaultProviderId && m.Model.Id == config.DefaultModelId);
        _selected = (preferred ?? _models.FirstOrDefault())?.Key ?? string.Empty;
        LoadLevels();
        LoadInherited();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_models.Count == 0)
        {
            return;
        }

        if (firstRender)
        {
            await JS.InvokeVoidAsync("bhChat.initComposer", _input);
        }

        if (_resize)
        {
            _resize = false;
            await JS.InvokeVoidAsync("bhChat.resize", _input);
        }
    }

    private static string KeyOf(ProviderConfig provider, ModelConfig model)
    {
        return $"{provider.Id}|{model.Id}";
    }

    private void LoadModels()
    {
        _models = [.. Providers.Config.Providers.SelectMany(p => p.Models.Select(m => new Choice(KeyOf(p, m), p, m)))];
    }

    private void LoadLevels()
    {
        var levels = _models.Find(m => m.Key == _selected)?.Model.Levels;
        _levels = levels is null ? [] : [.. levels.Keys.Order()];
    }

    private void LoadInherited()
    {
        var target = CurrentTarget();
        _inherited = target is null
            ? null
            : SamplingEditModel.FromConfig(ResolvedRequestParams.Resolve(target.Provider, target.Model, target.Level, null).Sampling);
    }

    private void SetOverride(string key, double? value)
    {
        _override.Set(key, value);
        _overrideError = null;
    }

    private void ResetOverride()
    {
        _override = new SamplingEditModel();
        _overrideError = null;
    }

    private string? ValidateOverride()
    {
        var invalid = SamplingRange.All.FirstOrDefault(r => _override.Get(r.Key) is { } v && (double.IsNaN(v) || v < r.Min || v > r.Max));
        return invalid is null ? null : $"{invalid.Label} is outside its allowed range, so the message was not sent.";
    }

    private void OnModelChanged(ChangeEventArgs e)
    {
        _selected = e.Value?.ToString() ?? string.Empty;
        LoadLevels();
        _note = null;
        if (_level.Length > 0 && !_levels.Any(l => l.ToString() == _level))
        {
            _note = $"{_level} is not available for this model, so the default will be used.";
            _level = string.Empty;
        }

        LoadInherited();
    }

    private void OnLevelChanged(ChangeEventArgs e)
    {
        _level = e.Value?.ToString() ?? string.Empty;
        _note = null;
        LoadInherited();
    }

    private ChatTarget? CurrentTarget()
    {
        var choice = _models.Find(m => m.Key == _selected);
        if (choice is null)
        {
            return null;
        }

        ThinkingLevel? level = Enum.TryParse<ThinkingLevel>(_level, out var parsed) ? parsed : null;
        return new ChatTarget(choice.Provider, choice.Model, level) { SessionOverride = _override.ToConfig() };
    }

    private async Task SubmitAsync()
    {
        var target = CurrentTarget();
        if (target is null || Running || string.IsNullOrWhiteSpace(_text))
        {
            return;
        }

        _overrideError = ValidateOverride();
        if (_overrideError is not null)
        {
            return;
        }

        var text = _text;
        _text = string.Empty;
        _resize = true;
        await OnSend.InvokeAsync((text, target));
    }

    private async Task RetryAsync()
    {
        _overrideError = ValidateOverride();
        if (_overrideError is null && CurrentTarget() is { } target)
        {
            await OnRetry.InvokeAsync(target);
        }
    }
}
