@implements IDisposable
@inject ProviderService Providers
@inject IJSRuntime JS
@inject SkillCatalog Catalog
@inject ChatService ChatService
@inject SettingsDialogState SettingsState
@using System.Text
@using BlazeHarness.Core.Attachments
@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Compaction
@using BlazeHarness.Core.Skills

@if (_models.Count == 0)
{
    <div class="composer composer-empty">
        <p class="muted">@WebStrings.ComposerNoModelsHint</p>
        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SettingsState.Open(SettingsSection.Providers)">@WebStrings.ComposerOpenProviders</button>
    </div>
}
else
{
    <div class="composer">
    <form class="composer-form" @onsubmit="SubmitAsync" novalidate @ref="_form">
        @if (Suggestions() is { Count: > 0 } suggestions)
        {
            <ul class="composer-suggestions" role="listbox" aria-label="@WebStrings.ComposerSkillsLabel">
                @foreach (var skill in suggestions)
                {
                    <li role="none">
                        <button type="button" id="skill-suggestion-@skill.Name" class="btn btn-ghost btn-sm" role="option" aria-selected="false" tabindex="-1" @onclick="() => ChooseSkillAsync(skill)">
                            <strong>/@skill.Name</strong> <span class="muted">@ShortDescription(skill)</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @if (Queued.Count > 0)
        {
            <ul class="composer-queued" aria-label="@WebStrings.ComposerQueuedMessagesLabel">
                @for (var i = 0; i < Queued.Count; i++)
                {
                    var index = i;
                    var queued = Queued[i];
                    <li class="chip">
                        <span class="badge badge-accent">@(queued.Mode == QueueMode.Steer ? WebStrings.ComposerSteerBadge : WebStrings.ComposerQueuedBadge)</span>
                        <span class="chip-name" title="@queued.Text">@queued.Text</span>
                        <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="@WebStrings.ComposerRemoveQueued" @onclick="() => OnRemoveQueued?.Invoke(index, queued.Text)"><Icon Name="close" /></button>
                    </li>
                }
            </ul>
        }
        <div class="composer-box">
        @if (Editing is not null)
        {
            <div class="composer-editing" role="status">
                <span>@WebStrings.ComposerEditingHint</span>
                <button type="button" class="btn btn-sm" @onclick="CancelEditAsync"><Icon Name="close" />@WebStrings.ComposerCancelEdit</button>
            </div>
        }
        @if (_files.Count > 0)
        {
            var deliveries = Deliveries();
            <ul class="composer-files" aria-label="@WebStrings.ComposerAttachedFilesLabel">
                @foreach (var (file, delivery) in _files.Zip(deliveries))
                {
                    <li @key="file.Id" class="chip">
                        <Icon Name="@(file.IsImage ? "image" : "file")" />
                        <span class="chip-name" title="@file.Name">@file.Name</span>
                        <span class="chip-size">@FileSize.Format(file.Content.Length)</span>
                        <span class="chip-hint">@HintFor(delivery)</span>
                        @if (file.IsPasted)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" aria-expanded="@(_previewing == file.Id ? "true" : "false")" @onclick="() => TogglePreview(file)">@WebStrings.ComposerPreviewFile</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => InsertAsText(file)">@WebStrings.ComposerInsertAsText</button>
                        }
                        <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="@FileRemoveLabel(file.Name)" @onclick="() => Remove(file)"><Icon Name="close" /></button>
                    </li>
                }
            </ul>
            @if (_files.Find(f => f.Id == _previewing) is { } previewed)
            {
                <pre class="composer-preview" aria-label="@PreviewStartLabel(previewed.Name)">@Preview(previewed)</pre>
            }
        }
        <textarea class="composer-input" rows="1" @ref="_input" @bind="_text" @bind:event="oninput"
                  placeholder="@Placeholder" aria-label="@WebStrings.ComposerMessageLabel"></textarea>
        <div class="composer-bar">
            @if (Editing is null)
            {
                <InputFile @ref="_picker" OnChange="AddFilesAsync" multiple tabindex="-1" class="visually-hidden" aria-hidden="true" />
                <button type="button" class="btn btn-ghost btn-icon" aria-label="@WebStrings.ComposerAttachFilesLabel" title="@WebStrings.ComposerAttachFilesTooltip" data-bh-action="pick"><Icon Name="paperclip" /></button>
            }
            <Menu Label="@WebStrings.ComposerModelMenuLabel" Title="@WebStrings.ComposerModelMenuTooltip">
                <Trigger><Icon Name="sparkle" /> <span class="menu-trigger-text">@(SelectedChoice?.Model.Name ?? WebStrings.ComposerChooseModel)</span></Trigger>
                <ChildContent>
                    @{ var grouped = _models.GroupBy(m => m.Provider.Id).ToList(); }
                    @foreach (var group in grouped)
                    {
                        @if (grouped.Count > 1)
                        {
                            <div class="menu-heading">@group.First().Provider.DisplayName</div>
                        }
                        @foreach (var item in group)
                        {
                            <MenuItem Label="@item.Model.Name" Checked="item.Key == _selected" OnSelect="() => SelectModel(item.Key)" />
                        }
                    }
                </ChildContent>
            </Menu>
            @if (_levels.Count > 0)
            {
                <Menu Label="@WebStrings.ComposerThinkingMenuLabel" Title="@WebStrings.ComposerThinkingTooltip">
                    <Trigger><Icon Name="bulb" /> <span class="menu-trigger-text">@_level</span></Trigger>
                    <ChildContent>
                        <div class="menu-heading">@WebStrings.ComposerThinkingHeading</div>
                        @foreach (var level in _levels)
                        {
                            var name = level.ToString();
                            <MenuItem Label="@name" Checked="name == _level" OnSelect="() => SelectLevel(name)" />
                        }
                    </ChildContent>
                </Menu>
            }
            @ChildContent
            <span class="composer-spacer"></span>
            @if (_context is not null)
            {
                <ContextIndicator Status="_context" Entries="Entries" CanCompact="CanCompact && !Running && Editing is null" OnCompact="CompactAsync" />
            }
            @if (CanRetry && Editing is null)
            {
                <button type="button" class="btn btn-ghost btn-icon" aria-label="@WebStrings.ComposerRetryLabel" title="@WebStrings.ComposerRetryTooltip" @onclick="RetryAsync"><Icon Name="retry" /></button>
            }
            @if (Running)
            {
                <span class="composer-send">
                    @if (CanQueue && !string.IsNullOrWhiteSpace(_text))
                    {
                        @if (Asked)
                        {
                            <button type="submit" class="btn btn-primary btn-send" aria-label="@WebStrings.ComposerSendAnswer" title="@WebStrings.ComposerSendAnswerEnter"><Icon Name="arrow-up" /></button>
                        }
                        else
                        {
                            <span class="send-split" data-bh-queue>
                                <button type="submit" class="btn btn-primary btn-send" aria-label="@WebStrings.ComposerQueueMessage" title="@WebStrings.ComposerQueueMessageEnter"><Icon Name="arrow-up" /></button>
                                <Menu Label="@WebStrings.ComposerQueueModeMenuLabel" Title="@WebStrings.ComposerQueueModeTooltip" IconOnly="true">
                                    <Trigger><Icon Name="chevron-up" /></Trigger>
                                    <ChildContent>
                                        <MenuItem Label="@WebStrings.ComposerQueueModeAfterReply" Title="@WebStrings.ComposerQueueModeAfterReplyDescription" IsAction="true" OnSelect="() => Enqueue(QueueMode.AfterReply)" />
                                    </ChildContent>
                                </Menu>
                            </span>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-send btn-stop" aria-label="@WebStrings.ComposerStopLabel" title="@WebStrings.ComposerStopTooltip" @onclick="OnStop"><Icon Name="stop" /></button>
                    }
                </span>
            }
            else
            {
                <button type="submit" class="btn btn-primary btn-send" aria-label="@WebStrings.ComposerSendLabel" title="@WebStrings.ComposerSendTooltip"><Icon Name="arrow-up" /></button>
            }
        </div>
        </div>
        @if (!ModelSeesImages && _files.Any(f => f.IsImage))
        {
            <div class="hint" role="status">@WebStrings.ComposerImagesUnsupportedHint</div>
        }
        @if (_note is not null)
        {
            <div class="hint" role="status">@_note</div>
        }
        else if (SwitchesModel)
        {
            <div class="hint" role="status">@WebStrings.ComposerModelSwitchCacheHint</div>
        }
    </form>
    </div>
}

@code {
    private sealed record Choice(string Key, ProviderConfig Provider, ModelConfig Model);

    private List<Choice> _models = [];
    private List<ThinkingLevel> _levels = [];
    private ElementReference _input;
    private string _text = string.Empty;
    private string _selected = string.Empty;
    private string _level = string.Empty;
    private const int PreviewBytes = 2000;
    private const int SuggestionDescriptionLength = 90;
    private const int MaxSuggestions = 8;

    private readonly List<PendingFile> _files = [];
    private Guid? _previewing;
    private ElementReference _form;
    private InputFile? _picker;
    private string? _note;
    private ContextStatus? _context;
    private string? _suggestedFor;
    private List<SkillInfo>? _suggestions;
    private bool _resize;
    private bool _applied;
    private bool _wired;
    private bool _creating;
    private string? _appliedFor;
    private Guid? _loadedEdit;

    /// <summary>
    /// Gets or sets the id of the open chat, or null for a new one.
    /// </summary>
    [Parameter]
    public string? ChatId { get; set; }

    /// <summary>
    /// Gets or sets the folder a new chat will work in, or null when it has none. It tells which skills to suggest.
    /// </summary>
    [Parameter]
    public string? FolderPath { get; set; }

    /// <summary>
    /// Gets or sets the saved details of the open chat, whose model and thinking level are restored.
    /// </summary>
    [Parameter]
    public ChatInfo? Remembered { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a reply is being produced.
    /// </summary>
    [Parameter]
    public bool Running { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a message typed now is queued for the running reply, which is true while a reply is produced but not while the chat is compacted.
    /// </summary>
    [Parameter]
    public bool CanQueue { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the model waits for the answer to a question, which a message typed now gives.
    /// </summary>
    [Parameter]
    public bool Asked { get; set; }

    /// <summary>
    /// Gets or sets the messages that wait to be added to the running reply.
    /// </summary>
    [Parameter]
    public IReadOnlyList<QueuedMessage> Queued { get; set; } = [];

    /// <summary>
    /// Gets or sets the function that queues a text for the running reply, given when it is added, and returns whether it was accepted.
    /// </summary>
    [Parameter]
    public Func<string, QueueMode, bool>? OnQueue { get; set; }

    /// <summary>
    /// Gets or sets the action that removes a waiting message, given its position in <see cref="Queued"/> and its text.
    /// </summary>
    [Parameter]
    public Action<int, string>? OnRemoveQueued { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the last reply can be retried.
    /// </summary>
    [Parameter]
    public bool CanRetry { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the conversation can be compacted now.
    /// </summary>
    [Parameter]
    public bool CanCompact { get; set; }

    /// <summary>
    /// Gets or sets the entries of the chat, whose usage the context panel totals.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ChatEntry> Entries { get; set; } = [];

    /// <summary>
    /// Gets or sets the function that tells how full the context is for the chosen model, or null when there is no chat yet.
    /// </summary>
    [Parameter]
    public Func<ChatTarget, ContextStatus>? ContextOf { get; set; }

    /// <summary>
    /// Gets or sets the callback to compact the conversation with the chosen target.
    /// </summary>
    [Parameter]
    public EventCallback<ChatTarget> OnCompact { get; set; }

    /// <summary>
    /// Gets or sets the message being edited, whose text fills the box until it is sent or the edit is cancelled, or null.
    /// </summary>
    [Parameter]
    public ChatEntry? Editing { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user cancelling the edit.
    /// </summary>
    [Parameter]
    public EventCallback OnCancelEdit { get; set; }

    /// <summary>
    /// Gets or sets the function that sends a message with its files and chosen target. It returns an error to show when the message was not sent, or null.
    /// </summary>
    [Parameter]
    public Func<ComposerMessage, Task<string?>>? OnSend { get; set; }

    /// <summary>
    /// Gets or sets the callback to retry the last reply with the chosen target.
    /// </summary>
    [Parameter]
    public EventCallback<ChatTarget> OnRetry { get; set; }

    /// <summary>
    /// Gets or sets the callback to stop the running reply.
    /// </summary>
    [Parameter]
    public EventCallback OnStop { get; set; }

    /// <summary>
    /// Gets or sets extra controls shown after the model and thinking choices.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public void Dispose()
    {
        Providers.Changed -= OnProvidersChanged;
    }

    /// <summary>
    /// Put text back in front of what the user has typed, for messages that were queued and then not added because the reply stopped.
    /// </summary>
    /// <param name="text">The text to restore.</param>
    public void Restore(string text)
    {
        _text = string.IsNullOrWhiteSpace(_text) ? text : $"{text}\n\n{_text}";
        _resize = true;
        StateHasChanged();
    }

    /// <summary>
    /// Add text after what the user has typed, such as remarks on the changes that they want to send.
    /// </summary>
    /// <param name="text">The text to add.</param>
    public void Append(string text)
    {
        _text = string.IsNullOrWhiteSpace(_text) ? text : $"{_text.TrimEnd()}\n\n{text}";
        _resize = true;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        LoadModels();
        Providers.Changed += OnProvidersChanged;
    }

    private void OnProvidersChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            LoadModels();
            if (_models.Exists(m => m.Key == _selected))
            {
                LoadLevels();
                if (!_levels.Any(l => l.ToString() == _level))
                {
                    _level = DefaultLevelName();
                }
            }
            else
            {
                ApplyChoices();
            }

            RefreshContext();
            StateHasChanged();
        });
    }

    protected override void OnParametersSet()
    {
        if (Editing?.Id != _loadedEdit)
        {
            _text = Editing?.Text ?? string.Empty;
            if (Editing is not null)
            {
                _files.Clear();
            }

            _loadedEdit = Editing?.Id;
            _resize = true;
        }

        if (!_applied || ChatId != _appliedFor)
        {
            var createdByThisComposer = _creating && ChatId is not null;
            _creating = false;
            _applied = true;
            _appliedFor = ChatId;
            _suggestedFor = null;
            if (!createdByThisComposer)
            {
                ApplyChoices();
            }
        }

        RefreshContext();
    }

    /// <summary>
    /// Refresh the context estimate for the current target.
    /// </summary>
    /// <remarks>Reading the context takes the chat lock and may estimate the whole history, so it is not done on every keystroke.</remarks>
    private void RefreshContext()
    {
        _context = CurrentTarget() is { } target ? ContextOf?.Invoke(target) : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The message box only exists while there are models, and is built anew when they come back.
        if (_models.Count == 0)
        {
            _wired = false;
            return;
        }

        if (!_wired)
        {
            _wired = true;
            try
            {
                await JS.InvokeVoidAsync("bhChat.initComposer", _input, _form);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }

        if (_resize)
        {
            _resize = false;
            try
            {
                await JS.InvokeVoidAsync("bhChat.resize", _input);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }
    }

    private bool SwitchesModel => Remembered is not null
        && _selected.Length > 0
        && _selected != $"{Remembered.ProviderId}|{Remembered.ModelId}"
        && _models.Exists(m => m.Provider.Id == Remembered.ProviderId && m.Model.Id == Remembered.ModelId);

    private void ApplyChoices()
    {
        var config = Providers.Config;
        var remembered = Remembered is null
            ? null
            : _models.Find(m => m.Provider.Id == Remembered.ProviderId && m.Model.Id == Remembered.ModelId);
        var preferred = remembered ?? _models.Find(m => m.Provider.Id == config.DefaultProviderId && m.Model.Id == config.DefaultModelId);
        _selected = (preferred ?? _models.FirstOrDefault())?.Key ?? string.Empty;
        LoadLevels();
        _level = remembered is null || Remembered?.Level is not { } level || !_levels.Contains(level)
            ? DefaultLevelName()
            : level.ToString();

        _note = null;
    }

    private static string KeyOf(ProviderConfig provider, ModelConfig model)
    {
        return $"{provider.Id}|{model.Id}";
    }

    private void LoadModels()
    {
        _models = [.. Providers.Configured.SelectMany(p => p.Models.Select(m => new Choice(KeyOf(p, m), p, m)))];
    }

    private void LoadLevels()
    {
        var levels = _models.Find(m => m.Key == _selected)?.Model.Levels;
        _levels = levels is null ? [] : [.. levels.Keys.Order()];
    }

    private string DefaultLevelName()
    {
        return SelectedChoice?.Model.DefaultLevel?.ToString() ?? string.Empty;
    }

    private Choice? SelectedChoice => _models.Find(m => m.Key == _selected);

    private void SelectModel(string key)
    {
        _selected = key;
        LoadLevels();
        _note = null;
        if (_level.Length > 0 && !_levels.Any(l => l.ToString() == _level))
        {
            var previous = _level;
            _level = DefaultLevelName();
            _note = _level.Length > 0
                ? ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.ComposerLevelUnavailable),
                    new Dictionary<string, object?> { ["previous"] = previous, ["level"] = _level })
                : null;
        }
        else if (_level.Length == 0)
        {
            _level = DefaultLevelName();
        }

        RefreshContext();
    }

    private void SelectLevel(string level)
    {
        _level = level;
        _note = null;
        RefreshContext();
    }

    private ChatTarget? CurrentTarget()
    {
        var choice = SelectedChoice;
        if (choice is null)
        {
            return null;
        }

        ThinkingLevel? level = Enum.TryParse<ThinkingLevel>(_level, out var parsed) ? parsed : null;
        return new ChatTarget(choice.Provider, choice.Model, level);
    }

    private static string ShortDescription(SkillInfo skill) => TextShortener.Shorten(skill.Description, SuggestionDescriptionLength);

    /// <summary>
    /// Get skill suggestions for the current text, reusing the list until the text changes.
    /// </summary>
    /// <remarks>Looking up skills reads the disk.</remarks>
    private List<SkillInfo>? Suggestions()
    {
        if (_suggestedFor == _text)
        {
            return _suggestions;
        }

        _suggestedFor = _text;
        return _suggestions = FindSuggestions();
    }

    /// <summary>
    /// Find the skills whose name starts with the <c>/partial</c> word the text ends with.
    /// </summary>
    /// <remarks>A skill can be named anywhere in a message, so the word being typed at the end is matched, not only a word at the start.</remarks>
    private List<SkillInfo>? FindSuggestions()
    {
        var start = SkillWordStart();
        if (start < 0)
        {
            return null;
        }

        var typed = _text[(start + 1)..];
        var available = ChatId is null ? Catalog.For(FolderPath, null).Skills : ChatService.AvailableSkills(ChatId).Skills.Where(s => ChatService.IsSkillEnabled(ChatId, s.Name)).ToList();
        return [.. available.Where(skill => skill.Name.StartsWith(typed, StringComparison.Ordinal)).Take(MaxSuggestions)];
    }

    /// <summary>
    /// Get where the <c>/partial</c> word at the end of the text starts.
    /// </summary>
    /// <returns>The index of its slash, or -1 when the text doesn't end with such a word.</returns>
    private int SkillWordStart()
    {
        var start = _text.Length;
        while (start > 0 && !char.IsWhiteSpace(_text[start - 1]))
        {
            start--;
        }

        return start < _text.Length && _text[start] == '/' && _text.IndexOf('/', start + 1) < 0 ? start : -1;
    }

    private async Task ChooseSkillAsync(SkillInfo skill)
    {
        var start = Math.Max(SkillWordStart(), 0);
        _text = $"{_text[..start]}/{skill.Name} ";
        _resize = true;
        await _input.FocusAsync();
    }

    private string Placeholder
    {
        get
        {
            if (Asked)
            {
                return WebStrings.ComposerAnswerQuestion;
            }

            if (!CanQueue)
            {
                return WebStrings.ComposerPlaceholder;
            }

            return WebStrings.ComposerQueuePlaceholder;
        }
    }

    private static string FileRemoveLabel(string name) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.ComposerRemoveFile), new Dictionary<string, object?> { ["name"] = name });

    private static string PreviewStartLabel(string name) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.ComposerPreviewStart), new Dictionary<string, object?> { ["name"] = name });

    private async Task SubmitAsync()
    {
        if (Running)
        {
            Enqueue(QueueMode.Steer);
            return;
        }

        var target = CurrentTarget();
        if (target is null || OnSend is null || (string.IsNullOrWhiteSpace(_text) && _files.Count == 0))
        {
            return;
        }

        var text = _text;
        var files = _files.ToArray();
        _creating = ChatId is null;
        _text = string.Empty;
        _files.Clear();
        _note = null;
        _resize = true;
        var error = await OnSend(new ComposerMessage(text, files, target));
        if (error is not null)
        {
            _creating = false;
            _text = text;
            _files.AddRange(files);
            _note = error;
            _resize = true;
        }
    }

    private void Enqueue(QueueMode mode)
    {
        if (!CanQueue || OnQueue is null || string.IsNullOrWhiteSpace(_text))
        {
            return;
        }

        if (_files.Count > 0)
        {
            _note = WebStrings.ComposerFilesNotQueued;
            return;
        }

        if (OnQueue(_text, Asked ? QueueMode.Steer : mode))
        {
            _text = string.Empty;
            _note = null;
            _resize = true;
        }
        else
        {
            _note = Asked ? WebStrings.ComposerQuestionAlreadyHandled : WebStrings.ComposerReplyEnded;
        }
    }

    private async Task AddFilesAsync(InputFileChangeEventArgs e)
    {
        _note = null;
        foreach (var browserFile in e.GetMultipleFiles(int.MaxValue))
        {
            if (_files.Count >= ChatAttachments.MaxFilesPerMessage)
            {
                _note = ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.ComposerMaxFiles),
                    new Dictionary<string, object?> { ["count"] = ChatAttachments.MaxFilesPerMessage });
                break;
            }

            if (browserFile.Size > ChatAttachments.MaxFileBytes)
            {
                _note = ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.ComposerFileTooLarge),
                    new Dictionary<string, object?> { ["name"] = browserFile.Name, ["size"] = FileSize.Format(ChatAttachments.MaxFileBytes) });
                continue;
            }

            if (_files.Sum(f => (long)f.Content.Length) + browserFile.Size > ChatAttachments.MaxMessageBytes)
            {
                _note = ResourceMessageFormatter.Web.Format(
                    nameof(WebStrings.ChatViewAttachmentLimit),
                    new Dictionary<string, object?> { ["size"] = FileSize.Format(ChatAttachments.MaxMessageBytes) });
                continue;
            }

            _files.Add(await PendingFile.ReadAsync(browserFile));
        }

        if (_picker is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("bhChat.clearPicker", _picker.Element);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }
    }

    private void Remove(PendingFile file)
    {
        _files.Remove(file);
    }

    private static string Preview(PendingFile file)
    {
        var text = Encoding.UTF8.GetString(file.Content.Span[..Math.Min(file.Content.Length, PreviewBytes)]);
        return file.Content.Length > PreviewBytes ? text + "…" : text;
    }

    private static string HintFor(AttachmentDelivery delivery) => delivery switch
    {
        AttachmentDelivery.Image => WebStrings.ComposerAttachmentImage,
        AttachmentDelivery.Inline => WebStrings.ComposerAttachmentInline,
        _ => WebStrings.ComposerAttachmentTooLong,
    };

    private IReadOnlyList<AttachmentDelivery> Deliveries()
    {
        var choice = _models.Find(m => m.Key == _selected);
        return choice is null ? [] : AttachmentPolicy.Deliveries([.. _files.Select(f => (f.IsImage, (long)f.Content.Length))], choice.Model);
    }

    private void TogglePreview(PendingFile file)
    {
        _previewing = _previewing == file.Id ? null : file.Id;
    }

    private void InsertAsText(PendingFile file)
    {
        var text = Encoding.UTF8.GetString(file.Content.Span);
        _text = _text.Length == 0 || _text.EndsWith('\n') ? _text + text : _text + "\n" + text;
        _files.Remove(file);
        _resize = true;
    }

    private bool ModelSeesImages => _models.Find(m => m.Key == _selected) is { } choice && AttachmentPolicy.AcceptsImages(choice.Model);

    private async Task CancelEditAsync()
    {
        await OnCancelEdit.InvokeAsync();
    }

    private async Task CompactAsync()
    {
        if (CurrentTarget() is { } target)
        {
            await OnCompact.InvokeAsync(target);
        }
    }

    private async Task RetryAsync()
    {
        if (CurrentTarget() is { } target)
        {
            await OnRetry.InvokeAsync(target);
        }
    }
}
