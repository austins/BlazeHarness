@using BlazeHarness.Core.Config
@using BlazeHarness.Core.Sandbox
@using BlazeHarness.Core.Web
@inject JsonFileStore<AppConfig> Config
@inject WebServices Web
@inject IShellSandbox Sandbox
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.WebToolsSettingsTitle">@WebStrings.WebToolsSettingsDescription</PageHeader>

    <section class="card stack" aria-labelledby="web-tools-heading">
        <h2 id="web-tools-heading">@WebStrings.WebToolsSettingsToolsHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@Current.SearchEnabled" @onchange="e => SaveAsync(s => s with { SearchEnabled = (bool)e.Value! })" />
            <span>@WebStrings.WebToolsSettingsSearchLabel</span>
        </label>
        <label class="check">
            <input type="checkbox" checked="@Current.FetchEnabled" @onchange="e => SaveAsync(s => s with { FetchEnabled = (bool)e.Value! })" />
            <span>@WebStrings.WebToolsSettingsFetchLabel</span>
        </label>
        <p class="hint">@WebStrings.WebToolsSettingsFetchHint</p>
        <label class="check">
            <input type="checkbox" checked="@Current.BrowserEnabled" @onchange="e => SaveAsync(s => s with { BrowserEnabled = (bool)e.Value! })" />
            <span>@WebStrings.WebToolsSettingsBrowserLabel</span>
        </label>
        <p class="hint">@WebStrings.WebToolsSettingsBrowserHint</p>
        @if (!Sandbox.Status.ForwardsPorts)
        {
            <p class="hint">@(OperatingSystem.IsLinux() ? WebStrings.WebToolsSettingsBrowserNeedsForwarding : WebStrings.WebToolsSettingsBrowserNeedsUnrestricted)</p>
        }
        @if (_browserInstalled is { } installed)
        {
            <div class="row">
                <span class="badge" role="status">@(installed ? WebStrings.WebToolsSettingsBrowserInstalled : WebStrings.WebToolsSettingsBrowserMissing)</span>
                @if (!installed)
                {
                    <button type="button" class="btn btn-sm" disabled="@_installing" @onclick="InstallBrowserAsync">
                        @if (_installing)
                        {
                            <Icon Name="spinner" Spin="true" />
                            @WebStrings.WebToolsSettingsBrowserInstalling
                        }
                        else
                        {
                            @WebStrings.WebToolsSettingsBrowserInstall
                        }
                    </button>
                }
            </div>
            @if (_installing)
            {
                <p class="hint" role="status">@WebStrings.WebToolsSettingsBrowserInstallingHint</p>
            }
        }
    </section>

    <section class="card stack" aria-labelledby="web-search-heading">
        <h2 id="web-search-heading">@WebStrings.WebToolsSettingsProvidersHeading</h2>
        <p class="hint">@WebStrings.WebToolsSettingsProvidersHint</p>
        <div class="stack" role="radiogroup" aria-label="@WebStrings.WebToolsSettingsModeLabel">
            <label class="check">
                <input type="radio" name="web-mode" checked="@(Current.SearchMode == WebSearchMode.Parallel)" @onchange="() => SaveAsync(s => s with { SearchMode = WebSearchMode.Parallel })" />
                <span>@WebStrings.WebToolsSettingsModeParallel</span>
            </label>
            <label class="check">
                <input type="radio" name="web-mode" checked="@(Current.SearchMode == WebSearchMode.Sequential)" @onchange="() => SaveAsync(s => s with { SearchMode = WebSearchMode.Sequential })" />
                <span>@WebStrings.WebToolsSettingsModeSequential</span>
            </label>
        </div>
        @foreach (var (provider, index) in Providers.Select((p, i) => (p, i)))
        {
            var info = WebProviders.All.First(i => i.Id == provider.Id);
            var status = Web.StatusOf(provider.Id);
            <div class="row provider-row" role="group" aria-label="@info.Name">
                <label class="check">
                    <input type="checkbox" checked="@provider.Enabled" @onchange="e => SetProviderAsync(index, (bool)e.Value!)" />
                    <span><strong>@info.Name</strong> <span class="muted">@info.Description</span></span>
                </label>
                @if (status is not null)
                {
                    <span class="badge">@(status.Working ? WebStrings.WebToolsWorking : status.Detail)</span>
                }
                @if (Current.SearchMode == WebSearchMode.Sequential)
                {
                    <button type="button" class="btn btn-sm btn-icon" aria-label="@MoveLabel(info.Name, WebStrings.WebToolsUp)" disabled="@(index == 0)" @onclick="() => MoveAsync(index, -1)"><Icon Name="arrow-up" /></button>
                    <button type="button" class="btn btn-sm btn-icon" aria-label="@MoveLabel(info.Name, WebStrings.WebToolsDown)" disabled="@(index == Providers.Count - 1)" @onclick="() => MoveAsync(index, 1)"><Icon Name="arrow-down" /></button>
                }
            </div>
        }
    </section>
</div>

@code {
    private bool? _browserInstalled;
    private bool _installing;

    private static string SaveFailure => WebStrings.GeneralSettingsSaveFailure;

    private static string MoveLabel(string name, string direction) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.WebToolsMoveProvider), new Dictionary<string, object?> { ["name"] = name, ["direction"] = direction });

    protected override async Task OnInitializedAsync()
    {
        _browserInstalled = await Web.IsBrowserInstalledAsync(CancellationToken.None);
    }

    private async Task InstallBrowserAsync()
    {
        _installing = true;
        try
        {
            _browserInstalled = await Web.InstallBrowserAsync(CancellationToken.None);
        }
        finally
        {
            _installing = false;
        }

        if (_browserInstalled != true)
        {
            Toasts.Show(WebStrings.WebToolsSettingsBrowserInstallFailed, ToastKind.Error);
        }
    }

    private WebSettings Current => Config.Current.Web;

    private IReadOnlyList<WebProviderSetting> Providers => Current.ResolveProviders();

    private Task SaveAsync(Func<WebSettings, WebSettings> change)
    {
        return Toasts.TrySaveAsync(() => Config.UpdateAsync(config => config with { Web = change(config.Web) }), SaveFailure);
    }

    private Task SetProviderAsync(int index, bool enabled)
    {
        return SaveProvidersAsync(list => list[index] = list[index] with { Enabled = enabled });
    }

    private Task MoveAsync(int index, int by)
    {
        return SaveProvidersAsync(list => (list[index], list[index + by]) = (list[index + by], list[index]));
    }

    private Task SaveProvidersAsync(Action<List<WebProviderSetting>> change)
    {
        return SaveAsync(settings =>
        {
            var list = settings.ResolveProviders().ToList();
            change(list);
            return settings with { Providers = list };
        });
    }
}
