@using BlazeHarness.Core.Mcp
@using System.Collections.ObjectModel
@using BlazeHarness.Core.Mcp.Config
@inject McpServerEditor Editor

<form class="stack" @onsubmit="SaveAsync" autocomplete="off" novalidate aria-label="@FormLabel">
    <h3>@FormLabel</h3>

    <div class="form-grid">
        <div class="field">
            <label for="mcp-name">@WebStrings.McpServerFormServerName</label>
            <input id="mcp-name" class="input mono" @bind="Draft.Name" @bind:event="oninput" disabled="@(!Draft.IsNew)" placeholder="@WebStrings.McpServerFormNamePlaceholder" />
            <span class="hint">@WebStrings.McpServerFormNameHint</span>
        </div>
        <div class="field">
            <label for="mcp-transport">@WebStrings.McpServerFormKind</label>
            <select id="mcp-transport" class="select" @bind="Draft.Transport">
                <option value="@McpTransport.Stdio">@WebStrings.McpServerFormKindLocal</option>
                <option value="@McpTransport.Http">@WebStrings.McpServerFormKindHttp</option>
                <option value="@McpTransport.Sse">@WebStrings.McpServerFormKindSse</option>
            </select>
        </div>
    </div>

    @if (Draft.Transport == McpTransport.Stdio)
    {
        <div class="form-grid">
            <div class="field">
                <label for="mcp-command">@WebStrings.McpServerFormCommand</label>
                <input id="mcp-command" class="input mono" @bind="Draft.Command" @bind:event="oninput" placeholder="npx" spellcheck="false" />
            </div>
            <div class="field">
                <label for="mcp-cwd">@WebStrings.McpServerFormWorkingFolder <span class="muted">(@WebStrings.McpServerFormOptional)</span></label>
                <input id="mcp-cwd" class="input mono" @bind="Draft.Cwd" @bind:event="oninput" spellcheck="false" />
            </div>
        </div>
        <div class="field">
            <label for="mcp-args">@WebStrings.McpServerFormArguments <span class="muted">(@WebStrings.McpServerFormOnePerLine)</span></label>
            <textarea id="mcp-args" class="input mono" rows="3" @bind="Draft.ArgsText" @bind:event="oninput" spellcheck="false" placeholder="@ArgsPlaceholder"></textarea>
        </div>
        @Entries(Draft.Env, WebStrings.McpServerFormEnvironmentVariables, WebStrings.McpServerFormAddVariable, WebStrings.McpServerFormVariableName)
    }
    else
    {
        <div class="field">
            <label for="mcp-url">@WebStrings.McpServerFormAddress</label>
            <input id="mcp-url" class="input mono" @bind="Draft.Url" @bind:event="oninput" inputmode="url" spellcheck="false" placeholder="https://example.com/mcp" />
        </div>
        @Entries(Draft.Headers, WebStrings.McpServerFormHeaders, WebStrings.McpServerFormAddHeader, WebStrings.McpServerFormHeaderName)
    }

    <label class="check">
        <input type="checkbox" @bind="Draft.AlwaysLoadAll" />
        <span>@WebStrings.McpServerFormAlwaysLoad</span>
    </label>
    <p class="hint">@WebStrings.McpServerFormAlwaysLoadHint</p>

    <p class="hint">
        @ResourceMessageFormatter.Web.FormatMarkup(
            Editor.SecretStoreIsSecure ? nameof(WebStrings.McpServerFormSecretNote) : nameof(WebStrings.McpServerFormSecretNoteNotEncrypted),
            new Dictionary<string, object?> { ["store"] = Editor.SecretStoreName, ["reference"] = "${MCP_…}" })
    </p>

    @if (_problems.Count > 0)
    {
        <Alert>
            <strong>@WebStrings.McpServerFormProblemsHeading</strong>
            <ul>@foreach (var problem in _problems) { <li>@problem</li> }</ul>
        </Alert>
    }

    <div class="row">
        <button type="submit" class="btn btn-primary" disabled="@_saving">@WebStrings.McpServerFormSave</button>
        <button type="button" class="btn btn-ghost" @onclick="OnCancel">@WebStrings.McpServerFormCancel</button>
    </div>
</form>

@code {
    private const string ArgsPlaceholder = "-y\n@modelcontextprotocol/server-github";

    private IReadOnlyList<string> _problems = [];
    private bool _saving;
    private string FormLabel => Draft.IsNew
        ? WebStrings.McpServerFormAddServer
        : ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpServerFormEditServer),
            new Dictionary<string, object?> { ["name"] = Draft.Name });

    /// <summary>
    /// Gets or sets the settings being edited.
    /// </summary>
    [Parameter, EditorRequired]
    public McpServerDraft Draft { get; set; } = default!;

    /// <summary>
    /// Gets or sets the callback for the server being saved.
    /// </summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user giving up.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private RenderFragment Entries(Collection<McpDraftEntry> entries, string title, string addLabel, string nameLabel) => __builder =>
    {
        <div class="stack">
            <div class="row row-spread">
                <span class="label">@title</span>
                <button type="button" class="btn btn-sm" @onclick="() => entries.Add(new McpDraftEntry())">＋ @addLabel</button>
            </div>
            @foreach (var entry in entries)
            {
                <div class="input-group entry-row" @key="entry">
                    <input class="input mono" aria-label="@nameLabel" placeholder="@WebStrings.McpServerFormName" spellcheck="false" @bind="entry.Name" @bind:event="oninput" />
                    @if (entry.Secret)
                    {
                        <SecretInput Value="@entry.Value" ValueChanged="v => entry.Value = v" HasStoredKey="entry.HasStoredSecret" Placeholder="@WebStrings.McpServerFormSecretValue" />
                    }
                    else
                    {
                        <input class="input mono" aria-label="@WebStrings.McpServerFormValue" placeholder="@WebStrings.McpServerFormValue" spellcheck="false" @bind="entry.Value" @bind:event="oninput" />
                    }
                    <label class="check"><input type="checkbox" checked="@entry.Secret" @onchange="e => ToggleSecret(entry, (bool)e.Value!)" /> <span>@WebStrings.McpServerFormSecret</span></label>
                    <button type="button" class="btn btn-ghost btn-danger" aria-label="@WebStrings.McpServerFormRemoveEntry" @onclick="() => entries.Remove(entry)"><Icon Name="close" /></button>
                </div>
            }
        </div>
    };

    private static void ToggleSecret(McpDraftEntry entry, bool secret) => entry.Secret = secret;

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _problems = await Editor.SaveAsync(Draft);
            if (_problems.Count == 0)
            {
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            _problems = [WebStrings.McpServerFormSaveFailure];
        }
        finally
        {
            _saving = false;
        }
    }
}
