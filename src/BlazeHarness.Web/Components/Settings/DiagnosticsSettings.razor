@using System.Reflection
@using System.Runtime.InteropServices
@using BlazeHarness.Core
@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Folders
@using BlazeHarness.Core.Logging
@using BlazeHarness.Core.Mcp
@using BlazeHarness.Core.Sandbox
@using BlazeHarness.Core.Skills
@inject AppPaths Paths
@inject ChatService ChatService
@inject FolderRegistry Folders
@inject McpManager Mcp
@inject SkillCatalog Skills
@inject IShellSandbox Sandbox
@inject ChatScripts ChatScripts
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.DiagnosticsSettingsTitle">@WebStrings.DiagnosticsSettingsDescription</PageHeader>

    <section class="card stack" aria-labelledby="about-heading">
        <div class="card-header">
            <h2 id="about-heading">@WebStrings.DiagnosticsSettingsAboutHeading</h2>
            <button type="button" class="btn btn-sm" @onclick="CopyAsync"><Icon Name="copy" /> @WebStrings.DiagnosticsSettingsCopyButton</button>
        </div>
        <dl class="facts">
            <dt>@WebStrings.DiagnosticsSettingsVersionLabel</dt>
            <dd>@Version</dd>
            <dt>@WebStrings.DiagnosticsSettingsRuntimeLabel</dt>
            <dd>@RuntimeInformation.FrameworkDescription</dd>
            <dt>@WebStrings.DiagnosticsSettingsSystemLabel</dt>
            <dd>@RuntimeInformation.OSDescription</dd>
            <dt>@WebStrings.DiagnosticsSettingsDataFolderLabel</dt>
            <dd class="mono">@Paths.Home</dd>
            <dt>@WebStrings.DiagnosticsSettingsLogFolderLabel</dt>
            <dd class="mono">@Paths.LogsDirectory</dd>
            <dt>@WebStrings.DiagnosticsSettingsShellSandboxLabel</dt>
            <dd>
                @SandboxName
                <div class="hint">@Sandbox.Status.Detail</div>
            </dd>
            <dt>@WebStrings.DiagnosticsSettingsChatsLabel</dt>
            <dd>@ChatCount</dd>
            <dt>@WebStrings.DiagnosticsSettingsFoldersLabel</dt>
            <dd>@FolderCount</dd>
            <dt>@WebStrings.DiagnosticsSettingsMcpServersLabel</dt>
            <dd>@McpSummary</dd>
            <dt>@WebStrings.DiagnosticsSettingsSkillsLabel</dt>
            <dd>@_skillCount</dd>
        </dl>
    </section>

    <section class="card stack" aria-labelledby="log-heading">
        <div class="card-header">
            <h2 id="log-heading">@WebStrings.DiagnosticsSettingsRecentLogHeading</h2>
            <button type="button" class="btn btn-sm" @onclick="LoadAsync"><Icon Name="retry" /> @WebStrings.DiagnosticsSettingsRefreshButton</button>
        </div>
        <p class="hint">@LogRetention()</p>
        @if (_lines.Count == 0)
        {
            <p class="muted">@WebStrings.DiagnosticsSettingsLogEmpty</p>
        }
        else
        {
            <pre class="log-tail mono" tabindex="0" aria-label="@WebStrings.DiagnosticsSettingsRecentLogLabel">@string.Join('\n', _lines)</pre>
        }
    </section>
</div>

@code {
    private const int TailLines = 200;

    private IReadOnlyList<string> _lines = [];
    private IReadOnlyList<McpServerStatus> _servers = [];
    private int _skillCount;

    private static string Version => typeof(DiagnosticsSettings).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? WebStrings.DiagnosticsSettingsUnknown;

    private int ChatCount => ChatService.Store.List().Count;

    private int FolderCount => Folders.List().Count;

    private string McpSummary =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.DiagnosticsSettingsMcpSummary),
            new Dictionary<string, object?>
            {
                ["connected"] = _servers.Count(s => s.State == McpServerState.Connected),
                ["total"] = _servers.Count,
            });

    private string SandboxName => Sandbox.Status.IsAvailable ? Sandbox.Status.Name : WebStrings.DiagnosticsSettingsNotAvailable;

    protected override async Task OnInitializedAsync()
    {
        _servers = Mcp.Statuses();
        _skillCount = Skills.Resolve(null).Skills.Count;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lines = await LogTail.ReadAsync(Paths.LogsDirectory, TailLines);
    }

    private async Task CopyAsync()
    {
        await LoadAsync();
        // The copied report is intentionally not localized: it is pasted into bug reports, which are read in English.
        var report = $"""
            Version: {Version}
            Runtime: {RuntimeInformation.FrameworkDescription}
            System: {RuntimeInformation.OSDescription}
            Shell sandbox: {SandboxName}
            Chats: {ChatCount}, folders: {FolderCount}, MCP servers: {McpSummary}, skills: {_skillCount}

            Recent log:
            {string.Join('\n', _lines)}
            """;
        var copied = await ChatScripts.CopyTextAsync(report);
        Toasts.Show(copied ? WebStrings.DiagnosticsSettingsReportCopied : WebStrings.DiagnosticsSettingsCopyFailed, copied ? ToastKind.Success : ToastKind.Error);
    }

    private static string LogRetention() =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.DiagnosticsSettingsLogRetention),
            new Dictionary<string, object?> { ["days"] = FileLoggerProvider.RetainedDays });
}
