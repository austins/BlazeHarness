@using System.Reflection
@using System.Runtime.InteropServices
@using BlazeHarness.Core
@using BlazeHarness.Core.Chats
@using BlazeHarness.Core.Folders
@using BlazeHarness.Core.Logging
@using BlazeHarness.Core.Mcp
@using BlazeHarness.Core.Sandbox
@using BlazeHarness.Core.Skills
@inject AppPaths Paths
@inject ChatService ChatService
@inject FolderRegistry Folders
@inject McpManager Mcp
@inject SkillCatalog Skills
@inject IShellSandbox Sandbox
@inject IJSRuntime JS
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="Diagnostics">What to look at when something doesn't work, and what to include when you report it.</PageHeader>

    <section class="card stack" aria-labelledby="about-heading">
        <div class="card-header">
            <h2 id="about-heading">About this install</h2>
            <button type="button" class="btn btn-sm" @onclick="CopyAsync"><Icon Name="copy" /> Copy for a bug report</button>
        </div>
        <dl class="facts">
            <dt>Version</dt>
            <dd>@Version</dd>
            <dt>Runtime</dt>
            <dd>@RuntimeInformation.FrameworkDescription</dd>
            <dt>System</dt>
            <dd>@RuntimeInformation.OSDescription</dd>
            <dt>Data folder</dt>
            <dd class="mono">@Paths.Home</dd>
            <dt>Log folder</dt>
            <dd class="mono">@Paths.LogsDirectory</dd>
            <dt>Shell sandbox</dt>
            <dd>
                @SandboxName
                <div class="hint">@Sandbox.Status.Detail</div>
            </dd>
            <dt>Chats</dt>
            <dd>@ChatCount</dd>
            <dt>Folders</dt>
            <dd>@FolderCount</dd>
            <dt>MCP servers</dt>
            <dd>@McpSummary</dd>
            <dt>Skills</dt>
            <dd>@_skillCount</dd>
        </dl>
    </section>

    <section class="card stack" aria-labelledby="log-heading">
        <div class="card-header">
            <h2 id="log-heading">Recent log</h2>
            <button type="button" class="btn btn-sm" @onclick="LoadAsync"><Icon Name="retry" /> Refresh</button>
        </div>
        <p class="hint">Logs hold identifiers, counts and errors, never the text of your messages or files. Files are kept for @FileLoggerProvider.RetainedDays days.</p>
        @if (_lines.Count == 0)
        {
            <p class="muted">Nothing has been logged yet.</p>
        }
        else
        {
            <pre class="log-tail mono" tabindex="0" aria-label="Recent log lines">@string.Join('\n', _lines)</pre>
        }
    </section>
</div>

@code {
    private const int TailLines = 200;

    private IReadOnlyList<string> _lines = [];
    private IReadOnlyList<McpServerStatus> _servers = [];
    private int _skillCount;

    private static string Version => typeof(DiagnosticsSettings).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? "unknown";

    private int ChatCount => ChatService.Store.List().Count;

    private int FolderCount => Folders.List().Count;

    private string McpSummary => $"{_servers.Count(s => s.State == McpServerState.Connected)} connected of {_servers.Count}";

    private string SandboxName => Sandbox.Status.IsAvailable ? Sandbox.Status.Name : "Not available";

    protected override async Task OnInitializedAsync()
    {
        _servers = Mcp.Statuses();
        _skillCount = Skills.Resolve(null).Skills.Count;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lines = await LogTail.ReadAsync(Paths.LogsDirectory, TailLines);
    }

    private async Task CopyAsync()
    {
        await LoadAsync();
        var report = $"""
            Version: {Version}
            Runtime: {RuntimeInformation.FrameworkDescription}
            System: {RuntimeInformation.OSDescription}
            Shell sandbox: {SandboxName}
            Chats: {ChatCount}, folders: {FolderCount}, MCP servers: {McpSummary}, skills: {_skillCount}

            Recent log:
            {string.Join('\n', _lines)}
            """;
        var copied = await JS.InvokeAsync<bool>("bhChat.copyText", report);
        Toasts.Show(copied ? "Copied. Paste it into your report." : "Couldn't copy. Select the text and copy it by hand.", copied ? ToastKind.Success : ToastKind.Error);
    }
}
