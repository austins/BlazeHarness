@using System.Text.Json
@using System.Globalization
@using BlazeHarness.Core.Config
@implements IDisposable
@inject ProviderService Service
@inject IHttpClientFactory HttpFactory
@inject TimeProvider Time
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.ProvidersSettingsPageTitle">@WebStrings.ProvidersSettingsHeaderBefore @Service.Secrets.Name@(Service.Secrets.IsSecure ? WebStrings.ProvidersSettingsSecureSuffix : WebStrings.ProvidersSettingsInsecureSuffix)</PageHeader>

    <div class="split">
        @if (ShowList)
        {
        <aside class="stack" aria-label="@WebStrings.ProvidersSettingsListLabel">
            <div class="list">
                @foreach (var provider in Service.Configured)
                {
                    var isCurrent = _edit is { IsNew: false } && _edit.Id == provider.Id;
                    <button type="button" class="list-item" aria-current="@(isCurrent ? "true" : "false")" @onclick="() => Select(provider)">
                        <span>@provider.DisplayName @if (Service.Config.DefaultProviderId == provider.Id) { <span class="badge badge-accent">@WebStrings.ProvidersSettingsDefaultProviderBadge</span> }</span>
                        <span class="sub">@ModelCountLabel(provider.Models.Count) · @provider.BaseUrl</span>
                    </button>
                }
            </div>
            <button type="button" class="btn btn-add" @onclick="StartNew"><Icon Name="plus" /> @WebStrings.ProvidersSettingsAddProviderButton</button>
        </aside>
        }

        <section>
            @if (_edit is null)
            {
                <div class="card empty">
                    @if (Service.Configured.Count == 0)
                    {
                        <h2>@WebStrings.ProvidersSettingsEmptyStateHeading</h2>
                        <p>@WebStrings.ProvidersSettingsEmptyStateDescription</p>
                    }
                    else
                    {
                        <p>@WebStrings.ProvidersSettingsSelectPrompt</p>
                    }
                </div>
            }
            else
            {
                <form @onsubmit="SaveAsync" class="stack" autocomplete="off" novalidate>
                    <div class="card stack">
                        <div class="card-header">
                            <h2>@(_edit.IsNew ? WebStrings.ProvidersSettingsNewProvider : _edit.DisplayName)</h2>
                            @if (!ShowList)
                            {
                                <button type="button" class="btn btn-sm" @onclick="StartNew"><Icon Name="plus" /> @WebStrings.ProvidersSettingsAddProviderEditorButton</button>
                            }
                        </div>

                        <div class="form-grid">
                            <div class="field">
                                <label for="p-name">@WebStrings.ProvidersSettingsNameLabel</label>
                                <input id="p-name" class="input" aria-invalid="@Invalid("displayName")" @bind="_edit.DisplayName" @bind:event="oninput" placeholder="@WebStrings.ProvidersSettingsNamePlaceholder" />
                                @Error("displayName")
                            </div>
                            <div class="field">
                                <label for="p-url">@WebStrings.ProvidersSettingsBaseUrlLabel</label>
                                <input id="p-url" class="input mono" aria-invalid="@Invalid("baseUrl")" @bind="_edit.BaseUrl" @bind:event="oninput" placeholder="https://api.example.com/v1" inputmode="url" />
                                @Error("baseUrl")
                            </div>
                            <div class="field">
                                <label for="p-key">@WebStrings.ProvidersSettingsApiKeyLabel <span class="muted">(@WebStrings.McpServerFormOptional)</span></label>
                                <SecretInput Id="p-key" @bind-Value="_edit.NewApiKey" HasStoredKey="_hasStoredKey" OnRemoveStored="ClearKeyAsync" Placeholder="@WebStrings.ProvidersSettingsOptionalForLocal" />
                                <span class="hint">@WebStrings.ProvidersSettingsApiKeyHint</span>
                                <details class="key-env" open="@(!string.IsNullOrWhiteSpace(_edit.ApiKeyEnvVar))">
                                    <summary>@WebStrings.ProvidersSettingsEnvVarSummary</summary>
                                    <input id="p-env" class="input mono" aria-label="@WebStrings.ProvidersSettingsEnvVarLabel" @bind="_edit.ApiKeyEnvVar" placeholder="PROVIDER_API_KEY" />
                                    <span class="hint">@WebStrings.ProvidersSettingsEnvVarHint</span>
                                    @Error("apiKeyRef")
                                </details>
                            </div>
                        </div>

                        <div class="row">
                            <button type="button" class="btn" aria-busy="@Flag(_testing)" disabled="@_testing" @onclick="TestAsync">@WebStrings.ProvidersSettingsCheckConnectionButton</button>
                            @if (_test is not null)
                            {
                                <span class="alert @(_test.Success ? "alert-success" : "alert-error")" role="status">@_test.LocalizedMessage</span>
                            }
                        </div>

                    </div>

                    <div class="card stack">
                        <div class="card-header">
                            <h2>@WebStrings.ProvidersSettingsModelsHeading</h2>
                            <button type="button" class="btn btn-sm" @onclick="AddModel">@WebStrings.ProvidersSettingsAddModelButton</button>
                        </div>
                        @if (_test is { Success: true })
                        {
                            var available = _test.ModelIds.Where(id => _edit.Models.All(m => m.Id != id)).ToList();
                            if (available.Count > 0)
                            {
                                <div class="stack">
                                    <div class="row row-spread">
                                        <span class="label">@WebStrings.ProvidersSettingsServerModelsLabel</span>
                                        <span class="row">
                                            <button type="button" class="btn btn-sm" @onclick="() => _picked.UnionWith(available)">@WebStrings.ProvidersSettingsSelectAllButton</button>
                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_picked.Count == 0)" @onclick="AddPicked">@SelectedModelsLabel</button>
                                        </span>
                                    </div>
                                    <div class="fetched">
                                        @foreach (var id in available)
                                        {
                                            <label class="check"><input type="checkbox" checked="@_picked.Contains(id)" @onchange="e => TogglePicked(id, e)" /> <span class="mono">@id</span></label>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="muted">@WebStrings.ProvidersSettingsAllModelsAddedMessage</p>
                            }
                        }
                        @if (_edit.Models.Count == 0)
                        {
                            <p class="muted">@WebStrings.ProvidersSettingsNoModelsMessage</p>
                        }
                        else
                        {
                            <p class="hint">@WebStrings.ProvidersSettingsModelLimitsHint</p>
                            <div class="models">
                                @for (var i = 0; i < _edit.Models.Count; i++)
                                {
                                    var index = i;
                                    var model = _edit.Models[i];
                                    <div class="model" @key="model">
                                        <div class="model-main">
                                            <div class="field">
                                                <label for="m-id-@index">@WebStrings.ProvidersSettingsModelIdLabel</label>
                                                <input id="m-id-@index" class="input mono" aria-invalid="@Invalid($"models[{index}].id")" @bind="model.Id" />
                                            </div>
                                            <div class="field">
                                                <label for="m-name-@index">@WebStrings.ProvidersSettingsModelNameLabel <span class="muted">(@WebStrings.McpServerFormOptional)</span></label>
                                                <input id="m-name-@index" class="input" @bind="model.DisplayName" placeholder="@model.Id" />
                                            </div>
                                            <div class="field">
                                                <label for="m-ctx-@index">@WebStrings.ProvidersSettingsContextWindowLabel</label>
                                                <input id="m-ctx-@index" class="input num" type="number" min="1" aria-invalid="@Invalid($"models[{index}].contextWindow")" @bind="model.ContextWindow" />
                                            </div>
                                            <div class="field">
                                                <label for="m-out-@index">@WebStrings.ProvidersSettingsMaxOutputLabel</label>
                                                <input id="m-out-@index" class="input num" type="number" min="1" aria-invalid="@Invalid($"models[{index}].maxOutputTokens")" @bind="model.MaxOutputTokens" />
                                            </div>
                                        </div>
                                        <div class="row row-spread">
                                            <span class="row">
                                                <label class="check"><input type="checkbox" @bind="model.Reasoning" /> @WebStrings.ProvidersSettingsThinkingLabel</label>
                                                <label class="check"><input type="checkbox" @bind="model.Image" /> @WebStrings.ProvidersSettingsImagesLabel</label>
                                                @if (IsDefault(model))
                                                {
                                                    <span class="badge badge-accent">@WebStrings.ProvidersSettingsDefaultModelBadge</span>
                                                }
                                            </span>
                                            <span class="row">
                                                <button type="button" class="btn btn-sm" aria-label="@TuneModelLabel(model.Id)" @onclick="() => _tuning = model">@WebStrings.ProvidersSettingsTuneModelButton</button>
                                                @if (!IsDefault(model) && IsSaved(model))
                                                {
                                                    <button type="button" class="btn btn-sm" @onclick="() => MakeDefaultAsync(model)">@WebStrings.ProvidersSettingsMakeDefault</button>
                                                }
                                                <button type="button" class="btn btn-sm btn-ghost btn-danger" aria-label="@RemoveModelLabel(model.Id)" @onclick="() => _edit.Models.Remove(model)">@WebStrings.ProvidersSettingsRemoveModelButton</button>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @foreach (var issue in ModelIssues())
                            {
                                <span class="error-text">@issue.LocalizedMessage</span>
                            }
                        }
                    </div>

                    <details class="card stack">
                        <summary class="label">@WebStrings.ProvidersSettingsCompatibilityHeading</summary>
                        <span class="hint">@WebStrings.ProvidersSettingsCompatibilityHint</span>
                        <div class="form-grid">
                            <div class="field">
                                <label for="p-think">@WebStrings.ProvidersSettingsThinkingLevelLabel</label>
                                <select id="p-think" class="select" @bind="_edit.ThinkingMode">
                                    @foreach (var mode in Enum.GetValues<ThinkingSendMode>())
                                    {
                                        <option value="@mode">@ThinkingSendLabels.Option(mode)</option>
                                    }
                                </select>
                                <span class="hint">@WebStrings.ProvidersSettingsThinkingLevelHint</span>
                            </div>
                            @if (_edit.ThinkingMode == ThinkingSendMode.BodyField)
                            {
                                <div class="field">
                                    <label for="p-field">@WebStrings.ProvidersSettingsThinkingFieldLabel</label>
                                    <input id="p-field" class="input mono" @bind="_edit.ThinkingField" placeholder="chat_template_kwargs.enable_thinking" />
                                    @Error("thinkingSend.field")
                                </div>
                            }
                        </div>
                        <label class="check"><input type="checkbox" @bind="_edit.SendStreamUsage" /> @ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ProvidersSettingsStreamUsage))</label>
                        <label class="check"><input type="checkbox" @bind="_edit.LegacyMaxTokens" /> @ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ProvidersSettingsLegacyMaxTokens))</label>
                        <div class="stack">
                            <div class="row row-spread">
                                <span class="label">@WebStrings.ProvidersSettingsExtraHeadersLabel <span class="muted">(@WebStrings.McpServerFormOptional)</span></span>
                                <button type="button" class="btn btn-sm" @onclick="() => _edit.Headers.Add(new HeaderRow())">@WebStrings.ProvidersSettingsAddHeaderButton</button>
                            </div>
                            @foreach (var header in _edit.Headers)
                            {
                                <div class="input-group" @key="header">
                                    <input class="input mono" aria-label="@WebStrings.ProvidersSettingsHeaderNameLabel" placeholder="@WebStrings.ProvidersSettingsHeaderNamePlaceholder" @bind="header.Name" />
                                    <input class="input mono" aria-label="@WebStrings.ProvidersSettingsHeaderValueLabel" placeholder="@WebStrings.ProvidersSettingsHeaderValuePlaceholder" @bind="header.Value" />
                                    <button type="button" class="btn btn-ghost btn-danger" aria-label="@WebStrings.ProvidersSettingsRemoveHeaderLabel" @onclick="() => _edit.Headers.Remove(header)"><Icon Name="close" /></button>
                                </div>
                            }
                        </div>
                    </details>

                    @if (_issues.Count > 0)
                    {
                        <Alert>
                            <strong>@WebStrings.ProvidersSettingsValidationHeading</strong>
                            <ul>@foreach (var issue in _issues) { <li>@issue.LocalizedMessage</li> }</ul>
                        </Alert>
                    }

                    @if (!_edit.IsNew)
                    {
                        <div><button type="button" class="btn btn-danger" @onclick="() => _confirmDelete = true">@WebStrings.ProvidersSettingsRemoveProviderButton</button></div>
                    }

                    @if (IsDirty)
                    {
                        <div class="save-bar" role="region" aria-label="@WebStrings.ProvidersSettingsSaveBarLabel">
                            <span>@(_edit.IsNew ? WebStrings.ProvidersSettingsNotSaved : WebStrings.ProvidersSettingsUnsavedChanges)</span>
                            <span class="row">
                                <button type="button" class="btn btn-ghost" @onclick="Cancel">@(_edit.IsNew ? WebStrings.McpServerFormCancel : WebStrings.ProvidersSettingsDiscard)</button>
                                <button type="submit" class="btn btn-primary" aria-busy="@Flag(_saving)" disabled="@_saving">@WebStrings.ProvidersSettingsSaveButton</button>
                            </span>
                        </div>
                    }
                </form>
            }
        </section>
    </div>
</div>

<ModelTuning Provider="_edit" Model="_tuning" Open="_tuning is not null" OnClose="() => _tuning = null" />

<ConfirmDialog Title="@WebStrings.ProvidersSettingsRemoveDialogTitle" Open="_confirmDelete" ConfirmText="@WebStrings.ProvidersSettingsRemoveConfirmButton" OnConfirm="RemoveAsync" OnCancel="() => _confirmDelete = false">
    <p>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.ProvidersSettingsRemoveWarning), new Dictionary<string, object?> { ["name"] = _edit?.DisplayName })</p>
</ConfirmDialog>

@code {
    private readonly HashSet<string> _picked = [];
    private ProviderEditModel? _edit;
    private IReadOnlyList<ValidationIssue> _issues = [];
    private ConnectionTestResult? _test;
    private ModelEditModel? _tuning;
    private bool _hasStoredKey;
    private bool _testing;
    private static string SaveFailure => WebStrings.ProvidersSettingsSaveFailure;

    private bool _saving;
    private bool _confirmDelete;
    private string? _baseline;

    private bool ShowList => Service.Configured.Count > 1 || _edit is null or { IsNew: true };

    private string SelectedModelsLabel =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ProvidersSettingsAddSelectedModels),
            new Dictionary<string, object?>
            {
                ["count"] = _picked.Count,
                ["formattedCount"] = _picked.Count.ToString("N0", CultureInfo.CurrentCulture),
            });

    private static string ModelCountLabel(int count) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.ProvidersSettingsModelCount),
            new Dictionary<string, object?>
            {
                ["count"] = count,
                ["formattedCount"] = count.ToString("N0", CultureInfo.CurrentCulture),
            });

    private static string TuneModelLabel(string id) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.ProvidersSettingsTuneModel), new Dictionary<string, object?> { ["model"] = id });

    private static string RemoveModelLabel(string id) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.ProvidersSettingsRemoveModel), new Dictionary<string, object?> { ["model"] = id });

    private bool IsDirty => _edit is not null && (_edit.IsNew || _edit.NewApiKey.Length > 0 || Snapshot(_edit) != _baseline);

    private static string Snapshot(ProviderEditModel edit) => JsonSerializer.Serialize(edit.ToConfig(), JsonDefaults.Compact);

    public void Dispose()
    {
        Service.Changed -= OnProvidersChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Service.Changed += OnProvidersChanged;
        var cfg = Service.Config;
        var first = Service.Configured.FirstOrDefault(p => p.Id == cfg.DefaultProviderId) ?? Service.Configured.FirstOrDefault();
        if (first is not null)
        {
            Load(first);
            await RefreshKeyAsync();
        }
    }

    private void OnProvidersChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshKeyAsync()
    {
        _hasStoredKey = _edit is { IsNew: false } && Service.Configured.FirstOrDefault(p => p.Id == _edit.Id) is { } saved
            && await Service.HasKeyAsync(saved);
    }

    private void Load(ProviderConfig? provider)
    {
        _edit = provider is null ? null : ProviderEditModel.FromConfig(provider);
        _baseline = _edit is null ? null : Snapshot(_edit);
    }

    private async Task Select(ProviderConfig provider)
    {
        Load(provider);
        ResetFeedback();
        await RefreshKeyAsync();
    }

    private void StartNew()
    {
        _edit = new ProviderEditModel { IsNew = true };
        _hasStoredKey = false;
        ResetFeedback();
    }

    private async Task Cancel()
    {
        var saved = _edit is { IsNew: false } ? Service.Configured.FirstOrDefault(p => p.Id == _edit.Id) : null;
        Load(saved ?? Service.Configured.FirstOrDefault(p => p.Id == Service.Config.DefaultProviderId) ?? Service.Configured.FirstOrDefault());
        ResetFeedback();
        await RefreshKeyAsync();
    }

    private void ResetFeedback()
    {
        _issues = [];
        _test = null;
        _picked.Clear();
    }

    private async Task TestAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _testing = true;
        _test = null;
        try
        {
            var config = _edit.ToConfig();
            var key = string.IsNullOrEmpty(_edit.NewApiKey) ? await Service.ResolveKeyAsync(config) : _edit.NewApiKey;
            _test = await ProviderConnectionTester.TestAsync(config, key, HttpFactory.CreateClient(ProviderConnectionTester.HttpClientName), time: Time);
        }
        finally
        {
            _testing = false;
        }
    }

    private void TogglePicked(string id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _picked.Add(id);
        }
        else
        {
            _picked.Remove(id);
        }
    }

    private void AddPicked()
    {
        foreach (var id in _picked.Order(StringComparer.OrdinalIgnoreCase))
        {
            _edit!.Models.Add(new ModelEditModel { Id = id });
        }

        _picked.Clear();
    }

    private void AddModel() => _edit!.Models.Add(new ModelEditModel());

    private bool IsSaved(ModelEditModel model) =>
        _edit is { IsNew: false } && Service.Configured.Any(p => p.Id == _edit.Id && p.Models.Any(m => m.Id == model.Id));

    private bool IsDefault(ModelEditModel model) =>
        _edit is not null && Service.Config.DefaultProviderId == _edit.Id && Service.Config.DefaultModelId == model.Id;

    private async Task MakeDefaultAsync(ModelEditModel model)
    {
        var changed = false;
        if (await Toasts.TrySaveAsync(async () => changed = await Service.SetDefaultAsync(_edit!.Id, model.Id), SaveFailure) && changed)
        {
            Toasts.Show(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.ProvidersSettingsDefaultModelSet),
                new Dictionary<string, object?> { ["model"] = model.Id }), ToastKind.Success);
        }
    }

    private async Task SaveAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (_edit.IsNew)
            {
                _edit.Id = Service.NewId(_edit.DisplayName);
            }

            IReadOnlyList<ValidationIssue> issues = [];
            if (!await Toasts.TrySaveAsync(async () => issues = await Service.SaveAsync(_edit.ToConfig(), _edit.NewApiKey), SaveFailure))
            {
                return;
            }

            _issues = issues;
            if (_issues.Count > 0)
            {
                return;
            }

            _edit.IsNew = false;
            _edit.NewApiKey = string.Empty;
            _baseline = Snapshot(_edit);
            await RefreshKeyAsync();
            Toasts.Show(WebStrings.ProvidersSettingsProviderSaved, ToastKind.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ClearKeyAsync()
    {
        if (_edit is { IsNew: false })
        {
            if (!await Toasts.TrySaveAsync(() => Service.ClearKeyAsync(_edit.Id), SaveFailure))
            {
                return;
            }

            _edit.NewApiKey = string.Empty;
            await RefreshKeyAsync();
            Toasts.Show(WebStrings.ProvidersSettingsStoredKeyRemoved, ToastKind.Success);
        }
    }

    private async Task RemoveAsync()
    {
        _confirmDelete = false;
        if (_edit is { IsNew: false })
        {
            var name = _edit.DisplayName;
            if (!await Toasts.TrySaveAsync(() => Service.RemoveAsync(_edit.Id), SaveFailure))
            {
                return;
            }

            Load(Service.Configured.FirstOrDefault(p => p.Id == Service.Config.DefaultProviderId) ?? Service.Configured.FirstOrDefault());
            ResetFeedback();
            await RefreshKeyAsync();
            Toasts.Show(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.ProvidersSettingsProviderRemoved),
                new Dictionary<string, object?> { ["name"] = name }), ToastKind.Success);
        }
    }

    private static string? Flag(bool value) => value ? "true" : null;

    private string? Invalid(string path) => _issues.Any(i => i.Path == path) ? "true" : null;

    private RenderFragment? Error(string path) => _issues.FirstOrDefault(i => i.Path == path) is { } issue
        ? @<span class="error-text">@issue.LocalizedMessage</span>
        : null;

    private IEnumerable<ValidationIssue> ModelIssues() => _issues.Where(i => i.Path.StartsWith("models[", StringComparison.Ordinal));
}
