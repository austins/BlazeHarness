@using System.Text.Json
@using BlazeHarness.Core.Config
@implements IDisposable
@inject ProviderService Service
@inject IHttpClientFactory HttpFactory
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="Providers">Connect any OpenAI-compatible endpoint. Keys are kept in @Service.Secrets.Name@(Service.Secrets.IsSecure ? "." : ", which is not encrypted. Install a system keyring to store keys more securely.")</PageHeader>

    <div class="split">
        @if (ShowList)
        {
        <aside class="stack" aria-label="Configured providers">
            <div class="list">
                @foreach (var provider in Service.Configured)
                {
                    var isCurrent = _edit is { IsNew: false } && _edit.Id == provider.Id;
                    <button type="button" class="list-item" aria-current="@(isCurrent ? "true" : "false")" @onclick="() => Select(provider)">
                        <span>@provider.DisplayName @if (Service.Config.DefaultProviderId == provider.Id) { <span class="badge badge-accent">default</span> }</span>
                        <span class="sub">@provider.Models.Count model@(provider.Models.Count == 1 ? "" : "s") · @provider.BaseUrl</span>
                    </button>
                }
            </div>
            <button type="button" class="btn btn-add" @onclick="() => StartNew(null, null)"><Icon Name="plus" /> Add provider</button>
        </aside>
        }

        <section>
            @if (_edit is null)
            {
                <div class="card empty">
                    @if (Service.Configured.Count == 0)
                    {
                        <h2>Connect your first provider</h2>
                        <p>Pick a starting point, or add any OpenAI-compatible endpoint.</p>
                        <div class="row">
                            @foreach (var (name, url) in QuickStarts)
                            {
                                <button type="button" class="btn" @onclick="() => StartNew(name, url)">@name</button>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Select a provider to edit it, or add a new one.</p>
                    }
                </div>
            }
            else
            {
                <form @onsubmit="SaveAsync" class="stack" autocomplete="off" novalidate>
                    <div class="card stack">
                        <div class="card-header">
                            <h2>@(_edit.IsNew ? "New provider" : _edit.DisplayName)</h2>
                            @if (!ShowList)
                            {
                                <button type="button" class="btn btn-sm" @onclick="() => StartNew(null, null)"><Icon Name="plus" /> Add provider</button>
                            }
                        </div>

                        <div class="form-grid">
                            <div class="field">
                                <label for="p-name">Name</label>
                                <input id="p-name" class="input" aria-invalid="@Invalid("displayName")" @bind="_edit.DisplayName" @bind:event="oninput" placeholder="e.g. DeepSeek" />
                                @Error("displayName")
                            </div>
                            <div class="field">
                                <label for="p-url">Base URL</label>
                                <input id="p-url" class="input mono" aria-invalid="@Invalid("baseUrl")" @bind="_edit.BaseUrl" @bind:event="oninput" placeholder="https://api.example.com/v1" inputmode="url" />
                                @Error("baseUrl")
                            </div>
                            <div class="field">
                                <label for="p-key">API key <span class="muted">(optional)</span></label>
                                <SecretInput Id="p-key" @bind-Value="_edit.NewApiKey" HasStoredKey="_hasStoredKey" OnRemoveStored="ClearKeyAsync" Placeholder="Optional for local servers" />
                                <span class="hint">Local servers usually need none. A stored key is never shown again; leave blank to keep it.</span>
                                <details class="key-env" open="@(!string.IsNullOrWhiteSpace(_edit.ApiKeyEnvVar))">
                                    <summary>Read it from an environment variable</summary>
                                    <input id="p-env" class="input mono" aria-label="Environment variable name" @bind="_edit.ApiKeyEnvVar" placeholder="DEEPSEEK_API_KEY" />
                                    <span class="hint">When set, this replaces the stored key.</span>
                                    @Error("apiKeyRef")
                                </details>
                            </div>
                        </div>

                        <div class="row">
                            <button type="button" class="btn" aria-busy="@Flag(_testing)" disabled="@_testing" @onclick="TestAsync">Check connection &amp; list models</button>
                            @if (_test is not null)
                            {
                                <span class="alert @(_test.Success ? "alert-success" : "alert-error")" role="status">@_test.Message</span>
                            }
                        </div>

                    </div>

                    <div class="card stack">
                        <div class="card-header">
                            <h2>Models</h2>
                            <button type="button" class="btn btn-sm" @onclick="AddModel">＋ Add model</button>
                        </div>
                        @if (_test is { Success: true })
                        {
                            var available = _test.ModelIds.Where(id => _edit.Models.All(m => m.Id != id)).ToList();
                            if (available.Count > 0)
                            {
                                <div class="stack">
                                    <div class="row row-spread">
                                        <span class="label">Models on this server</span>
                                        <span class="row">
                                            <button type="button" class="btn btn-sm" @onclick="() => _picked.UnionWith(available)">Select all</button>
                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_picked.Count == 0)" @onclick="AddPicked">Add selected (@_picked.Count)</button>
                                        </span>
                                    </div>
                                    <div class="fetched">
                                        @foreach (var id in available)
                                        {
                                            <label class="check"><input type="checkbox" checked="@_picked.Contains(id)" @onchange="e => TogglePicked(id, e)" /> <span class="mono">@id</span></label>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="muted">Every model the server lists has been added.</p>
                            }
                        }
                        @if (_edit.Models.Count == 0)
                        {
                            <p class="muted">No models yet. Use Check connection &amp; list models above, or add one by hand.</p>
                        }
                        else
                        {
                            <p class="hint">Servers rarely report limits, so check these. Context window feeds compaction, and max output must be smaller than it.</p>
                            <div class="models">
                                @for (var i = 0; i < _edit.Models.Count; i++)
                                {
                                    var index = i;
                                    var model = _edit.Models[i];
                                    <div class="model" @key="model">
                                        <div class="model-main">
                                            <div class="field">
                                                <label for="m-id-@index">Model id</label>
                                                <input id="m-id-@index" class="input mono" aria-invalid="@Invalid($"models[{index}].id")" @bind="model.Id" @bind:after="() => ApplyPreset(model)" />
                                            </div>
                                            <div class="field">
                                                <label for="m-name-@index">Name <span class="muted">(optional)</span></label>
                                                <input id="m-name-@index" class="input" @bind="model.DisplayName" placeholder="@model.Id" />
                                            </div>
                                            <div class="field">
                                                <label for="m-ctx-@index">Context window</label>
                                                <input id="m-ctx-@index" class="input num" type="number" min="1" aria-invalid="@Invalid($"models[{index}].contextWindow")" @bind="model.ContextWindow" />
                                            </div>
                                            <div class="field">
                                                <label for="m-out-@index">Max output</label>
                                                <input id="m-out-@index" class="input num" type="number" min="1" aria-invalid="@Invalid($"models[{index}].maxOutputTokens")" @bind="model.MaxOutputTokens" />
                                            </div>
                                        </div>
                                        <div class="row row-spread">
                                            <span class="row">
                                                <label class="check"><input type="checkbox" @bind="model.Reasoning" /> Thinking</label>
                                                <label class="check"><input type="checkbox" @bind="model.Image" /> Images</label>
                                                @if (IsDefault(model))
                                                {
                                                    <span class="badge badge-accent">default</span>
                                                }
                                            </span>
                                            <span class="row">
                                                <button type="button" class="btn btn-sm" aria-label="Tune @model.Id" @onclick="() => _tuning = model">Tune thinking &amp; sampling</button>
                                                @if (!IsDefault(model) && IsSaved(model))
                                                {
                                                    <button type="button" class="btn btn-sm" @onclick="() => MakeDefaultAsync(model)">Make default</button>
                                                }
                                                <button type="button" class="btn btn-sm btn-ghost btn-danger" aria-label="Remove model @model.Id" @onclick="() => _edit.Models.Remove(model)">Remove</button>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @foreach (var issue in ModelIssues())
                            {
                                <span class="error-text">@issue.Message</span>
                            }
                        }
                    </div>

                    <details class="card stack">
                        <summary class="label">Compatibility</summary>
                        <span class="hint">Only change these if the server rejects requests or ignores thinking.</span>
                        <div class="form-grid">
                            <div class="field">
                                <label for="p-think">Thinking level sent as</label>
                                <select id="p-think" class="select" @bind="_edit.ThinkingMode">
                                    @foreach (var mode in Enum.GetValues<ThinkingSendMode>())
                                    {
                                        <option value="@mode">@ThinkingSendLabels.Option(mode)</option>
                                    }
                                </select>
                                <span class="hint">For every model, unless a model picks its own when you tune it.</span>
                            </div>
                            @if (_edit.ThinkingMode == ThinkingSendMode.BodyField)
                            {
                                <div class="field">
                                    <label for="p-field">Body field</label>
                                    <input id="p-field" class="input mono" @bind="_edit.ThinkingField" placeholder="chat_template_kwargs.enable_thinking" />
                                    @Error("thinkingSend.field")
                                </div>
                            }
                        </div>
                        <label class="check"><input type="checkbox" @bind="_edit.SendStreamUsage" /> Ask for token usage while streaming (turn off if the server rejects <code>stream_options</code>)</label>
                        <label class="check"><input type="checkbox" @bind="_edit.LegacyMaxTokens" /> Send <code>max_tokens</code> (most compatible servers) instead of <code>max_completion_tokens</code></label>
                        <div class="stack">
                            <div class="row row-spread">
                                <span class="label">Extra headers <span class="muted">(optional)</span></span>
                                <button type="button" class="btn btn-sm" @onclick="() => _edit.Headers.Add(new HeaderRow())">＋ Add header</button>
                            </div>
                            @foreach (var header in _edit.Headers)
                            {
                                <div class="input-group" @key="header">
                                    <input class="input mono" aria-label="Header name" placeholder="Name" @bind="header.Name" />
                                    <input class="input mono" aria-label="Header value" placeholder="Value" @bind="header.Value" />
                                    <button type="button" class="btn btn-ghost btn-danger" aria-label="Remove header" @onclick="() => _edit.Headers.Remove(header)"><Icon Name="close" /></button>
                                </div>
                            }
                        </div>
                    </details>

                    @if (_issues.Count > 0)
                    {
                        <Alert>
                            <strong>Fix these before saving:</strong>
                            <ul>@foreach (var issue in _issues) { <li>@issue.Message</li> }</ul>
                        </Alert>
                    }

                    @if (!_edit.IsNew)
                    {
                        <div><button type="button" class="btn btn-danger" @onclick="() => _confirmDelete = true">Remove provider</button></div>
                    }

                    @if (IsDirty)
                    {
                        <div class="save-bar" role="region" aria-label="Unsaved changes">
                            <span>@(_edit.IsNew ? "This provider isn't saved yet." : "You have unsaved changes.")</span>
                            <span class="row">
                                <button type="button" class="btn btn-ghost" @onclick="Cancel">@(_edit.IsNew ? "Cancel" : "Discard")</button>
                                <button type="submit" class="btn btn-primary" aria-busy="@Flag(_saving)" disabled="@_saving">Save provider</button>
                            </span>
                        </div>
                    }
                </form>
            }
        </section>
    </div>
</div>

<ModelTuning Provider="_edit" Model="_tuning" Open="_tuning is not null" OnClose="() => _tuning = null" />

<ConfirmDialog Title="Remove provider?" Open="_confirmDelete" ConfirmText="Remove" OnConfirm="RemoveAsync" OnCancel="() => _confirmDelete = false">
    <p>This removes <strong>@_edit?.DisplayName</strong> and its stored API key. Existing chats that used it will need another provider.</p>
</ConfirmDialog>

@code {
    private static readonly (string Name, string Url)[] QuickStarts =
    [
        ("OpenAI", "https://api.openai.com/v1"),
        ("DeepSeek", "https://api.deepseek.com"),
        ("llama.cpp (local)", "http://localhost:8080/v1"),
        ("vLLM (local)", "http://localhost:8000/v1"),
        ("Ollama (local)", "http://localhost:11434/v1"),
    ];

    private readonly HashSet<string> _picked = [];
    private ProviderEditModel? _edit;
    private IReadOnlyList<ValidationIssue> _issues = [];
    private ConnectionTestResult? _test;
    private ModelEditModel? _tuning;
    private bool _hasStoredKey;
    private bool _testing;
    private const string SaveFailure = "The provider settings could not be saved because the settings file or the key store could not be written.";

    private bool _saving;
    private bool _confirmDelete;
    private string? _baseline;

    private bool ShowList => Service.Configured.Count > 1 || _edit is null or { IsNew: true };

    private bool IsDirty => _edit is not null && (_edit.IsNew || _edit.NewApiKey.Length > 0 || Snapshot(_edit) != _baseline);

    private static string Snapshot(ProviderEditModel edit) => JsonSerializer.Serialize(edit.ToConfig(), JsonDefaults.Compact);

    public void Dispose()
    {
        Service.Changed -= OnProvidersChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Service.Changed += OnProvidersChanged;
        var cfg = Service.Config;
        var first = Service.Configured.FirstOrDefault(p => p.Id == cfg.DefaultProviderId) ?? Service.Configured.FirstOrDefault();
        if (first is not null)
        {
            Load(first);
            await RefreshKeyAsync();
        }
    }

    private void OnProvidersChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshKeyAsync()
    {
        _hasStoredKey = _edit is { IsNew: false } && Service.Configured.FirstOrDefault(p => p.Id == _edit.Id) is { } saved
            && await Service.HasKeyAsync(saved);
    }

    private void Load(ProviderConfig? provider)
    {
        _edit = provider is null ? null : ProviderEditModel.FromConfig(provider);
        _baseline = _edit is null ? null : Snapshot(_edit);
    }

    private async Task Select(ProviderConfig provider)
    {
        Load(provider);
        ResetFeedback();
        await RefreshKeyAsync();
    }

    private void StartNew(string? name, string? url)
    {
        _edit = new ProviderEditModel { IsNew = true, DisplayName = name ?? string.Empty, BaseUrl = url ?? string.Empty };
        _hasStoredKey = false;
        ResetFeedback();
    }

    private async Task Cancel()
    {
        var saved = _edit is { IsNew: false } ? Service.Configured.FirstOrDefault(p => p.Id == _edit.Id) : null;
        Load(saved ?? Service.Configured.FirstOrDefault(p => p.Id == Service.Config.DefaultProviderId) ?? Service.Configured.FirstOrDefault());
        ResetFeedback();
        await RefreshKeyAsync();
    }

    private void ResetFeedback()
    {
        _issues = [];
        _test = null;
        _picked.Clear();
    }

    private async Task TestAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _testing = true;
        _test = null;
        try
        {
            var config = _edit.ToConfig();
            var key = string.IsNullOrEmpty(_edit.NewApiKey) ? await Service.ResolveKeyAsync(config) : _edit.NewApiKey;
            _test = await ProviderConnectionTester.TestAsync(config, key, HttpFactory.CreateClient());
        }
        finally
        {
            _testing = false;
        }
    }

    private void TogglePicked(string id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _picked.Add(id);
        }
        else
        {
            _picked.Remove(id);
        }
    }

    private void AddPicked()
    {
        foreach (var id in _picked.Order(StringComparer.OrdinalIgnoreCase))
        {
            _edit!.Models.Add(ModelEditModel.FromId(id));
        }

        _picked.Clear();
    }

    private void AddModel() => _edit!.Models.Add(new ModelEditModel());

    private static void ApplyPreset(ModelEditModel model)
    {
        if (model.ContextWindow == 0 && model.MaxOutputTokens == 0 && ModelPreset.Find(model.Id) is { } preset)
        {
            model.ContextWindow = preset.ContextWindow;
            model.MaxOutputTokens = preset.MaxOutputTokens;
            model.Reasoning = preset.Reasoning;
            model.Image = preset.Image;
        }
    }

    private bool IsSaved(ModelEditModel model) =>
        _edit is { IsNew: false } && Service.Configured.Any(p => p.Id == _edit.Id && p.Models.Any(m => m.Id == model.Id));

    private bool IsDefault(ModelEditModel model) =>
        _edit is not null && Service.Config.DefaultProviderId == _edit.Id && Service.Config.DefaultModelId == model.Id;

    private async Task MakeDefaultAsync(ModelEditModel model)
    {
        var changed = false;
        if (await Toasts.TrySaveAsync(async () => changed = await Service.SetDefaultAsync(_edit!.Id, model.Id), SaveFailure) && changed)
        {
            Toasts.Show($"{model.Id} is now the default model.", ToastKind.Success);
        }
    }

    private async Task SaveAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (_edit.IsNew)
            {
                _edit.Id = Service.NewId(_edit.DisplayName);
            }

            IReadOnlyList<ValidationIssue> issues = [];
            if (!await Toasts.TrySaveAsync(async () => issues = await Service.SaveAsync(_edit.ToConfig(), _edit.NewApiKey), SaveFailure))
            {
                return;
            }

            _issues = issues;
            if (_issues.Count > 0)
            {
                return;
            }

            _edit.IsNew = false;
            _edit.NewApiKey = string.Empty;
            _baseline = Snapshot(_edit);
            await RefreshKeyAsync();
            Toasts.Show("Provider saved.", ToastKind.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ClearKeyAsync()
    {
        if (_edit is { IsNew: false })
        {
            if (!await Toasts.TrySaveAsync(() => Service.ClearKeyAsync(_edit.Id), SaveFailure))
            {
                return;
            }

            _edit.NewApiKey = string.Empty;
            await RefreshKeyAsync();
            Toasts.Show("Stored key removed.", ToastKind.Success);
        }
    }

    private async Task RemoveAsync()
    {
        _confirmDelete = false;
        if (_edit is { IsNew: false })
        {
            var name = _edit.DisplayName;
            if (!await Toasts.TrySaveAsync(() => Service.RemoveAsync(_edit.Id), SaveFailure))
            {
                return;
            }

            Load(Service.Configured.FirstOrDefault(p => p.Id == Service.Config.DefaultProviderId) ?? Service.Configured.FirstOrDefault());
            ResetFeedback();
            await RefreshKeyAsync();
            Toasts.Show($"Removed {name}.", ToastKind.Success);
        }
    }

    private static string? Flag(bool value) => value ? "true" : null;

    private string? Invalid(string path) => _issues.Any(i => i.Path == path) ? "true" : null;

    private RenderFragment? Error(string path) => _issues.FirstOrDefault(i => i.Path == path) is { } issue
        ? @<span class="error-text">@issue.Message</span>
        : null;

    private IEnumerable<ValidationIssue> ModelIssues() => _issues.Where(i => i.Path.StartsWith("models[", StringComparison.Ordinal));
}
