@using BlazeHarness.Core.Compaction
@using System.Globalization
@using BlazeHarness.Core.Mcp
@using BlazeHarness.Core.Mcp.Config
@using BlazeHarness.Core.Permissions
@implements IDisposable
@inject McpConfigFile File
@inject McpManager Manager
@inject McpServerEditor Editor
@inject PermissionDefaults Defaults
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.McpSettingsTitle">@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.McpSettingsHeader), new Dictionary<string, object?> { ["file"] = File.FilePath })</PageHeader>

    <Alert Kind="AlertKind.Warning">
        <Icon Name="alert" />
        <span>@WebStrings.McpSettingsInstallWarning</span>
    </Alert>

    @if (_status is not null)
    {
        <div class="alert @(_statusIsError ? "alert-error" : "alert-success")" role="status">@_status</div>
    }

    <section class="card stack" aria-labelledby="servers-heading">
        <div class="row row-spread">
            <h2 id="servers-heading">@WebStrings.McpSettingsServersHeading</h2>
            <button type="button" class="btn" disabled="@(_draft is not null)" @onclick="StartNew">@WebStrings.McpSettingsAddServer</button>
        </div>
        @if (_draft is { IsNew: true })
        {
            <McpServerForm Draft="_draft" OnSaved="Saved" OnCancel="CancelEdit" />
            <hr />
        }
        @if (_statuses.Count == 0 && _draft is null)
        {
            <p class="muted">@WebStrings.McpSettingsNoServers</p>
        }
        <div class="skill-list">
            @foreach (var status in _statuses)
            {
                var server = status.Config;
                var literals = McpSecrets.LiteralsIn(server);
                <div class="skill-item" role="group" aria-label="@server.Name" @key="server.Name">
                    <details>
                        <summary>
                            <Icon Name="chevron-right" />
                            <span class="skill-title">
                                <span class="row">
                                    <strong>@server.Name</strong>
                                    <span class="badge @StateBadge(status)">@StateText(status)</span>
                                    @if (literals.Count > 0)
                                    {
                                        <span class="badge badge-warning">@WebStrings.McpSettingsSecretBadge</span>
                                    }
                                </span>
                                <span class="skill-blurb">@TransportText(server)</span>
                            </span>
                        </summary>
                        <div class="skill-body stack">
                            <p class="hint mono">@TransportText(server)</p>
                            @if (_draft is { IsNew: false } editing && editing.Name == server.Name)
                            {
                                <McpServerForm Draft="_draft" OnSaved="Saved" OnCancel="CancelEdit" />
                            }
                            @if (status.Error is { } error)
                            {
                                <p class="error-text">@error</p>
                            }
                            @if (literals.Count > 0)
                            {
                                <Alert Kind="AlertKind.Warning">
                                    <Icon Name="alert" />
                                    <span>@SecretWarning(literals)</span>
                                </Alert>
                            }
                            <div class="row">
                                <label class="check">
                                    <input type="checkbox" checked="@Defaults.IsMcpServerTrusted(server.Name)" @onchange="e => SetTrustedAsync(server.Name, (bool)e.Value!)" />
                                    <span>@WebStrings.McpSettingsTrustReadOnly</span>
                                </label>
                            </div>
                            <div class="row">
                                <button type="button" class="btn btn-sm" disabled="@_busy.Contains(server.Name)" @onclick="() => TestAsync(server.Name)">
                                    @(_busy.Contains(server.Name) ? WebStrings.McpSettingsConnecting : WebStrings.McpSettingsTestConnection)
                                </button>
                                <button type="button" class="btn btn-sm" disabled="@(status.State is McpServerState.Stopped)" @onclick="() => StopAsync(server.Name)">@WebStrings.McpSettingsStop</button>
                                <button type="button" class="btn btn-sm" disabled="@(_draft is not null)" @onclick="() => EditAsync(server)">@WebStrings.McpSettingsEdit</button>
                                <button type="button" class="btn btn-sm btn-ghost btn-danger" aria-label="@RemoveServerLabel(server.Name)" @onclick="() => _removing = server.Name">@WebStrings.McpSettingsRemove</button>
                            </div>
                            @if (status.Tools.Count > 0)
                            {
                                var visible = status.Tools.Where(t => !server.IsExcluded(t.Name)).ToList();
                                var loaded = visible.Count(t => server.LoadsAlways(t.Name));
                                <p class="hint">
                                    @ToolCountLabel(visible.Count):
                                    @if (visible.Count == 0)
                                    {
                                        <text>@WebStrings.McpSettingsNoToolsOffered</text>
                                    }
                                    else if (loaded == visible.Count)
                                    {
                                        <text>@AlwaysLoadedHint(status.PromptCharacters)</text>
                                    }
                                    else
                                    {
                                        <text>@SearchLoadedHint(status.PromptCharacters)</text>
                                    }
                                </p>
                                <details>
                                    <summary><Icon Name="chevron-right" /> @ToolsSummary(visible.Count, status.Tools.Count)</summary>
                                    <ul class="stack tool-list">
                                        @foreach (var tool in status.Tools)
                                        {
                                            var excluded = server.IsExcluded(tool.Name);
                                            var byPattern = excluded && server.IsExcludedByPattern(tool.Name);
                                            <li>
                                                <label class="check tool-row" title="@(byPattern ? WebStrings.McpSettingsToolPatternTooltip : null)">
                                                    <input type="checkbox" aria-label="@ToolOfferedLabel(tool.Name)" checked="@(!excluded)" disabled="@byPattern" @onchange="e => SetToolOfferedAsync(server.Name, tool.Name, (bool)e.Value!)" />
                                                    <span><code class="mono">@tool.Name</code> <span class="muted">@FirstLine(tool.Description)</span></span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </details>
                    <label class="check" title="@WebStrings.McpSettingsNewChatsTooltip">
                        <input type="checkbox" aria-label="@WebStrings.McpSettingsNewChatsLabel" checked="@(!server.Disabled)" @onchange="e => SetEnabledAsync(server.Name, (bool)e.Value!)" />
                        <span>@WebStrings.McpSettingsOn</span>
                    </label>
                </div>
            }
        </div>
        <p class="hint">@WebStrings.McpSettingsTrustExplanation</p>
    </section>

    <details class="card stack" open="@_openAtStart">
        <summary class="label">@WebStrings.McpSettingsAdvancedSummary</summary>
        <div class="field">
            <label for="mcp-text">mcp.json</label>
            <textarea id="mcp-text" class="input mono" rows="14" spellcheck="false" aria-invalid="@(Problems.Count > 0 ? "true" : null)" aria-describedby="@(Problems.Count > 0 ? "mcp-problems" : null)" @bind="_text" @bind:event="oninput"></textarea>
            <span class="hint">@WebStrings.McpSettingsFileHint</span>
        </div>
        @if (Problems.Count > 0)
        {
            <div id="mcp-problems" role="alert">
                @foreach (var problem in Problems)
                {
                    <p class="error-text">@problem</p>
                }
            </div>
        }
        <div class="row">
            <button type="button" class="btn btn-primary" disabled="@(!Dirty || _saving || Problems.Count > 0)" @onclick="SaveAsync">@WebStrings.McpSettingsSave</button>
            <button type="button" class="btn" disabled="@(!Dirty)" @onclick="Revert">@WebStrings.McpSettingsRevert</button>
            <button type="button" class="btn" disabled="@(string.IsNullOrWhiteSpace(_text))" @onclick="FormatText">@WebStrings.McpSettingsFormat</button>
        </div>
    </details>
</div>

<ConfirmDialog Title="@WebStrings.McpSettingsRemoveDialogTitle" Open="_removing is not null" ConfirmText="@WebStrings.McpSettingsRemoveConfirm" OnConfirm="RemoveAsync" OnCancel="() => _removing = null">
    <p>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.McpSettingsRemoveWarning), new Dictionary<string, object?> { ["name"] = _removing })</p>
</ConfirmDialog>

@code {
    private readonly HashSet<string> _busy = new(StringComparer.Ordinal);
    private IReadOnlyList<McpServerStatus> _statuses = [];
    private IReadOnlyList<string> _problems = [];
    private string? _checkedText;
    private bool _openAtStart;
    private McpServerDraft? _draft;
    private string? _removing;
    private string _text = string.Empty;
    private string _loaded = string.Empty;
    private string? _status;
    private bool _statusIsError;
    private bool _saving;

    // Checked as the user types, so a mistake shows up before Save; the result is kept until the text changes.
    private IReadOnlyList<string> Problems
    {
        get
        {
            if (!string.Equals(_checkedText, _text, StringComparison.Ordinal))
            {
                _problems = McpConfigFile.Check(_text).Errors;
                _checkedText = _text;
            }

            return _problems;
        }
    }

    private bool Dirty => !string.Equals(_text, _loaded, StringComparison.Ordinal);

    public void Dispose()
    {
        File.Changed -= OnFileChanged;
        Manager.Changed -= OnManagerChanged;
    }

    protected override void OnInitialized()
    {
        _loaded = _text = File.Text;
        _openAtStart = Problems.Count > 0;
        _statuses = Manager.Statuses();
        File.Changed += OnFileChanged;
        Manager.Changed += OnManagerChanged;
    }

    private static string StateText(McpServerStatus status) => status.State switch
    {
        McpServerState.Connected => WebStrings.McpSettingsConnected,
        McpServerState.Connecting => WebStrings.McpSettingsConnecting,
        McpServerState.Failed => WebStrings.McpSettingsFailed,
        _ => status.Config.Disabled ? WebStrings.McpSettingsOff : WebStrings.McpSettingsNotStarted,
    };

    private static string StateBadge(McpServerStatus status) => status.State switch
    {
        McpServerState.Connected => "badge-success",
        McpServerState.Failed => "badge-warning",
        McpServerState.Connecting => "badge-accent",
        _ => string.Empty,
    };

    private static string TransportText(McpServerConfig server) => server.Transport switch
    {
        McpTransport.Stdio => ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsRunsCommand),
            new Dictionary<string, object?> { ["command"] = server.Command }),
        _ => server.Url ?? string.Empty,
    };

    private const int DescriptionLength = 120;
    private static string FileFailure => WebStrings.McpSettingsSaveFailure;

    private static MarkupString SecretWarning(IReadOnlyCollection<string> names) =>
        ResourceMessageFormatter.Web.FormatMarkup(
            nameof(WebStrings.McpSettingsSecretWarning),
            new Dictionary<string, object?> { ["names"] = string.Join(", ", names), ["reference"] = "${NAME}" });

    private static string RemoveServerLabel(string name) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsRemoveServerLabel),
            new Dictionary<string, object?> { ["name"] = name });

    private static string ToolCountLabel(int count) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsToolCount),
            new Dictionary<string, object?>
            {
                ["count"] = count,
                ["formattedCount"] = count.ToString("N0", CultureInfo.CurrentCulture),
            });

    private static string ToolsSummary(int offered, int total) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsToolsSummary),
            new Dictionary<string, object?> { ["offered"] = offered, ["total"] = total });

    private static string ToolOfferedLabel(string tool) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsToolOfferedLabel),
            new Dictionary<string, object?> { ["tool"] = tool });

    private static string AlwaysLoadedHint(int characters) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsAlwaysLoadedHint),
            new Dictionary<string, object?> { ["tokens"] = TokenEstimate.OfCharacters(characters) });

    private static string SearchLoadedHint(int characters) =>
        ResourceMessageFormatter.Web.Format(
            nameof(WebStrings.McpSettingsSearchLoadedHint),
            new Dictionary<string, object?> { ["tokens"] = TokenEstimate.OfCharacters(characters) });

    private static string FirstLine(string? description)
    {
        var line = description?.Split('\n', 2)[0].Trim() ?? string.Empty;
        return TextShortener.Shorten(line, DescriptionLength);
    }

    private void OnFileChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!Dirty)
            {
                _loaded = _text = File.Text;
            }

            _statuses = Manager.Statuses();
            StateHasChanged();
        });
    }

    private void OnManagerChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _statuses = Manager.Statuses();
            StateHasChanged();
        });
    }

    private void Say(string message, bool error = false)
    {
        _status = message;
        _statusIsError = error;
    }

    private async Task SetEnabledAsync(string name, bool enabled)
    {
        if (!await File.SetDisabledAsync(name, !enabled))
        {
            Say(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.McpSettingsChangeFailed),
                new Dictionary<string, object?> { ["name"] = name }), error: true);
        }
    }

    private async Task SetToolOfferedAsync(string server, string tool, bool offered)
    {
        if (!await File.SetToolExcludedAsync(server, tool, !offered))
        {
            Say(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.McpSettingsChangeFailed),
                new Dictionary<string, object?> { ["name"] = server }), error: true);
        }
    }

    private async Task SetTrustedAsync(string name, bool trusted)
    {
        await Toasts.TrySaveAsync(() => Defaults.SetMcpServerTrustedAsync(name, trusted), FileFailure);
    }

    private async Task TestAsync(string name)
    {
        _busy.Add(name);
        _status = null;
        try
        {
            await Manager.ReconnectAsync(name);
        }
        finally
        {
            _busy.Remove(name);
            _statuses = Manager.Statuses();
        }
    }

    private async Task StopAsync(string name)
    {
        await Manager.StopAsync(name);
        _statuses = Manager.Statuses();
    }

    private void StartNew()
    {
        _draft = McpServerEditor.NewDraft();
        _status = null;
    }

    private async Task EditAsync(McpServerConfig server)
    {
        _draft = await Editor.OpenAsync(server);
        _status = null;
    }

    private void CancelEdit() => _draft = null;

    private void Saved()
    {
        var name = _draft?.Name.Trim();
        var wasDirty = Dirty;
        _draft = null;
        _loaded = _text = File.Text;
        _statuses = Manager.Statuses();
        Say(wasDirty
            ? ResourceMessageFormatter.Web.Format(nameof(WebStrings.McpSettingsSavedDiscarded), new Dictionary<string, object?> { ["name"] = name })
            : ResourceMessageFormatter.Web.Format(nameof(WebStrings.McpSettingsSaved), new Dictionary<string, object?> { ["name"] = name }));
    }

    private async Task RemoveAsync()
    {
        var name = _removing;
        _removing = null;
        if (name is null)
        {
            return;
        }

        var removed = false;
        if (!await Toasts.TrySaveAsync(async () => removed = await Editor.RemoveAsync(name), FileFailure))
        {
            return;
        }

        if (!removed)
        {
            Say(ResourceMessageFormatter.Web.Format(
                nameof(WebStrings.McpSettingsRemoveFailed),
                new Dictionary<string, object?> { ["name"] = name }), error: true);
            return;
        }

        _loaded = _text = File.Text;
        _statuses = Manager.Statuses();
        Say(ResourceMessageFormatter.Web.Format(nameof(WebStrings.McpSettingsRemoved), new Dictionary<string, object?> { ["name"] = name }));
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            McpParseResult? result = null;
            if (!await Toasts.TrySaveAsync(async () => result = await File.SaveAsync(_text), FileFailure))
            {
                return;
            }

            if (result!.Errors.Count == 0)
            {
                _loaded = _text = File.Text;
                Say(WebStrings.McpSettingsSavedFile);
            }
            else
            {
                Say(WebStrings.McpSettingsFileHasProblems, error: true);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void Revert()
    {
        _text = _loaded;
        _status = null;
    }

    private void FormatText()
    {
        if (McpConfigEditor.Format(_text) is { } formatted)
        {
            _text = formatted;
        }
    }
}
