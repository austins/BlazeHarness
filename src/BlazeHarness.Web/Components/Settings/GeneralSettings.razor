@using System.Globalization
@using BlazeHarness.Core.Compaction
@using BlazeHarness.Core.Config
@inject IJSRuntime JS
@inject JsonFileStore<AppConfig> Config
@inject ToastService Toasts
@inject UiLanguages Languages

<div class="page">
    <PageHeader Title="@WebStrings.SettingsGeneralTitle">@WebStrings.SettingsGeneralDescription</PageHeader>

    <section class="card stack" aria-labelledby="language-heading">
        <h2 id="language-heading">@WebStrings.GeneralSettingsLanguage</h2>
        <label for="ui-language">@WebStrings.GeneralSettingsDisplayLanguage</label>
        <select id="ui-language" class="select" value="@Languages.Resolve(CultureInfo.CurrentUICulture)" @onchange="OnLanguageChangedAsync">
            @foreach (var language in Languages.All)
            {
                <option value="@language.Culture">@language.DisplayName</option>
            }
        </select>
    </section>

    <section class="card stack" aria-labelledby="compaction-heading">
        <h2 id="compaction-heading">@WebStrings.GeneralSettingsCompactionHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@(Config.Current.Compaction == CompactionMode.Extractive)" @onchange="OnCompactionChangedAsync" />
            <span>@WebStrings.GeneralSettingsCompactionLabel</span>
        </label>
        <p class="hint">@WebStrings.GeneralSettingsCompactionDescription</p>
    </section>

    <section class="card stack" aria-labelledby="todos-heading">
        <h2 id="todos-heading">@WebStrings.GeneralSettingsTodosHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@Config.Current.TodosEnabled" @onchange="OnTodosChangedAsync" />
            <span>@WebStrings.GeneralSettingsTodosLabel</span>
        </label>
        <p class="hint">@WebStrings.GeneralSettingsTodosDescription</p>
    </section>

    <section class="card stack" aria-labelledby="chat-width-heading">
        <h2 id="chat-width-heading">@WebStrings.GeneralSettingsChatWidthHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@_fullChatWidth" @onchange="OnChatWidthChangedAsync" />
            <span>@WebStrings.GeneralSettingsFullWidthLabel</span>
        </label>
        <p class="hint">@WebStrings.GeneralSettingsFullWidthHint</p>
    </section>

    <section class="card stack" aria-labelledby="text-size-heading">
        <h2 id="text-size-heading">@WebStrings.GeneralSettingsTextSizeHeading</h2>
        <p class="hint">@WebStrings.GeneralSettingsTextSizeHint</p>

        <fieldset class="size-group">
            <legend class="label">@WebStrings.GeneralSettingsInterfaceSizeLabel</legend>
            <p class="hint">@WebStrings.GeneralSettingsInterfaceSizeHint</p>
            <div class="size-options">
                @foreach (var step in Steps)
                {
                    <label class="size-option">
                        <input type="radio" name="ui-size" value="@step.Key" checked="@(_ui == step.Key)" @onchange="() => SetAsync(UiKind, step.Key)" />
                        <span>@StepLabel(step)</span>
                        <span class="muted">@step.Percent</span>
                    </label>
                }
            </div>
        </fieldset>

        <fieldset class="size-group">
            <legend class="label">@WebStrings.GeneralSettingsChatTextSizeLabel</legend>
            <p class="hint">@WebStrings.GeneralSettingsChatTextSizeHint</p>
            <div class="size-options">
                @foreach (var step in Steps)
                {
                    <label class="size-option">
                        <input type="radio" name="chat-size" value="@step.Key" checked="@(_chat == step.Key)" @onchange="() => SetAsync(ChatKind, step.Key)" />
                        <span>@StepLabel(step)</span>
                        <span class="muted">@step.Percent</span>
                    </label>
                }
            </div>
        </fieldset>

        <div class="size-preview" aria-label="@WebStrings.GeneralSettingsPreviewLabel">
            <div class="chat-thread">
                <article class="msg" data-role="user">
                    <div class="msg-content">
                        <div class="msg-body">@WebStrings.GeneralSettingsPreviewQuestion</div>
                    </div>
                </article>
                <article class="msg" data-role="assistant">
                    <div class="msg-body md">
                        <p>@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.GeneralSettingsReverseHint))</p>
                        <pre><code>var chars = text.ToCharArray();
Array.Reverse(chars);
var reversed = new string(chars);</code></pre>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="card stack" aria-labelledby="shortcuts-heading">
        <h2 id="shortcuts-heading">@WebStrings.GeneralSettingsShortcutsHeading</h2>
        <dl class="facts">
            <dt>@WebStrings.GeneralSettingsShortcutNewChat</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>O</kbd></dd>
            <dt>@WebStrings.GeneralSettingsShortcutSearchChats</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>K</kbd></dd>
            <dt>@WebStrings.GeneralSettingsShortcutFindInChat</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>F</kbd></dd>
            <dt>@WebStrings.GeneralSettingsShortcutSettings</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>,</kbd></dd>
            <dt>@WebStrings.GeneralSettingsShortcutSend</dt>
            <dd><kbd>Enter</kbd></dd>
            <dt>@WebStrings.GeneralSettingsShortcutNewLine</dt>
            <dd><kbd>Shift</kbd> + <kbd>Enter</kbd></dd>
        </dl>
    </section>
</div>

@code {
    private const string UiKind = "ui";
    private const string ChatKind = "chat";

    private sealed record Step(string Key, string Percent);

    /// <summary>
    /// The text size steps, with keys and scales matching wwwroot/theme.js.
    /// </summary>
    private static readonly Step[] Steps =
    [
        new("small", "87.5%"),
        new("default", "100%"),
        new("large", "115%"),
        new("xlarge", "130%"),
    ];

    private static string StepLabel(Step step) => step.Key switch
    {
        "small" => WebStrings.GeneralSettingsSmall,
        "default" => WebStrings.GeneralSettingsDefault,
        "large" => WebStrings.GeneralSettingsLarge,
        _ => WebStrings.GeneralSettingsExtraLarge,
    };

    private string _ui = "default";
    private string _chat = "default";
    private bool _fullChatWidth;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ui = await JS.InvokeAsync<string>("bhSize.get", UiKind);
            _chat = await JS.InvokeAsync<string>("bhSize.get", ChatKind);
            _fullChatWidth = await JS.InvokeAsync<bool>("bhChatWidth.get");
            StateHasChanged();
        }
    }

    private Task OnCompactionChangedAsync(ChangeEventArgs e)
    {
        var mode = e.Value is true ? CompactionMode.Extractive : CompactionMode.Model;
        return Toasts.TrySaveAsync(() => Config.UpdateAsync(config => config with { Compaction = mode }), WebStrings.GeneralSettingsSaveFailure);
    }

    private Task OnTodosChangedAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        return Toasts.TrySaveAsync(() => Config.UpdateAsync(config => config with { TodosEnabled = enabled }), WebStrings.GeneralSettingsSaveFailure);
    }

    private async Task OnLanguageChangedAsync(ChangeEventArgs e)
    {
        if (e.Value is string { Length: > 0 } culture)
        {
            await JS.InvokeVoidAsync("bhUi.setCulture", culture);
        }
    }

    private async Task OnChatWidthChangedAsync(ChangeEventArgs e)
    {
        _fullChatWidth = e.Value is true;
        await JS.InvokeVoidAsync("bhChatWidth.set", _fullChatWidth);
    }

    private async Task SetAsync(string kind, string step)
    {
        if (kind == UiKind)
        {
            _ui = step;
        }
        else
        {
            _chat = step;
        }

        await JS.InvokeVoidAsync("bhSize.set", kind, step);
    }
}
