@using BlazeHarness.Core.Compaction
@using BlazeHarness.Core.Config
@inject IJSRuntime JS
@inject JsonFileStore<AppConfig> Config
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="General">Compaction, chat appearance and keyboard shortcuts.</PageHeader>

    <section class="card stack" aria-labelledby="compaction-heading">
        <h2 id="compaction-heading">Compaction</h2>
        <label class="check">
            <input type="checkbox" checked="@(Config.Current.Compaction == CompactionMode.Extractive)" @onchange="OnCompactionChangedAsync" />
            <span>Compact without the model (Extraction)</span>
        </label>
        <p class="hint">
            When a chat gets too long, the model normally summarizes the older messages. Extraction builds the summary from your requests,
            the files touched and the latest steps instead, without a model call: instant and free, but less thorough. The agent can still look up what was left out.
        </p>
    </section>

    <section class="card stack" aria-labelledby="chat-width-heading">
        <h2 id="chat-width-heading">Chat width</h2>
        <label class="check">
            <input type="checkbox" checked="@_fullChatWidth" @onchange="OnChatWidthChangedAsync" />
            <span>Use full width for chats</span>
        </label>
        <p class="hint">Expand messages and the message box to fill the available space. Kept in this browser and applied right away.</p>
    </section>

    <section class="card stack" aria-labelledby="text-size-heading">
        <h2 id="text-size-heading">Text size</h2>
        <p class="hint">Kept in this browser and applied right away. Browser zoom still works on top.</p>

        <fieldset class="size-group">
            <legend class="label">Interface size</legend>
            <p class="hint">The sidebar, buttons, dialogs and settings.</p>
            <div class="size-options">
                @foreach (var step in Steps)
                {
                    <label class="size-option">
                        <input type="radio" name="ui-size" value="@step.Key" checked="@(_ui == step.Key)" @onchange="() => SetAsync(UiKind, step.Key)" />
                        <span>@step.Label</span>
                        <span class="muted">@step.Percent</span>
                    </label>
                }
            </div>
        </fieldset>

        <fieldset class="size-group">
            <legend class="label">Chat text size</legend>
            <p class="hint">Messages and the message box, on top of the interface size. Code follows at a slightly smaller size.</p>
            <div class="size-options">
                @foreach (var step in Steps)
                {
                    <label class="size-option">
                        <input type="radio" name="chat-size" value="@step.Key" checked="@(_chat == step.Key)" @onchange="() => SetAsync(ChatKind, step.Key)" />
                        <span>@step.Label</span>
                        <span class="muted">@step.Percent</span>
                    </label>
                }
            </div>
        </fieldset>

        <div class="size-preview" aria-label="Preview of the chat text">
            <div class="chat-thread">
                <article class="msg" data-role="user">
                    <div class="msg-body">How do I reverse a string in C#?</div>
                </article>
                <article class="msg" data-role="assistant">
                    <div class="msg-body md">
                        <p>You can use <code>Array.Reverse</code> on the characters:</p>
                        <pre><code>var chars = text.ToCharArray();
Array.Reverse(chars);
var reversed = new string(chars);</code></pre>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="card stack" aria-labelledby="shortcuts-heading">
        <h2 id="shortcuts-heading">Keyboard shortcuts</h2>
        <dl class="facts">
            <dt>New chat</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>O</kbd></dd>
            <dt>Search chats</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>K</kbd></dd>
            <dt>Find in the chat</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>F</kbd></dd>
            <dt>Settings</dt>
            <dd><kbd>Ctrl</kbd> + <kbd>,</kbd></dd>
            <dt>Send the message</dt>
            <dd><kbd>Enter</kbd></dd>
            <dt>New line in the message</dt>
            <dd><kbd>Shift</kbd> + <kbd>Enter</kbd></dd>
        </dl>
    </section>
</div>

@code {
    private const string UiKind = "ui";
    private const string ChatKind = "chat";

    private sealed record Step(string Key, string Label, string Percent);

    // Keys and scales must match the steps in wwwroot/theme.js.
    private static readonly Step[] Steps =
    [
        new("small", "Small", "87.5%"),
        new("default", "Default", "100%"),
        new("large", "Large", "115%"),
        new("xlarge", "Extra large", "130%"),
    ];

    private string _ui = "default";
    private string _chat = "default";
    private bool _fullChatWidth;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ui = await JS.InvokeAsync<string>("bhSize.get", UiKind);
            _chat = await JS.InvokeAsync<string>("bhSize.get", ChatKind);
            _fullChatWidth = await JS.InvokeAsync<bool>("bhChatWidth.get");
            StateHasChanged();
        }
    }

    private Task OnCompactionChangedAsync(ChangeEventArgs e)
    {
        var mode = e.Value is true ? CompactionMode.Extractive : CompactionMode.Model;
        return Toasts.TrySaveAsync(() => Config.UpdateAsync(config => config with { Compaction = mode }), "The setting could not be saved because the settings file could not be written.");
    }

    private async Task OnChatWidthChangedAsync(ChangeEventArgs e)
    {
        _fullChatWidth = e.Value is true;
        await JS.InvokeVoidAsync("bhChatWidth.set", _fullChatWidth);
    }

    private async Task SetAsync(string kind, string step)
    {
        if (kind == UiKind)
        {
            _ui = step;
        }
        else
        {
            _chat = step;
        }

        await JS.InvokeVoidAsync("bhSize.set", kind, step);
    }
}
