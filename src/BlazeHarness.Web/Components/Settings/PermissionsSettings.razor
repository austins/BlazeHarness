@using BlazeHarness.Core.Permissions
@inject PermissionDefaults Defaults
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.PermissionsSettingsTitle">@WebStrings.PermissionsSettingsDescription</PageHeader>

    <section class="card stack" aria-labelledby="start-heading">
        <h2 id="start-heading">@WebStrings.PermissionsSettingsStartHeading</h2>
        <div class="field">
            <label for="default-access">@WebStrings.PermissionsSettingsAccessLabel</label>
            <select id="default-access" class="select" value="@_access" @onchange="OnAccessChangedAsync">
                <option value="@AccessLevel.WriteInFolder">@WebStrings.PermissionsSettingsAccessWriteInFolder</option>
                <option value="@AccessLevel.ReadOnly">@WebStrings.PermissionsSettingsAccessReadOnly</option>
            </select>
            <span class="hint">@WebStrings.PermissionsSettingsAccessHint</span>
        </div>
        <div class="field">
            <label for="default-approvals">@WebStrings.PermissionsSettingsApprovalsLabel</label>
            <select id="default-approvals" class="select" value="@_approvals" @onchange="OnApprovalsChangedAsync">
                <option value="@ApprovalMode.AskFirst">@WebStrings.PermissionsSettingsApprovalsAskFirst</option>
                <option value="@ApprovalMode.AutoApprove">@WebStrings.PermissionsSettingsApprovalsAskForExceptions</option>
            </select>
        </div>
    </section>

    <section class="card stack" aria-labelledby="bypass-heading">
        <h2 id="bypass-heading">@WebStrings.PermissionsSettingsAdvancedOptionsHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@_allowBypass" @onchange="OnBypassChangedAsync" />
            <span>@WebStrings.PermissionsSettingsAdvancedOptionsLabel</span>
        </label>
        <p class="hint">@WebStrings.PermissionsSettingsAdvancedOptionsHint</p>
    </section>

    <section class="card stack" aria-labelledby="network-heading">
        <h2 id="network-heading">@WebStrings.PermissionsSettingsNetworkHeading</h2>
        <label class="check">
            <input type="checkbox" checked="@_networkFilter" @onchange="OnNetworkFilterChangedAsync" />
            <span>@WebStrings.PermissionsSettingsNetworkLabel</span>
        </label>
        <p class="hint">@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.PermissionsSettingsNetworkHint))</p>
    </section>

    <section class="card stack" aria-labelledby="protected-heading">
        <h2 id="protected-heading">@WebStrings.PermissionsSettingsProtectedFoldersHeading</h2>
        <p class="hint">@WebStrings.PermissionsSettingsProtectedFoldersHint</p>
        @if (_protected.Count == 0)
        {
            <p class="muted">@WebStrings.PermissionsSettingsNoProtectedFolders</p>
        }
        @for (var i = 0; i < _protected.Count; i++)
        {
            var index = i;
            var folder = _protected[i];
            <div class="row list-row">
                <code class="mono">@folder</code>
                <button type="button" class="btn btn-sm" aria-label="@RemoveProtectedLabel(folder)" @onclick="() => RemoveProtectedAsync(index)">@WebStrings.PermissionsSettingsRemoveProtectedButton</button>
            </div>
        }
        <div class="row">
            <input class="input mono" aria-label="@WebStrings.PermissionsSettingsProtectedFolderLabel" aria-invalid="@(ProtectedInvalid ? "true" : null)" aria-describedby="@(ProtectedInvalid ? "protected-error" : null)" placeholder="@_protectedExample" @bind="_newProtected" @bind:event="oninput" @onkeydown="OnProtectedKeyAsync" />
            <button type="button" class="btn" disabled="@(!Path.IsPathFullyQualified(_newProtected.Trim()))" @onclick="AddProtectedAsync">@WebStrings.PermissionsSettingsAddProtectedButton</button>
            <button type="button" class="btn" disabled="@Defaults.UsesDefaultProtectedFolders" @onclick="ResetProtectedAsync">@WebStrings.PermissionsSettingsResetProtectedButton</button>
        </div>
        @if (ProtectedInvalid)
        {
            <p id="protected-error" class="error-text">@WebStrings.PermissionsSettingsProtectedFolderError</p>
        }
    </section>

    <section class="card stack" aria-labelledby="rules-heading">
        <h2 id="rules-heading">@WebStrings.PermissionsSettingsRulesHeading</h2>
        <p class="hint">@WebStrings.PermissionsRulesDescription</p>
        @if (_rules.Count == 0)
        {
            <p class="muted">@WebStrings.PermissionsSettingsNoRules</p>
        }
        @for (var i = 0; i < _rules.Count; i++)
        {
            var index = i;
            var rule = _rules[i];
            <div class="row list-row">
                <span>@TargetLabel(rule.Target)</span>
                <span>@ActionLabel(rule.Action)</span>
                <code class="mono">@rule.Pattern</code>
                <button type="button" class="btn btn-sm" aria-label="@RemoveRuleLabel(rule.Pattern)" @onclick="() => RemoveRuleAsync(index)">@WebStrings.PermissionsSettingsRemoveRuleButton</button>
            </div>
        }
        <div class="row">
            <select class="select" aria-label="@WebStrings.PermissionsSettingsRuleTargetLabel" @bind="_newTarget">
                <option value="@RuleTarget.ShellCommand">@WebStrings.PermissionsSettingsTargetShellCommand</option>
                <option value="@RuleTarget.FilePath">@WebStrings.PermissionsSettingsTargetFilePath</option>
                <option value="@RuleTarget.McpTool">@WebStrings.PermissionsSettingsTargetMcpTool</option>
                <option value="@RuleTarget.WebHost">@WebStrings.PermissionsSettingsTargetWebHost</option>
                <option value="@RuleTarget.NetworkHost">@WebStrings.PermissionsSettingsTargetNetworkHost</option>
            </select>
            <select class="select" aria-label="@WebStrings.PermissionsSettingsRuleActionLabel" @bind="_newAction">
                <option value="@PermissionVerdict.Deny">@WebStrings.PermissionsSettingsRuleRefuse</option>
                <option value="@PermissionVerdict.Ask">@WebStrings.PermissionsSettingsRuleAsk</option>
                <option value="@PermissionVerdict.Allow">@WebStrings.PermissionsSettingsRuleAllow</option>
            </select>
            <input class="input mono" aria-label="@WebStrings.PermissionsSettingsRulePatternLabel" placeholder="@PatternExample(_newTarget)" @bind="_newPattern" @bind:event="oninput" @onkeydown="OnPatternKeyAsync" />
            <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_newPattern)" @onclick="AddRuleAsync">@WebStrings.PermissionsSettingsAddRuleButton</button>
        </div>
    </section>
</div>

@code {
    private AccessLevel _access;
    private ApprovalMode _approvals;
    private bool _allowBypass;
    private bool _networkFilter;
    private List<PermissionRule> _rules = [];
    private List<string> _protected = [];
    private string _newProtected = string.Empty;
    private bool ProtectedInvalid => _newProtected.Trim().Length > 0 && !Path.IsPathFullyQualified(_newProtected.Trim());

    private string _protectedExample = "~/.config/my-tool";
    private RuleTarget _newTarget;
    private PermissionVerdict _newAction = PermissionVerdict.Deny;
    private string _newPattern = string.Empty;

    protected override void OnInitialized()
    {
        Load();
        _protectedExample = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".config", "my-tool");
    }

    private void Load()
    {
        var current = Defaults.Current;
        _access = current.Access;
        _approvals = current.Approvals;
        _allowBypass = Defaults.AllowBypass;
        _networkFilter = Defaults.NetworkFilter;
        _rules = [.. Defaults.Rules];
        _protected = [.. Defaults.ProtectedFolders];
    }

    private static string RemoveProtectedLabel(string folder) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.PermissionsRemoveProtectedFolder), new Dictionary<string, object?> { ["folder"] = folder });

    private static string RemoveRuleLabel(string pattern) =>
        ResourceMessageFormatter.Web.Format(nameof(WebStrings.PermissionsRemoveRule), new Dictionary<string, object?> { ["pattern"] = pattern });

    // The lists are edited before they are saved, so a failed save shows what is really stored again.
    private async Task PersistAsync(Func<Task> save)
    {
        if (!await Toasts.TrySaveAsync(save, WebStrings.PermissionsSaveFailure))
        {
            Load();
        }
    }

    private static string TargetLabel(RuleTarget target)
    {
        return target switch
        {
            RuleTarget.ShellCommand => WebStrings.PermissionsTargetShellCommand,
            RuleTarget.McpTool => WebStrings.PermissionsTargetMcpTool,
            RuleTarget.WebHost => WebStrings.PermissionsTargetWebHost,
            RuleTarget.NetworkHost => WebStrings.PermissionsTargetNetworkHost,
            _ => WebStrings.PermissionsTargetFilePath,
        };
    }

    private static string PatternExample(RuleTarget target)
    {
        return target switch
        {
            RuleTarget.ShellCommand => "git push*",
            RuleTarget.McpTool => "server/tool*",
            RuleTarget.WebHost => "*.example.com",
            RuleTarget.NetworkHost => "*.npmjs.org",
            _ => "**/.env",
        };
    }

    private static string ActionLabel(PermissionVerdict action) => action switch
    {
        PermissionVerdict.Deny => WebStrings.PermissionsActionRefuse,
        PermissionVerdict.Ask => WebStrings.PermissionsActionAsk,
        _ => WebStrings.PermissionsActionAllow,
    };

    private Task OnPatternKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? AddRuleAsync() : Task.CompletedTask;

    private Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPattern))
        {
            return Task.CompletedTask;
        }

        _rules.Add(new PermissionRule(_newTarget, _newAction, _newPattern.Trim()));
        _newPattern = string.Empty;
        return PersistAsync(() => Defaults.SaveRulesAsync(_rules));
    }

    private Task RemoveRuleAsync(int index)
    {
        _rules.RemoveAt(index);
        return PersistAsync(() => Defaults.SaveRulesAsync(_rules));
    }

    private Task OnProtectedKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? AddProtectedAsync() : Task.CompletedTask;

    private Task AddProtectedAsync()
    {
        var folder = _newProtected.Trim();
        if (folder.Length == 0 || !Path.IsPathFullyQualified(folder))
        {
            return Task.CompletedTask;
        }

        if (!_protected.Contains(folder, StringComparer.Ordinal))
        {
            _protected.Add(folder);
        }

        _newProtected = string.Empty;
        return PersistAsync(() => Defaults.SaveProtectedFoldersAsync(_protected));
    }

    private Task RemoveProtectedAsync(int index)
    {
        _protected.RemoveAt(index);
        return PersistAsync(() => Defaults.SaveProtectedFoldersAsync(_protected));
    }

    private async Task ResetProtectedAsync()
    {
        await PersistAsync(() => Defaults.SaveProtectedFoldersAsync(null));
        _protected = [.. Defaults.ProtectedFolders];
    }

    private Task OnAccessChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<AccessLevel>(e.Value as string, out var access) || !Enum.IsDefined(access))
        {
            return Task.CompletedTask;
        }

        _access = access;
        return SaveAsync();
    }

    private Task OnApprovalsChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ApprovalMode>(e.Value as string, out var approvals) || !Enum.IsDefined(approvals))
        {
            return Task.CompletedTask;
        }

        _approvals = approvals;
        return SaveAsync();
    }

    private Task OnBypassChangedAsync(ChangeEventArgs e)
    {
        _allowBypass = e.Value is true;
        return SaveAsync();
    }

    private Task OnNetworkFilterChangedAsync(ChangeEventArgs e)
    {
        _networkFilter = e.Value is true;
        return PersistAsync(() => Defaults.SetNetworkFilterAsync(_networkFilter));
    }

    private Task SaveAsync() => PersistAsync(() => Defaults.SaveAsync(new PermissionSettings(_access, _approvals), _allowBypass));
}
