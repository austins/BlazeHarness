@using BlazeHarness.Core
@using BlazeHarness.Core.Skills
@implements IDisposable
@inject SkillCatalog Catalog
@inject AppPaths Paths
@inject ToastService Toasts

<div class="page">
    <PageHeader Title="@WebStrings.SkillsSettingsTitle">@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.SkillsSettingsIntro))</PageHeader>

    <Alert Kind="AlertKind.Warning">
        <Icon Name="alert" />
        <span>@WebStrings.SkillsSettingsInstallWarning</span>
    </Alert>

    <section class="card stack" aria-labelledby="skills-heading">
        <div class="row row-spread">
            <h2 id="skills-heading">@WebStrings.SkillsSettingsInstalledHeading</h2>
            @if (_resolution.Skills.Count > 0)
            {
                <span class="hint">@_resolution.Skills.Count installed · on by default for new chats</span>
            }
        </div>
        @if (_resolution.Skills.Count == 0)
        {
            <p class="muted">@ResourceMessageFormatter.Web.FormatMarkup(nameof(WebStrings.SkillsSettingsEmpty))</p>
        }
        else
        {
            <div class="skill-list">
                @foreach (var skill in _resolution.Skills)
                {
                    <div class="skill-item" role="group" aria-label="@skill.Name">
                        <details>
                            <summary>
                                <Icon Name="chevron-right" />
                                <span class="skill-title">
                                    <span class="row">
                                        <strong>@skill.Name</strong>
                                        <span class="badge">@SourceText(skill.Source)</span>
                                    </span>
                                    <span class="skill-blurb">@skill.Description</span>
                                </span>
                            </summary>
                            <div class="skill-body stack">
                                <p>@skill.Description</p>
                                <p class="hint mono">@skill.Directory</p>
                            </div>
                        </details>
                        <label class="check" title="@WebStrings.SkillsSettingsNewChatsTooltip">
                            <input type="checkbox" aria-label="@WebStrings.SkillsSettingsNewChatsLabel" checked="@(!Catalog.IsDisabledGlobally(skill.Name))" @onchange="e => SetEnabledAsync(skill.Name, (bool)e.Value!)" />
                            <span>@WebStrings.SkillsSettingsOn</span>
                        </label>
                    </div>
                }
            </div>
        }
    </section>

    @if (_resolution.Shadowed.Count > 0)
    {
        <section class="card stack" aria-labelledby="shadowed-heading">
            <h2 id="shadowed-heading">@WebStrings.SkillsSettingsHiddenHeading</h2>
            <ul class="stack">
                @foreach (var skill in _resolution.Shadowed)
                {
                    <li><strong>@skill.Name</strong> <span class="muted">@WebStrings.SkillsSettingsHiddenIn</span> <span class="mono">@skill.Directory</span></li>
                }
            </ul>
        </section>
    }

    @if (_resolution.Problems.Count > 0)
    {
        <section class="card stack" aria-labelledby="problems-heading">
            <h2 id="problems-heading">@WebStrings.SkillsSettingsProblemsHeading</h2>
            <ul class="stack">
                @foreach (var problem in _resolution.Problems)
                {
                    <li class="error-text">@problem</li>
                }
            </ul>
        </section>
    }

    <section class="card stack" aria-labelledby="places-heading">
        <h2 id="places-heading">@WebStrings.SkillsSettingsLocationsHeading</h2>
        <ul class="stack">
            <li><span class="mono">&lt;chat folder&gt;/.agents/skills</span> <span class="muted">@WebStrings.SkillsSettingsFolderLocation</span></li>
            <li><span class="mono">@Paths.SkillsDirectory</span> <span class="muted">@WebStrings.SkillsSettingsBlazeHarnessLocation</span></li>
            <li><span class="mono">@Paths.UserAgentsSkillsDirectory</span> <span class="muted">@WebStrings.SkillsSettingsGlobalLocation</span></li>
        </ul>
        <p class="hint">@WebStrings.SkillsSettingsLocationsHint</p>
    </section>
</div>

@code {
    private SkillResolution _resolution = SkillResolution.Of();

    public void Dispose()
    {
        Catalog.Changed -= OnCatalogChanged;
    }

    protected override void OnInitialized()
    {
        _resolution = Catalog.Resolve(null);
        Catalog.Changed += OnCatalogChanged;
    }

    private static string SourceText(SkillSource source) => source switch
    {
        SkillSource.Project => WebStrings.SkillsSettingsChatFolder,
        SkillSource.App => WebStrings.SkillsSettingsBlazeHarness,
        _ => WebStrings.SkillsSettingsGlobal,
    };

    private Task SetEnabledAsync(string name, bool enabled) => Toasts.TrySaveAsync(() => Catalog.SetDisabledAsync(name, !enabled), WebStrings.SkillsSettingsSaveFailure);

    private void OnCatalogChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            _resolution = Catalog.Resolve(null);
            StateHasChanged();
        });
    }
}
