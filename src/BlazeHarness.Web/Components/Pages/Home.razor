@page "/"
@inject ProviderService Service

<PageTitle>BlazeHarness</PageTitle>

@if (Service.Config.Providers.Count == 0)
{
    <div class="page">
        <div class="card empty">
            <h1>Welcome to BlazeHarness</h1>
            <p>Connect an OpenAI-compatible endpoint to start chatting. A hosted API or a local server such as llama.cpp both work.</p>
            <a class="btn btn-primary" href="settings/providers">Set up a provider</a>
        </div>
    </div>
}
else
{
    <ChatView />
}
