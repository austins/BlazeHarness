@page "/"
@page "/chat/{Id}"
@implements IDisposable
@inject ProviderService Service
@inject SettingsDialogState SettingsState

<PageTitle>BlazeHarness</PageTitle>

@if (Service.Configured.Count == 0)
{
    <div class="page">
        <div class="card empty">
            <h1>Welcome to BlazeHarness</h1>
            <p>Connect an OpenAI-compatible endpoint to start chatting. A hosted API or a local server such as llama.cpp both work.</p>
            <button type="button" class="btn btn-primary" @onclick="() => SettingsState.Open()">Set up a provider</button>
        </div>
    </div>
}
else
{
    <ChatView SessionId="@(string.IsNullOrEmpty(Id) ? null : Id)" FolderPath="@Folder" />
}

@code {
    /// <summary>
    /// Gets or sets the id of the open chat, or null for a new one.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the path of the opened folder a new chat should start in, from the <c>folder</c> query value.
    /// </summary>
    [SupplyParameterFromQuery(Name = "folder")]
    public string? Folder { get; set; }

    public void Dispose()
    {
        Service.Changed -= OnProvidersChanged;
    }

    protected override void OnInitialized()
    {
        Service.Changed += OnProvidersChanged;
    }

    private void OnProvidersChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
