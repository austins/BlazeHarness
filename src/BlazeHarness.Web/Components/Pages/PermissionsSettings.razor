@page "/settings/permissions"
@using BlazeHarness.Core.Permissions
@inject PermissionDefaults Defaults
@inject ToastService Toasts

<PageTitle>Permissions · BlazeHarness</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Permissions</h1>
        <p class="muted">What new chats start with. Each chat can still change its own settings, and changes here apply right away.</p>
    </header>

    <section class="card stack" aria-labelledby="start-heading">
        <h2 id="start-heading">New chats start with</h2>
        <div class="field">
            <label for="default-access">Access level</label>
            <select id="default-access" class="select" value="@_access" @onchange="OnAccessChangedAsync">
                <option value="@AccessLevel.WriteInFolder">Write in folder</option>
                <option value="@AccessLevel.ReadOnly">Read only</option>
            </select>
            <span class="hint">A chat without a folder always starts read only.</span>
        </div>
        <div class="field">
            <label for="default-approvals">Approvals</label>
            <select id="default-approvals" class="select" value="@_approvals" @onchange="OnApprovalsChangedAsync">
                <option value="@ApprovalMode.AskFirst">Ask first</option>
                <option value="@ApprovalMode.AutoApprove">Auto-approve</option>
            </select>
        </div>
    </section>

    <section class="card stack" aria-labelledby="bypass-heading">
        <h2 id="bypass-heading">Risky options</h2>
        <label class="check">
            <input type="checkbox" checked="@_allowBypass" @onchange="OnBypassChangedAsync" />
            <span>Let a chat turn on Unrestricted or Never ask</span>
        </label>
        <p class="hint">Turn this off to hide both options. A chat that already has one of them then behaves as if it did not. Protected folders such as your SSH keys stay blocked either way.</p>
    </section>

    <section class="card stack" aria-labelledby="protected-heading">
        <h2 id="protected-heading">Protected folders</h2>
        <p class="hint">No tool can read or write these, in any chat, even Unrestricted. BlazeHarness's own folder is always protected and is not listed.</p>
        @if (_protected.Count == 0)
        {
            <p class="muted">No folders are protected.</p>
        }
        @for (var i = 0; i < _protected.Count; i++)
        {
            var index = i;
            var folder = _protected[i];
            <div class="row">
                <code class="mono">@folder</code>
                <button type="button" class="btn btn-sm" aria-label="Remove @folder from the protected folders" @onclick="() => RemoveProtectedAsync(index)">Remove</button>
            </div>
        }
        <div class="row">
            <input class="input mono" aria-label="Folder to protect" aria-invalid="@(ProtectedInvalid ? "true" : null)" aria-describedby="@(ProtectedInvalid ? "protected-error" : null)" placeholder="@_protectedExample" @bind="_newProtected" @bind:event="oninput" @onkeydown="OnProtectedKeyAsync" />
            <button type="button" class="btn" disabled="@(!Path.IsPathFullyQualified(_newProtected.Trim()))" @onclick="AddProtectedAsync">＋ Add folder</button>
            <button type="button" class="btn" disabled="@Defaults.UsesDefaultProtectedFolders" @onclick="ResetProtectedAsync">Reset to the built-in list</button>
        </div>
        @if (ProtectedInvalid)
        {
            <p id="protected-error" class="error-text">Enter the full path of the folder, starting from the root.</p>
        }
    </section>

    <section class="card stack" aria-labelledby="rules-heading">
        <h2 id="rules-heading">Rules</h2>
        <p class="hint">
            A rule that refuses always wins. Otherwise the last matching rule decides. An allow rule skips the question but never gets a call out of the sandbox or into a protected folder.
            Use * for any text and ? for one character. In a path, * stays inside one folder and ** crosses folders.
            An MCP tool rule matches the server name and the tool name written as server/tool.
        </p>
        @if (_rules.Count == 0)
        {
            <p class="muted">No rules yet.</p>
        }
        @for (var i = 0; i < _rules.Count; i++)
        {
            var index = i;
            var rule = _rules[i];
            <div class="row">
                <span>@TargetLabel(rule.Target)</span>
                <span>@ActionLabel(rule.Action)</span>
                <code class="mono">@rule.Pattern</code>
                <button type="button" class="btn btn-sm" aria-label="Remove rule @rule.Pattern" @onclick="() => RemoveRuleAsync(index)">Remove</button>
            </div>
        }
        <div class="row">
            <select class="select" aria-label="Rule applies to" @bind="_newTarget">
                <option value="@RuleTarget.ShellCommand">Shell command</option>
                <option value="@RuleTarget.FilePath">File path</option>
                <option value="@RuleTarget.McpTool">MCP tool</option>
            </select>
            <select class="select" aria-label="Rule action" @bind="_newAction">
                <option value="@PermissionVerdict.Deny">Refuse</option>
                <option value="@PermissionVerdict.Ask">Ask</option>
                <option value="@PermissionVerdict.Allow">Allow</option>
            </select>
            <input class="input mono" aria-label="Rule pattern" placeholder="@PatternExample(_newTarget)" @bind="_newPattern" @bind:event="oninput" @onkeydown="OnPatternKeyAsync" />
            <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_newPattern)" @onclick="AddRuleAsync">＋ Add rule</button>
        </div>
    </section>
</div>

@code {
    private AccessLevel _access;
    private ApprovalMode _approvals;
    private bool _allowBypass;
    private List<PermissionRule> _rules = [];
    private List<string> _protected = [];
    private string _newProtected = string.Empty;
    private bool ProtectedInvalid => _newProtected.Trim().Length > 0 && !Path.IsPathFullyQualified(_newProtected.Trim());

    private string _protectedExample = "~/.config/my-tool";
    private RuleTarget _newTarget;
    private PermissionVerdict _newAction = PermissionVerdict.Deny;
    private string _newPattern = string.Empty;

    protected override void OnInitialized()
    {
        Load();
        _protectedExample = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".config", "my-tool");
    }

    private void Load()
    {
        var current = Defaults.Current;
        _access = current.Access;
        _approvals = current.Approvals;
        _allowBypass = Defaults.AllowBypass;
        _rules = [.. Defaults.Rules];
        _protected = [.. Defaults.ProtectedFolders];
    }

    // The lists are edited before they are saved, so a failed save shows what is really stored again.
    private async Task PersistAsync(Func<Task> save)
    {
        if (!await Toasts.TrySaveAsync(save, "The permission settings could not be saved because the settings file could not be written."))
        {
            Load();
        }
    }

    private static string TargetLabel(RuleTarget target)
    {
        return target switch
        {
            RuleTarget.ShellCommand => "Shell command",
            RuleTarget.McpTool => "MCP tool",
            _ => "File path",
        };
    }

    private static string PatternExample(RuleTarget target)
    {
        return target switch
        {
            RuleTarget.ShellCommand => "git push*",
            RuleTarget.McpTool => "server/tool*",
            _ => "**/.env",
        };
    }

    private static string ActionLabel(PermissionVerdict action) => action switch
    {
        PermissionVerdict.Deny => "Refuse",
        PermissionVerdict.Ask => "Ask",
        _ => "Allow",
    };

    private Task OnPatternKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? AddRuleAsync() : Task.CompletedTask;

    private Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPattern))
        {
            return Task.CompletedTask;
        }

        _rules.Add(new PermissionRule(_newTarget, _newAction, _newPattern.Trim()));
        _newPattern = string.Empty;
        return PersistAsync(() => Defaults.SaveRulesAsync(_rules));
    }

    private Task RemoveRuleAsync(int index)
    {
        _rules.RemoveAt(index);
        return PersistAsync(() => Defaults.SaveRulesAsync(_rules));
    }

    private Task OnProtectedKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? AddProtectedAsync() : Task.CompletedTask;

    private Task AddProtectedAsync()
    {
        var folder = _newProtected.Trim();
        if (folder.Length == 0 || !Path.IsPathFullyQualified(folder))
        {
            return Task.CompletedTask;
        }

        if (!_protected.Contains(folder, StringComparer.Ordinal))
        {
            _protected.Add(folder);
        }

        _newProtected = string.Empty;
        return PersistAsync(() => Defaults.SaveProtectedFoldersAsync(_protected));
    }

    private Task RemoveProtectedAsync(int index)
    {
        _protected.RemoveAt(index);
        return PersistAsync(() => Defaults.SaveProtectedFoldersAsync(_protected));
    }

    private async Task ResetProtectedAsync()
    {
        await PersistAsync(() => Defaults.SaveProtectedFoldersAsync(null));
        _protected = [.. Defaults.ProtectedFolders];
    }

    private Task OnAccessChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<AccessLevel>(e.Value as string, out var access) || !Enum.IsDefined(access))
        {
            return Task.CompletedTask;
        }

        _access = access;
        return SaveAsync();
    }

    private Task OnApprovalsChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ApprovalMode>(e.Value as string, out var approvals) || !Enum.IsDefined(approvals))
        {
            return Task.CompletedTask;
        }

        _approvals = approvals;
        return SaveAsync();
    }

    private Task OnBypassChangedAsync(ChangeEventArgs e)
    {
        _allowBypass = e.Value is true;
        return SaveAsync();
    }

    private Task SaveAsync() => PersistAsync(() => Defaults.SaveAsync(new PermissionSettings(_access, _approvals), _allowBypass));
}
