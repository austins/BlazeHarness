@using System.Globalization
@using BlazeHarness.Core.Providers

<div class="param" data-set="@(Value is not null ? "true" : "false")">
    <div class="param-head">
        <label class="check">
            <input type="checkbox" checked="@(Value is not null)" @onchange="OnToggle" />
            <span>@Range.Label</span>
        </label>
        <span class="hint">@Range.Hint</span>
    </div>

    @if (Value is { } value)
    {
        <div class="param-body">
            <input type="range" class="slider" min="@Format(Range.Min)" max="@Format(Range.SliderMax)" step="@Format(Range.Step)"
                   value="@Format(Math.Clamp(value, Range.Min, Range.SliderMax))" @oninput="OnInput"
                   aria-label="@Range.Label slider" />
            <input type="number" class="input num" min="@Format(Range.Min)" max="@(Range.Max < int.MaxValue ? Format(Range.Max) : null)"
                   step="@Format(Range.Step)" value="@Format(value)" @onchange="OnInput" aria-label="@Range.Label"
                   aria-invalid="@(OutOfRange(value) ? "true" : null)" />
            <button type="button" class="btn btn-ghost btn-sm" @onclick="Reset"
                    title="@(Inherited is null ? "Use the server default" : "Inherit the default value")">Reset</button>
        </div>
        @if (OutOfRange(value))
        {
            <span class="alert alert-error" role="alert">@Range.Label must be between @Format(Range.Min) and @Format(Range.Max).</span>
        }
    }
    else
    {
        <span class="muted param-unset">@UnsetText()</span>
    }
</div>

@code {
    private bool OutOfRange(double value) => double.IsNaN(value) || value < Range.Min || value > Range.Max;

    /// <summary>
    /// Gets or sets the parameter this row edits.
    /// </summary>
    [Parameter, EditorRequired]
    public SamplingRange Range { get; set; } = null!;

    /// <summary>
    /// Gets or sets the value, or null when the parameter is not set.
    /// </summary>
    [Parameter]
    public double? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback for the value changing, with null when the user unsets it.
    /// </summary>
    [Parameter]
    public EventCallback<double?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the value the parameter has when this row does not set it, or null when the server decides.
    /// </summary>
    [Parameter]
    public double? Inherited { get; set; }

    private static string Format(double value) => value.ToString(CultureInfo.InvariantCulture);

    private Task OnToggle(ChangeEventArgs e)
    {
        return e.Value is true ? ValueChanged.InvokeAsync(StartValue()) : ValueChanged.InvokeAsync(null);
    }

    private Task OnInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            return Task.CompletedTask;
        }

        return ValueChanged.InvokeAsync(Range.IsInteger ? Math.Round(parsed) : parsed);
    }

    private string UnsetText()
    {
        return Inherited is { } inherited ? $"Inherited: {Format(inherited)}" : "Unset: the server default applies";
    }

    private Task Reset() => ValueChanged.InvokeAsync(null);

    private double StartValue()
    {
        var start = Inherited ?? Range.Start;
        return Math.Clamp(start, Range.Min, Range.SliderMax);
    }
}
