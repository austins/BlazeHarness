@using System.Text.Json
@using BlazeHarness.Core.Providers
@using BlazeHarness.Web.Settings

<Dialog Title="@($"Tune {Model?.Id}")" Open="Open" OnClose="OnClose">
    <ChildContent>
        @if (Model is not null && Provider is not null)
        {
            <div class="tune">
            <section class="stack" aria-labelledby="tune-levels">
                <h3 id="tune-levels">Thinking</h3>
                @if (!Model.Reasoning)
                {
                    <span class="hint">This model is not marked as a thinking model.</span>
                    <div><button type="button" class="btn btn-sm" @onclick="() => Model.Reasoning = true">Mark as a thinking model</button></div>
                }
                else
                {
                    <div class="chips" role="group" aria-label="Supported thinking levels">
                        @foreach (var level in Enum.GetValues<ThinkingLevel>())
                        {
                            var thisLevel = level;
                            var on = Model.Levels[level].Supported;
                            <button type="button" class="chip" aria-pressed="@(on ? "true" : "false")" @onclick="() => Model.SetLevelSupported(thisLevel, !on)">@LevelName(level)</button>
                        }
                    </div>
                    @if (Model.Levels.Any(l => l.Value.Supported))
                    {
                        <div class="level-values">
                            @foreach (var level in Enum.GetValues<ThinkingLevel>().Where(l => Model.Levels[l].Supported))
                            {
                                var edit = Model.Levels[level];
                                <label class="level-value">
                                    <span>@LevelName(level)</span>
                                    <input class="input mono" aria-label="Value sent for @LevelName(level)" placeholder="@ModelEditModel.SuggestedValue(level)" title="@Wire(edit.Value)" @bind="edit.Value" @bind:event="oninput" />
                                </label>
                            }
                        </div>
                        <span class="hint">Pick the levels the model supports and check the value the server expects for each. Blank sends nothing.</span>
                    }
                    else
                    {
                        <span class="hint">Pick the levels this model supports. Pick none if it can't be controlled.</span>
                    }
                    <div class="send-row">
                        <label for="tune-send">Sent as</label>
                        <select id="tune-send" class="select" value="@SendChoice" @onchange="OnSendChanged">
                            <option value="inherit">Same as provider: @ThinkingSendLabels.Short(Provider.ThinkingMode)</option>
                            @foreach (var mode in Enum.GetValues<ThinkingSendMode>())
                            {
                                <option value="@mode">@ThinkingSendLabels.Option(mode)</option>
                            }
                        </select>
                        @if (Model.OverrideSend && Model.SendMode == ThinkingSendMode.BodyField)
                        {
                            <input class="input mono" aria-label="Body field path" placeholder="chat_template_kwargs.reasoning_effort" @bind="Model.SendField" @bind:event="oninput" />
                        }
                    </div>
                    @if (!Model.OverrideSend)
                    {
                        <span class="hint">The provider's setting is under Compatibility in its settings, and applies to every model that doesn't pick its own.</span>
                    }
                }
            </section>

            <section class="stack" aria-labelledby="tune-sampling">
                <h3 id="tune-sampling">Sampling</h3>
                @{
                    var both = Model.HasThinkingLevels;
                }
                <table class="params">
                    <thead>
                        <tr>
                            <th scope="col">Parameter</th>
                            <th scope="col">@(both ? "Thinking off" : "Value")</th>
                            @if (both)
                            {
                                <th scope="col">Thinking on</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var range in SamplingRange.All)
                        {
                            var key = range.Key;
                            <tr>
                                <th scope="row" title="@range.Hint">@range.Label</th>
                                <td>
                                    <ParamInput Range="range" Label="@(both ? $"{range.Label}, thinking off" : range.Label)"
                                                Value="Model.Sampling.Get(key)" ValueChanged="v => Model.Sampling.Set(key, v)" />
                                </td>
                                @if (both)
                                {
                                    <td>
                                        <ParamInput Range="range" Label="@($"{range.Label}, thinking on")"
                                                    Value="Model.ThinkingSampling.Get(key)" ValueChanged="v => Model.ThinkingSampling.Set(key, v)"
                                                    Inherited="Model.Sampling.Get(key)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <span class="hint">
                    Leave a cell empty to leave it to the server.@if (both)
                    {
                        <text> An empty Thinking on cell uses the Thinking off value (↳).</text>
                    }
                </span>

                <details>
                    <summary>Custom fields@(ExtraCount > 0 ? $" ({ExtraCount})" : "")</summary>
                    <div class="stack details-body">
                        <span class="hint">For server-specific request fields. A dotted name such as chat_template_kwargs.x sets a nested field.</span>
                        @if (both)
                        {
                            <h4 class="subhead">Thinking off</h4>
                            <ExtraFields Rows="Model.Sampling.Extra" />
                            <h4 class="subhead">Thinking on</h4>
                            <span class="hint">Added to the Thinking off fields; a field with the same name replaces it.</span>
                            <ExtraFields Rows="Model.ThinkingSampling.Extra" />
                        }
                        else
                        {
                            <ExtraFields Rows="Model.Sampling.Extra" />
                        }
                    </div>
                </details>
            </section>

            <details>
                <summary>Preview of what is sent</summary>
                <div class="stack details-body">
                    @if (both)
                    {
                        <div class="preview-pair">
                            <div class="stack">
                                <h4 class="subhead">Thinking off</h4>
                                <pre class="preview" tabindex="0">@Preview(thinking: false)</pre>
                            </div>
                            <div class="stack">
                                <h4 class="subhead">Thinking on</h4>
                                <pre class="preview" tabindex="0">@Preview(thinking: true)</pre>
                            </div>
                        </div>
                    }
                    else
                    {
                        <pre class="preview" tabindex="0">@Preview(thinking: false)</pre>
                    }
                </div>
            </details>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-primary" @onclick="OnClose">Done</button>
    </Footer>
</Dialog>

@code {
    private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true };

    /// <summary>
    /// Gets or sets the provider whose model is tuned, which supplies the inherited values.
    /// </summary>
    [Parameter]
    public ProviderEditModel? Provider { get; set; }

    /// <summary>
    /// Gets or sets the model being tuned.
    /// </summary>
    [Parameter]
    public ModelEditModel? Model { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the tuning dialog is shown.
    /// </summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user closing the dialog.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private int ExtraCount => Model!.Sampling.Extra.Count + (Model.HasThinkingLevels ? Model.ThinkingSampling.Extra.Count : 0);

    private ThinkingLevel? PreviewLevel(bool thinking)
    {
        if (thinking)
        {
            return Model!.SupportedLevels.FirstOrDefault(l => l != ThinkingLevel.Off);
        }

        return Model!.Reasoning && Model.Levels[ThinkingLevel.Off].Supported ? ThinkingLevel.Off : null;
    }

    private string SendChoice => Model is { OverrideSend: true } ? Model.SendMode.ToString() : "inherit";

    private static string LevelName(ThinkingLevel level) => JsonNamingPolicy.CamelCase.ConvertName(level.ToString());

    private void OnSendChanged(ChangeEventArgs e)
    {
        var choice = e.Value?.ToString();
        if (Model is null || choice is null)
        {
            return;
        }

        if (Enum.TryParse<ThinkingSendMode>(choice, out var mode))
        {
            Model.OverrideSend = true;
            Model.SendMode = mode;
        }
        else
        {
            Model.OverrideSend = false;
        }
    }

    private string Wire(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "sends nothing";
        }

        var (mode, field) = Model!.OverrideSend ? (Model.SendMode, Model.SendField) : (Provider!.ThinkingMode, Provider.ThinkingField);
        var v = value.Trim();
        if (mode == ThinkingSendMode.ReasoningEffort)
        {
            return $"reasoning_effort: \"{v}\"";
        }

        if (mode == ThinkingSendMode.ReasoningObject)
        {
            return $"reasoning.effort: \"{v}\"";
        }

        if (string.IsNullOrWhiteSpace(field))
        {
            return "set the body field above";
        }

        var literal = bool.TryParse(v, out _) || long.TryParse(v, out _);
        return $"{field.Trim()}: {(literal ? v : $"\"{v}\"")}";
    }

    private string Preview(bool thinking)
    {
        var json = ResolvedRequestParams.Resolve(Provider!.ToConfig(), Model!.ToConfig(), PreviewLevel(thinking)).ToRequestJson();
        return json.Count == 0 ? "{}  (nothing added; the server defaults apply)" : json.ToJsonString(Indented);
    }
}
