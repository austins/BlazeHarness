@* A button that opens a panel of free content in a popover below it. The browser closes it on Escape or a click outside. *@
<button type="button" class="@(IconOnly ? "btn btn-ghost btn-sm btn-icon popover-trigger" : "btn btn-ghost btn-sm popover-trigger")"
        popovertarget="@_id" aria-haspopup="dialog" aria-label="@(IconOnly ? Label : null)" title="@Title" style="anchor-name: --@_id">
    @Trigger
    @if (ShowChevron && !IconOnly)
    {
        <Icon Name="chevron-down" />
    }
</button>
<div id="@_id" class="popover-panel" popover="auto" role="dialog" aria-label="@Label" style="position-anchor: --@_id">
    @ChildContent
</div>

@code {
    private readonly string _id = $"popover-{Guid.NewGuid():N}";

    /// <summary>
    /// Gets or sets the name of the panel, read by screen readers.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the tooltip of the button, or null.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Gets or sets whether to show the chevron beside the button content.
    /// </summary>
    [Parameter]
    public bool ShowChevron { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the button shows only an icon and has no visible text.
    /// </summary>
    [Parameter]
    public bool IconOnly { get; set; }

    /// <summary>
    /// Gets or sets the content of the button.
    /// </summary>
    [Parameter]
    public RenderFragment? Trigger { get; set; }

    /// <summary>
    /// Gets or sets the content of the panel.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
