@* A password-style field where the user can reveal only what they typed; a stored key is never sent back to the browser. *@
<div class="secret-field field">
    <div class="input-group">
        <input class="input mono"
               type="@(_reveal ? "text" : "password")"
               id="@Id"
               value="@Value"
               placeholder="@(HasStoredKey ? "Stored. Type to replace." : Placeholder)"
               autocomplete="off"
               spellcheck="false"
               @oninput="OnInput" />
        <button type="button" class="btn" aria-pressed="@(_reveal ? "true" : "false")" @onclick="() => _reveal = !_reveal" disabled="@string.IsNullOrEmpty(Value)">
            @(_reveal ? "Hide" : "Show")
        </button>
        @if (HasStoredKey && OnRemoveStored.HasDelegate)
        {
            <button type="button" class="btn btn-danger" @onclick="OnRemoveStored">Remove stored key</button>
        }
    </div>
</div>

@code {
    private bool _reveal;

    /// <summary>
    /// Gets or sets the id of the input, so a label can point to it.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the text the user typed; a stored key is never filled in.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the callback for the typed text changing.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether a key is already stored, which changes the placeholder.
    /// </summary>
    [Parameter]
    public bool HasStoredKey { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user removing the stored key; without one the button is hidden.
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveStored { get; set; }

    /// <summary>
    /// Gets or sets the hint shown while the field is empty and no key is stored.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
