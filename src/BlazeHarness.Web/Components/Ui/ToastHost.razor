@using BlazeHarness.Core.Config
@implements IDisposable
@inject ToastService Toasts
@inject TimeProvider Time

<div class="toasts" role="region" aria-label="Notifications" aria-live="polite">
    @foreach (var toast in _toasts)
    {
        <div class="toast toast-@toast.Kind.ToString().ToLowerInvariant()" role="@(toast.Kind == ToastKind.Error ? "alert" : "status")" @key="toast.Id">
            <span class="msg">@toast.Message</span>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="Dismiss" @onclick="() => Dismiss(toast.Id)"><Icon Name="close" /></button>
        </div>
    }
</div>

@code {
    private static readonly TimeSpan InfoDuration = TimeSpan.FromSeconds(4);
    private static readonly TimeSpan ErrorDuration = TimeSpan.FromSeconds(9);

    private readonly List<Toast> _toasts = [];
    private readonly CancellationTokenSource _closed = new();

    protected override void OnInitialized()
    {
        Toasts.Shown += OnShown;
    }

    public void Dispose()
    {
        Toasts.Shown -= OnShown;
        _closed.Cancel();
        _closed.Dispose();
    }

    private void OnShown(object? sender, ValueEventArgs<Toast> e)
    {
        var toast = e.Value;
        _ = InvokeAsync(async () =>
        {
            if (_closed.IsCancellationRequested)
            {
                return;
            }

            _toasts.Add(toast);
            StateHasChanged();
            try
            {
                await Task.Delay(toast.Kind == ToastKind.Error ? ErrorDuration : InfoDuration, Time, _closed.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            Dismiss(toast.Id);
        });
    }

    private void Dismiss(Guid id)
    {
        if (_toasts.RemoveAll(t => t.Id == id) > 0)
        {
            StateHasChanged();
        }
    }
}
