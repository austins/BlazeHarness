@inject IJSRuntime JS

@if (Open)
{
    <dialog class="dialog@(Wide ? " dialog-wide" : "")" @ref="_dialog" aria-labelledby="@_titleId" @oncancel="Close" @oncancel:preventDefault>
        <div class="dialog-header">
            <h2 id="@_titleId">@Title</h2>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" aria-label="Close" @onclick="Close"><Icon Name="close" /></button>
        </div>
        <div class="dialog-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="dialog-footer">@Footer</div>
        }
    </dialog>
}

@code {
    private readonly string _titleId = "dlg-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    private bool _shown;

    /// <summary>
    /// Gets or sets the heading, which also names the dialog for screen readers.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets a value indicating whether the dialog is shown.
    /// </summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the dialog uses the wider layout.
    /// </summary>
    [Parameter]
    public bool Wide { get; set; }

    /// <summary>
    /// Gets or sets the callback for the user closing the dialog.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets or sets the content of the dialog body.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the content of the footer, which usually holds the buttons, or null for none.
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_shown)
        {
            _shown = true;
            await JS.InvokeVoidAsync("bhUi.showModal", _dialog);
        }
        else if (!Open && _shown)
        {
            _shown = false;
            await JS.InvokeVoidAsync("bhUi.restoreFocus");
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
